#!/bin/bash
#SBATCH --job-name=w1_a2flat_smoke
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:20:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2flat_smoke_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2flat_smoke_%j.err

# SMOKE: A2-flat, 2 ResearchQA items, no grading — confirm the new Serper key works
# (search returns snippets), cites appear, per-node budget engages, no recursion.
set -euo pipefail
export ARM=A2flat_smoke
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2flat_smoke
export BENCH=researchqa
export MCP_PORT=8060
export MODEL=gpt-5-mini
export MAX_DEPTH=1
export ORCHESTRATOR=false
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=600
export NUM_SHARDS=1
export NUMEX=2
export GRADE=0
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
