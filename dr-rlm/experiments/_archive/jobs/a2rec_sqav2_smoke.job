#!/bin/bash
#SBATCH --job-name=w1_a2rec_sqav2_smoke
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:40:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqav2_smoke_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqav2_smoke_%j.err

# SMOKE: A2-rec on 2 ScholarQA-CSv2 items — validate the NEW sqav2 path end-to-end:
# (a) SQAV2_LOCAL_PATH loads, (b) generation grounded+cited, (c) recursion fires,
# (d) the sqa_cs_v2 grader (astabench/inspect via uv + GOOGLE_API_KEY) actually runs.
set -euo pipefail
export ARM=A2rec_sqa_smoke
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec_sqa_smoke
export BENCH=sqav2
export MCP_PORT=8066
export MODEL=gpt-5-mini
export MAX_DEPTH=2
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=600
export NUM_SHARDS=1
export NUMEX=2
export GRADE=1
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
