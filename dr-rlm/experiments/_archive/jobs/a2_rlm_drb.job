#!/bin/bash
#SBATCH --job-name=w1_a2_drb
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=07:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2_drb_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2_drb_%j.err

# W1 / Arm A2 FULL — Deep Research Bench only (gpt-5-mini in rlm/ recursive harness).
# The expensive arm (longer reports, more search) — own job, longer limit. Per-item guards
# (item_timeout=900s + tool budget=80) cap the runaway seen in the smoke (4.4M tok / 62 min).
# Resumes by example_id, so re-submit continues if it hits the wall.
set -euo pipefail
export ARM=A2
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2
export BENCH=deep_research_bench
export MCP_PORT=8041
export MODEL=gpt-5-mini
export MAX_DEPTH=${MAX_DEPTH:-5}
export MAX_ITERS=${MAX_ITERS:-12}
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-900}
export MAX_TOOL_CALLS=${MAX_TOOL_CALLS:-80}
export NUM_SHARDS=${NUM_SHARDS:-6}  # 6 parallel shard processes (clean per-item instrumentation)
export NUMEX=                       # all of the DRB subset (50)
export GRADE=1
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
