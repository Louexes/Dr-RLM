#!/bin/bash
#SBATCH --job-name=w1_a1_smoke
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
#SBATCH --time=01:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a1_smoke_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a1_smoke_%j.err

# ============================================================================
# W1 / Arm A1 SMOKE TEST : DR-Tulu-8B baseline, FAITHFUL to the paper config.
#   Differs from the real A1 run ONLY in --num-examples (2 instead of all).
#
#   Faithful to dr-tulu/agent/scripts/auto_search.sh + evaluation/README.md:
#     - 2 GPUs: DR-Tulu-8B (search, :30001) + Qwen3-8B (browse reader, :30002)
#     - use_browse_agent=true , browse_tool_name=jina , search_agent_max_tool_calls=10
#     - --use-cache  (routes to generate_dataset_batch -> writes true JSONL,
#                     which the graders' load_jsonl REQUIRES; the no-cache path
#                     writes a JSON array that the graders cannot read)
#     - --max-concurrent 20 --batch-size 20   (paper values; 2 items => 1 batch)
#   Online search (Serper/Jina) because the frozen wii corpus is still gated;
#   the *harness* is identical to the paper, only the retrieval source differs.
#
#   Validates end-to-end: 2x vLLM serve -> MCP online -> generate (browse on)
#   -> ResearchQA coverage grader (gpt-4.1-mini) -> DRB RACE+FACT grader (Gemini)
#   -> timing.json -> ready for aggregate_results.py.
# ============================================================================
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
AGENT=$REPO/dr-tulu/agent
W1=$REPO/drrlm
OUT=$REPO/drrlm/runs/A1_smoke
mkdir -p "$OUT" "$REPO/drrlm/runs/logs"

ARM=A1_smoke
N=2                       # <-- the ONLY deviation from the real run
SEARCH_PORT=30001
BROWSE_PORT=30002
MCP_PORT=8000
SEARCH_MODEL=rl-research/DR-Tulu-8B
BROWSE_MODEL=Qwen/Qwen3-8B
# EXACT override string from auto_search.sh / evaluation/README.md:
OVERRIDES="use_browse_agent=true,search_agent_max_tool_calls=10,browse_tool_name=jina"

# ---- environment (proven combo on gpu_h100) ----
module purge
module load 2025
module load CUDA/12.8.0
source "$VENV/bin/activate"

export HF_HOME=/gpfs/home5/lgehringer/.cache/huggingface
export VLLM_WORKER_MULTIPROC_METHOD=spawn
export TOKENIZERS_PARALLELISM=false
# API keys: SERPER (search), JINA (browse reader), OPENAI (ResearchQA grader), GEMINI (DRB grader)
source "$REPO/drrlm/keys.sh"

# Fail fast & loud if the browse path can't work (jina_apis.py hard-raises on empty key)
if [[ -z "${JINA_API_KEY:-}" ]]; then
  echo "[FATAL] JINA_API_KEY is empty but use_browse_agent=true uses the jina reader."
  echo "        Add it to $REPO/drrlm/keys.sh (free key: https://jina.ai/reader/) and resubmit."
  exit 1
fi

# ---- subsets via the env-var-gated local_path loader patch ----
export RESEARCHQA_LOCAL_PATH=$REPO/drrlm/data/subsets/researchqa_strat49.jsonl
export DRB_LOCAL_PATH=$REPO/drrlm/data/subsets/drb_en50.jsonl

cd "$AGENT"

# ---- cleanup on exit ----
SEARCH_PID=""; BROWSE_PID=""; MCP_PID=""
cleanup() {
  echo "[cleanup] stopping background servers"
  for p in "$MCP_PID" "$BROWSE_PID" "$SEARCH_PID"; do
    [[ -n "$p" ]] && kill "$p" 2>/dev/null || true
  done
}
trap cleanup EXIT

wait_health() {  # $1=port  $2=label  $3=pid
  echo "[serve] waiting for $2 /health on :$1 ..."
  for i in $(seq 1 120); do
    if curl -sf "http://localhost:$1/health" >/dev/null 2>&1; then
      echo "[serve] $2 ready after ~$((i*10))s"; return 0
    fi
    sleep 10
    if ! kill -0 "$3" 2>/dev/null; then
      echo "[serve] FATAL: $2 died; see its log"; exit 1
    fi
  done
  echo "[serve] FATAL: $2 not healthy after 1200s"; exit 1
}

# ---- 1. serve DR-Tulu-8B (search policy) on GPU 0 ----
echo "[serve] launching vLLM $SEARCH_MODEL on :$SEARCH_PORT (GPU 0)"
CUDA_VISIBLE_DEVICES=0 vllm serve "$SEARCH_MODEL" \
    --port $SEARCH_PORT --max-model-len 40960 \
    --gpu-memory-utilization 0.90 --dtype auto --trust-remote-code \
    > "$REPO/drrlm/runs/logs/${ARM}_vllm_search_${SLURM_JOB_ID:-local}.log" 2>&1 &
SEARCH_PID=$!

# ---- 2. serve Qwen3-8B (browse reader) on GPU 1 ----
echo "[serve] launching vLLM $BROWSE_MODEL on :$BROWSE_PORT (GPU 1)"
CUDA_VISIBLE_DEVICES=1 vllm serve "$BROWSE_MODEL" \
    --port $BROWSE_PORT --max-model-len 40960 \
    --gpu-memory-utilization 0.90 --dtype auto --trust-remote-code \
    > "$REPO/drrlm/runs/logs/${ARM}_vllm_browse_${SLURM_JOB_ID:-local}.log" 2>&1 &
BROWSE_PID=$!

wait_health $SEARCH_PORT "search(DR-Tulu-8B)" $SEARCH_PID
wait_health $BROWSE_PORT "browse(Qwen3-8B)"  $BROWSE_PID

# ---- 3. MCP backend ONLINE (no --local-searcher-type -> serper/jina tools) ----
echo "[mcp] launching ONLINE MCP backend on :$MCP_PORT"
python -m dr_agent.mcp_backend.main --port $MCP_PORT \
    > "$REPO/drrlm/runs/logs/${ARM}_mcp_${SLURM_JOB_ID:-local}.log" 2>&1 &
MCP_PID=$!
# Real readiness wait (MCP exposes GET /health). MUST be up before the workflow
# starts, else before_launch_check() hits an interactive Confirm.ask() that
# hangs a non-TTY batch job and wastes the 2-GPU allocation.
wait_health $MCP_PORT "mcp-online" $MCP_PID

# ---- 4. generate (faithful flags; only N differs) + capture wall-clock ----
t_rqa_start=$(date +%s)
echo "[gen] ResearchQA (N=$N) ..."
python workflows/auto_search_sft.py generate-dataset researchqa \
    --num-examples $N \
    --max-concurrent 20 \
    --batch-size 20 \
    --use-cache \
    --config workflows/auto_search_sft.yaml \
    --config-overrides "$OVERRIDES" \
    --output "$OUT/researchqa.jsonl" < /dev/null
t_rqa_end=$(date +%s)

t_drb_start=$(date +%s)
echo "[gen] Deep Research Bench (N=$N) ..."
python workflows/auto_search_sft.py generate-dataset deep_research_bench \
    --num-examples $N \
    --max-concurrent 20 \
    --batch-size 20 \
    --use-cache \
    --config workflows/auto_search_sft.yaml \
    --config-overrides "$OVERRIDES" \
    --output "$OUT/deep_research_bench.jsonl" < /dev/null
t_drb_end=$(date +%s)

# ---- timing.json (latency axis for aggregate_results.py) ----
python - "$OUT/timing.json" $t_rqa_start $t_rqa_end $t_drb_start $t_drb_end <<'PY'
import json, sys
out, rs, re, ds, de = sys.argv[1], *map(int, sys.argv[2:6])
json.dump({
    "researchqa":         {"wall_clock_s": re-rs, "concurrency": 20},
    "deep_research_bench":{"wall_clock_s": de-ds, "concurrency": 20},
}, open(out, "w"), indent=2)
print("[timing] wrote", out)
PY

# ---- 5. grade (faithful unified entrypoint) ----
echo "[grade] ResearchQA coverage (gpt-4.1-mini) ..."
python scripts/evaluate.py researchqa "$OUT/researchqa.jsonl" 2>&1 | tee "$OUT/researchqa_score.txt"

echo "[grade] Deep Research Bench RACE+FACT (Gemini, self-contained) ..."
python scripts/evaluate.py deep_research_bench "$OUT/deep_research_bench.jsonl" \
    --save_path "$OUT/drb_eval" 2>&1 | tee "$OUT/drb_score.txt"

echo "[done] A1 smoke outputs in $OUT"
echo "[next] aggregate:  python $REPO/drrlm/analysis/aggregate_results.py --root $REPO/drrlm/runs --arms $ARM --out $REPO/drrlm/results/${ARM}_summary.csv"
