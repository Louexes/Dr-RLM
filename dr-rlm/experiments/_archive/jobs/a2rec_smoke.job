#!/bin/bash
#SBATCH --job-name=w1_a2rec_smoke
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:25:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_smoke_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_smoke_%j.err

# SMOKE: A2-rec, 2 ResearchQA items, no grading — confirm search works + cites + per-node
# budget with recursion ENABLED (max_depth=2, orchestrator on). If an item decomposes we
# also see sub-agents spawn at per-agent budget; the broad DRB items in the full run exercise
# recursion harder.
set -euo pipefail
export ARM=A2rec_smoke
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec_smoke
export BENCH=researchqa
export MCP_PORT=8061
export MODEL=gpt-5-mini
export MAX_DEPTH=2
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=600
export NUM_SHARDS=1
export NUMEX=2
export GRADE=0
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
