#!/bin/bash
# =============================================================================
# PHASE 0b — RL INIT-HEALTH, max_generate_length=8192 (2026-07-05).
# 4096 (phase0, job 24456073) risked truncating the thinking-ON root synthesis -> empty-root
# finalization failures (rootF% fell 50->31% over 3 steps). 8192 matches SFT/eval budget = clean read.
#
# Goal: settle EMPIRICALLY whether the 2ep SFT ckpt is a good RL init (vs untrained), per the
# 3 guardrails: (1) step-0 rollout finalize/empty-rate + mean reward, (2) policy entropy stays
# off the floor (SFT-init entropy is load-bearing under kl_loss anchor), (3) KL-to-init bounded.
# ONLY changes vs the locked config: init=2ep SFT (grafted), thinking-ON (matches SFT + validated
# by pilot_thinkon_plumbing), rubric-only reward (a2 judge-load fix), epochs=1 (~8 steps, ckpt@4).
# poc_corpus kept = the fully-calibrated plumbing, lowest infra risk. If healthy -> Phase 1 promotes
# to frozen_corpus + rl-split prompts + grounding-aware reward for the real thesis checkpoint.
#
# Config = "variant 2" (grounding-aware root report reward) with the PER-ROLE SEPARATION FIX:
#   * children   : ledger_support provenance credit            (validated child signal)
#   * root       : root_reward_mode=full_R + grounding-aware R  (rubric + citation -> R rises)
#   * separation : advantage_estimator=rer_pernode             (depth-cohort baseline ON)
#   * THE FIX    : DR_RLM_DEPTH_WEIGHTING=0                     (now default; set explicitly)
#
# Why this differs from Run A (which had R-up but citing-flat): Run A ran with the depth
# inverse-frequency WEIGHTING on (the old default). In our shallow trees that up-weights the
# rare ROOT and down-weights the common CHILDREN, halving the children's gradient share
# (~83%->50%) and starving citing. The depth-cohort BASELINE (the real per-role separation)
# was never the problem; the weighting was. With weighting off, citing children keep ~80% of
# the gradient (numerically verified, tests/test_advantage.py) while the root still gets ~20%
# (vs credit_share's ~0) -> citing holds AND R trains. See docs/RL_TRAINING_LOG.md
# (per-role-separation fix) and docs/PROVENANCE_VALIDATION_SUMMARY.md.
#
# Infra: checkpointing ON (Run A had ckpt_interval=0 and OOM'd unrecoverably at step 20);
# judge-outage guard; fresh-quota single-run-per-day. Chunkable like v1-clean.
# =============================================================================
#SBATCH --job-name=rl_sft2ep_p0b
#SBATCH --partition=gpu_h100
#SBATCH --gpus=4
#SBATCH --cpus-per-task=64
#SBATCH --time=08:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/rl_sft2ep_p0b_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/rl_sft2ep_p0b_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$DRRLM/rl/skyrl
OUT=$DRRLM/runs/rl_training
mkdir -p "$OUT"
export PATH="$HOME/.local/bin:$PATH"
set +x; source "$DRRLM/keys.sh"; set -x
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt   # thinking-ON, matches SFT init

# H100: no DeepGEMM build; vLLM tries it by default and the engine dies at startup.
export VLLM_USE_DEEP_GEMM=0
# NOTE: do NOT set PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True — crashes vLLM V1 engine init.

export HF_HUB_OFFLINE=1
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache
export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

# ---- held-constant judge: gemini-2.5-flash ----
export JUDGE_API_KEY="$GEMINI_API_KEY"
export JUDGE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export JUDGE_MODEL="gemini-2.5-flash"

# ---- data / corpus / policy ----
export DATA_DIR=$DRRLM/data/poc_corpus
export MODEL_PATH="/scratch-shared/lgehringer/ckpts/dr_rlm_sft_CANONICAL_2ep_served"   # 2ep SFT init (grafted, servable)
export SEARCH_BACKEND=local_jsonl
export SEARCH_CORPUS_PATH=$DATA_DIR/corpus.jsonl
export NUM_ENGINES=1 TP_SIZE=4 TRAIN_GPUS=4
export LOGGER=console

# ---- evidence telemetry + judge-outage guard ----
export DR_RLM_CREDIT_METRICS_PATH="$OUT/credit_metrics_rl_sft2ep_phase0b.jsonl"
export DR_RLM_JUDGE_OUTAGE_GUARD=0.9

# ---- GROUNDING-AWARE REWARD (root R = rubric + citation) ----
# precision reuses LOCAL check_citations verdicts; recall hits Gemini (CHANGES #14).
# RUBRIC-ONLY reward (a2 fix): grounding-aware per-claim recall calls caused Gemini burst-outage.
# Root R = rubric coverage only; child citing still driven by ledger_support credit.
# export DR_RLM_CITATION_REWARD=1   # (grounding-aware) — FOLLOW-UP once judge-load managed


# ---- THE PER-ROLE-SEPARATION FIX (2026-06-23) ----
# Keep the depth-cohort baseline (separates root vs child baselines), but DISABLE the depth
# inverse-frequency weighting that down-weights the children in shallow trees. This is now the
# default, but set explicitly so the run is self-documenting. DR_RLM_DEPTH_WEIGHTING=1 would
# reproduce the Run A / v3 citing-flat failure. See tests/test_advantage.py.
export DR_RLM_DEPTH_WEIGHTING=0

cd "$SKYRL"
bash examples/train/dr_rlm/configs/run_dr_rlm_L3.sh \
  generator.share_mode=ledger_support \
  generator.root_reward_mode=full_R \
  trainer.algorithm.advantage_estimator=rer_pernode \
  generator.judge_max_concurrency=5 \
  generator.max_recursion_depth=1 \
  generator.max_children_per_node=4 \
  generator.child_return_mode=structured \
  generator.max_turns=10 \
  generator.n_samples_per_prompt=4 \
  generator.chat_template_kwargs.enable_thinking=true \
  generator.sampling_params.max_generate_length=8192 \
  generator.eval_sampling_params.max_generate_length=8192 \
  trainer.policy.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.ref.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.epochs=1 \
  trainer.eval_before_train=false \
  trainer.eval_interval=1000 \
  trainer.ckpt_interval=4 \
  trainer.max_ckpts_to_keep=2 \
  trainer.micro_forward_batch_size_per_gpu=1 \
  trainer.micro_train_batch_size_per_gpu=1 \
  trainer.logger="['console','wandb']" \
  trainer.run_name="rl_sft2ep_phase0b" \
  trainer.log_path="$OUT/rl_sft2ep_phase0b_logs" \
  trainer.ckpt_path="/scratch-shared/lgehringer/rl_sft2ep_phase0b_ckpts" \
  trainer.export_path="$OUT/rl_sft2ep_phase0b_exports"

echo "[rl_sft2ep_phase0b] done -> telemetry $DR_RLM_CREDIT_METRICS_PATH"
# SUCCESS GATE: orphans drop like v1-clean (child citing held) AND R(alive) rises above
# v1-clean's flat ~0.75. If orphans flatten -> separation still failing (check the
# DrRlmTrainer node_depth warning in the log). If R flat -> root signal too weak (raise
# DR_RLM_CITATION_WEIGHT or add the orchestration term).
