#!/bin/bash
#SBATCH --job-name=w1_a2rec_sqa_g31fl
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqa_g31fl_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqa_g31fl_%j.err

# RECURSION PROBE w/ GEMINI-3.1-FLASH-LITE: same 12 sqav2 items where gpt-5-mini fanned out
# (widths 11-26), identical config (depth=2, orchestrator on, per-node budget=10). Gen-only.
# Compares recursion rate vs gemini-2.5-flash (25%) and gpt-5-mini (100% on these).
set -euo pipefail
export ARM=A2rec_sqa_g31fl
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec_sqa_g31fl
export BENCH=sqav2
export MCP_PORT=8059
export MODEL=gemini-3.1-flash-lite
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export MAX_DEPTH=2
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-900}
export NUM_SHARDS=1
export NUMEX=
export GRADE=0
export SQAV2_LOCAL_PATH=/gpfs/home5/lgehringer/Dr-RLM/drrlm/data/subsets/sqav2_gemini_recprobe12.jsonl
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
