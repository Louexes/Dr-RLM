#!/bin/bash
#SBATCH --job-name=w1_a2rec_sqa_gemprobe
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqa_gemprobe_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqa_gemprobe_%j.err

# MODEL-ISOLATION PROBE: re-run, with GEMINI-2.5-flash, the EXACT 12 sqav2 items where
# gpt-5-mini fanned out widely (widths 11-26), holding config identical to the gpt-5 sqav2
# run (MAX_DEPTH=2, orchestrator on, per-node budget=10). Generation-only (GRADE=0); we only
# read the recursion rate. If gemini recurses ~0% here too -> it's the MODEL, not HealthBench.
set -euo pipefail
export ARM=A2rec_sqa_gemprobe
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec_sqa_gemprobe
export BENCH=sqav2
export MCP_PORT=8057
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export MAX_DEPTH=2
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-900}
export NUM_SHARDS=1
export NUMEX=
export GRADE=0
# the 12 gpt-5-recursed items (paired isolation set)
export SQAV2_LOCAL_PATH=/gpfs/home5/lgehringer/Dr-RLM/drrlm/data/subsets/sqav2_gemini_recprobe12.jsonl
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
