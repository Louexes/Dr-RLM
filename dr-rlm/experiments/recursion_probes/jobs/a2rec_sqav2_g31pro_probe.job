#!/bin/bash
#SBATCH --job-name=w1_a2rec_sqa_g31pro
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqa_g31pro_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqa_g31pro_%j.err

# RECURSION PROBE w/ GEMINI-3.1-PRO-PREVIEW: same 12 sqav2 items where gpt-5-mini fanned out
# (widths 11-26), identical config (depth=2, orchestrator on, per-node budget=10). Gen-only.
# Probes the UPPER end of recursion propensity. Baselines on same 12: gpt-5-mini 100%,
# gemini-2.5-flash 25%, gemini-3.1-flash-lite 0%.
set -euo pipefail
export ARM=A2rec_sqa_g31pro
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec_sqa_g31pro
export BENCH=sqav2
export MCP_PORT=8061
export MODEL=gemini-3.1-pro-preview
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export MAX_DEPTH=2
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-1200}
export NUM_SHARDS=1
export NUMEX=
export GRADE=0
export SQAV2_LOCAL_PATH=/gpfs/home5/lgehringer/Dr-RLM/drrlm/data/subsets/sqav2_gemini_recprobe12.jsonl
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
