#!/bin/bash
#SBATCH --job-name=w1_a2rec_hb_smoke
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:45:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_hb_smoke_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_hb_smoke_%j.err

# SMOKE: A2-rec on 2 HealthBench items with GEMINI-2.5-flash agent (the RLM harness has NEVER
# run on a non-OpenAI model). Validate: gemini drives the REPL (repl blocks + answer dict +
# recursion), output grounded+cited, and the gemini grader produces scores.
set -euo pipefail
export ARM=A2rec_hb_smoke
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec_hb_smoke
export BENCH=healthbench
export MCP_PORT=8068
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export MAX_DEPTH=2
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=600
export NUM_SHARDS=1
export NUMEX=2
export GRADE=1
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
