#!/bin/bash
#SBATCH --job-name=w1_a2rec_hb
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_hb_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_hb_%j.err

# W1 / A2-rec on HealthBench-hard (representative 72), GEMINI-2.5-flash agent + grader.
# REPL recursive, per-AGENT tool budget = 10. Within-HealthBench comparison vs A3 (same model).
set -euo pipefail
export ARM=A2rec
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec
export BENCH=healthbench
export MCP_PORT=8058
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export MAX_DEPTH=2
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-900}
export NUM_SHARDS=${NUM_SHARDS:-6}
export NUMEX=                       # all 72 (frozen via HEALTHBENCH_LOCAL_PATH)
export GRADE=1
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
