#!/bin/bash
#SBATCH --job-name=w1_a2flat_drb
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2flat_drb_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2flat_drb_%j.err

# W1 / A2-FLAT — REPL substrate, NO recursion, per-AGENT tool budget == A3's 10.
# Isolates the REPL environment vs A3 (DR-Tulu ReAct) at matched per-agent budget. Deep Research Bench.
set -euo pipefail
export ARM=A2flat
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2flat
export BENCH=deep_research_bench
export MCP_PORT=8051
export MODEL=gpt-5-mini
export MAX_DEPTH=1                 # flat REPL, no recursion
export ORCHESTRATOR=false
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-900}
export NUM_SHARDS=${NUM_SHARDS:-6}
export NUMEX=                       # all of the DRB subset (50)
export GRADE=1
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
