#!/bin/bash
#SBATCH --job-name=base5_drb
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=00:50:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/base5_drb_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/base5_drb_%j.err

# FRESH NON-QUIET BASELINE (auto-print, the OLD config) — same-session paired control for quiet5.
# First 5 DRB items (51-55). Config IDENTICAL to a2rec_drb.job. Graded + logged. QUIET_TOOLS unset.
set -euo pipefail
export ARM=base5
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/base5
export LOG_DIR=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/base5/trajectories
export BENCH=deep_research_bench
export MCP_PORT=8063
export MODEL=gpt-5-mini
export MAX_DEPTH=2
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=900
export NUM_SHARDS=1
export NUMEX=5
export GRADE=1
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
