#!/bin/bash
#SBATCH --job-name=w1_a2rec_sqav2
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=10:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqav2_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_sqav2_%j.err

# W1 / A2-REC on ScholarQA-CSv2 (all 100). REPL recursive, per-AGENT tool budget = 10.
# Recursion-favorable benchmark (many-source synthesis); coverage scored (length-robust).
set -euo pipefail
export ARM=A2rec
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec
export BENCH=sqav2
export MCP_PORT=8056
export MODEL=gpt-5-mini
export MAX_DEPTH=2                 # root + real searching sub-agents
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node      # per-agent budget == A3
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-900}
export NUM_SHARDS=${NUM_SHARDS:-6}
export NUMEX=                       # all 100 (frozen via SQAV2_LOCAL_PATH in a2_rlm.sh)
export GRADE=1                      # sqa grading is best-effort/non-fatal in a2_rlm.sh
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
