#!/bin/bash
#SBATCH --job-name=w1_a2rec_rqa
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_rqa_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_rqa_%j.err

# W1 / A2-REC — REPL substrate WITH recursion, per-AGENT tool budget == A3's 10 (per-node).
# Isolates the value of recursion vs A2-flat: each agent is budget-matched to the flat baseline,
# so recursion's only added ingredient is *more agents* (the test-time-scaling control). ResearchQA.
set -euo pipefail
export ARM=A2rec
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec
export BENCH=researchqa
export MCP_PORT=8052
export MODEL=gpt-5-mini
export MAX_DEPTH=2                 # root + one level of REAL searching sub-agents (depth-1 agents)
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node      # EACH agent gets MAX_TOOL_CALLS (reset per node)
export MAX_TOOL_CALLS=10           # == A3 / A2-flat per-agent budget
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-900}
export NUM_SHARDS=${NUM_SHARDS:-6}
export NUMEX=                       # all of the RQA subset (49)
export GRADE=1
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
