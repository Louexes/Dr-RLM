#!/bin/bash
#SBATCH --job-name=traj_probe_drb
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=00:40:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/traj_probe_drb_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/traj_probe_drb_%j.err

# Capture ONE full DR-RLM trajectory (root + nested sub-agents), turn by turn, for a single
# DRB item. Config is IDENTICAL to a2rec_drb.job (the run we've been analyzing): gpt-5-mini,
# depth 2, per-agent tool budget 10, orchestrator on. Only differences: 1 item, no grading,
# single shard, and LOG_DIR set so generate.py writes the per-item trajectory JSONL.
set -euo pipefail
export ARM=traj_probe
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/traj_probe
export LOG_DIR=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/traj_probe/trajectories
export BENCH=deep_research_bench
export MCP_PORT=8061
export MODEL=gpt-5-mini
export MAX_DEPTH=2                 # root + one level of REAL searching sub-agents
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-900}
export NUM_SHARDS=1
export NUMEX=1                     # first DRB item only
export GRADE=0
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
