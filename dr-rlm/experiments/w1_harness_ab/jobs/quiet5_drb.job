#!/bin/bash
#SBATCH --job-name=quiet5_drb
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=00:50:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/quiet5_drb_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/quiet5_drb_%j.err

# QUIET-TOOLS arm: search/browse return results WITHOUT auto-printing (context decoupling).
# First 5 DRB items (51-55). Config otherwise IDENTICAL to a2rec_drb.job. Graded + logged.
set -euo pipefail
export ARM=quiet5
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/quiet5
export LOG_DIR=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/quiet5/trajectories
export BENCH=deep_research_bench   # NOTE: silent tools are now the DEFAULT (no flag)
export MCP_PORT=8062
export MODEL=gpt-5-mini
export MAX_DEPTH=2
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=900
export NUM_SHARDS=1
export NUMEX=5
export GRADE=1
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
