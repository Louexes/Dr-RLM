#!/bin/bash
#SBATCH --job-name=w1_a3_sqav2_grade
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a3_sqav2_grade_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a3_sqav2_grade_%j.err
# Re-grade A3/sqav2 with the converter fix (generation already complete; in-job grade failed pre-fix).
set -euo pipefail
REPO=/gpfs/home5/lgehringer/Dr-RLM
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
AGENT=$REPO/dr-tulu/agent
W1=$REPO/drrlm
source "$VENV/bin/activate"
source "$REPO/drrlm/keys.sh"
export GOOGLE_API_KEY="${GOOGLE_API_KEY:-${GEMINI_API_KEY:-}}"
cd "$AGENT"
echo "[grade] A3 ScholarQA-CSv2 (sqa_cs_v2, 100 items) ..."
python scripts/evaluate.py sqa_cs_v2 "$REPO/drrlm/runs/A3/sqav2.jsonl" --save_path "$REPO/drrlm/runs/A3/sqa_eval" 2>&1 | tee "$REPO/drrlm/runs/A3/sqav2_score.txt"
echo "[done] A3 sqav2 re-grade"
