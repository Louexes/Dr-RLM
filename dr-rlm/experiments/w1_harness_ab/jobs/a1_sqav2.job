#!/bin/bash
#SBATCH --job-name=w1_a1_sqav2
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
#SBATCH --time=06:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a1_sqav2_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a1_sqav2_%j.err

# W1 / Arm A1 on ScholarQA-CSv2 (all 100): DR-Tulu-8B baseline, faithful paper config.
# Same serving/flags as the A1 RQA/DRB run; only the benchmark differs (generate-dataset
# supports sqav2). SQAV2_LOCAL_PATH freezes the same 100 items every arm uses.
set -euo pipefail
REPO=/gpfs/home5/lgehringer/Dr-RLM
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
AGENT=$REPO/dr-tulu/agent
W1=$REPO/drrlm
OUT=$REPO/drrlm/runs/A1
mkdir -p "$OUT" "$REPO/drrlm/runs/logs"

ARM=A1
N=final_run
SEARCH_PORT=30011
BROWSE_PORT=30012
MCP_PORT=8006
SEARCH_MODEL=rl-research/DR-Tulu-8B
BROWSE_MODEL=Qwen/Qwen3-8B
OVERRIDES="use_browse_agent=true,search_agent_max_tool_calls=10,browse_tool_name=jina,mcp_port=${MCP_PORT}"

module purge
module load 2025
module load CUDA/12.8.0
source "$VENV/bin/activate"
export HF_HOME=/gpfs/home5/lgehringer/.cache/huggingface
export VLLM_WORKER_MULTIPROC_METHOD=spawn
export TOKENIZERS_PARALLELISM=false
source "$REPO/drrlm/keys.sh"
export SQAV2_LOCAL_PATH=$REPO/drrlm/data/subsets/sqav2_cs100.jsonl
export GOOGLE_API_KEY="${GOOGLE_API_KEY:-${GEMINI_API_KEY:-}}"

if [[ -z "${JINA_API_KEY:-}" ]]; then
  echo "[FATAL] JINA_API_KEY is empty but use_browse_agent=true uses the jina reader."; exit 1
fi

cd "$AGENT"

SEARCH_PID=""; BROWSE_PID=""; MCP_PID=""
cleanup() {
  echo "[cleanup] stopping background servers"
  for p in "$MCP_PID" "$BROWSE_PID" "$SEARCH_PID"; do [[ -n "$p" ]] && kill "$p" 2>/dev/null || true; done
}
trap cleanup EXIT

wait_health() {  # $1=port $2=label $3=pid
  echo "[serve] waiting for $2 /health on :$1 ..."
  for i in $(seq 1 120); do
    curl -sf "http://localhost:$1/health" >/dev/null 2>&1 && { echo "[serve] $2 ready after ~$((i*10))s"; return 0; }
    sleep 10
    kill -0 "$3" 2>/dev/null || { echo "[serve] FATAL: $2 died; see its log"; exit 1; }
  done
  echo "[serve] FATAL: $2 not healthy after 1200s"; exit 1
}

echo "[serve] launching vLLM $SEARCH_MODEL on :$SEARCH_PORT (GPU 0)"
CUDA_VISIBLE_DEVICES=0 vllm serve "$SEARCH_MODEL" \
    --port $SEARCH_PORT --max-model-len 40960 \
    --gpu-memory-utilization 0.90 --dtype auto --trust-remote-code \
    > "$REPO/drrlm/runs/logs/${ARM}_sqa_vllm_search_${SLURM_JOB_ID:-local}.log" 2>&1 &
SEARCH_PID=$!

echo "[serve] launching vLLM $BROWSE_MODEL on :$BROWSE_PORT (GPU 1)"
CUDA_VISIBLE_DEVICES=1 vllm serve "$BROWSE_MODEL" \
    --port $BROWSE_PORT --max-model-len 40960 \
    --gpu-memory-utilization 0.90 --dtype auto --trust-remote-code \
    > "$REPO/drrlm/runs/logs/${ARM}_sqa_vllm_browse_${SLURM_JOB_ID:-local}.log" 2>&1 &
BROWSE_PID=$!

wait_health $SEARCH_PORT "search(DR-Tulu-8B)" $SEARCH_PID
wait_health $BROWSE_PORT "browse(Qwen3-8B)"  $BROWSE_PID

echo "[mcp] launching ONLINE MCP backend on :$MCP_PORT"
python -m dr_agent.mcp_backend.main --port $MCP_PORT > "$REPO/drrlm/runs/logs/${ARM}_sqa_mcp_${SLURM_JOB_ID:-local}.log" 2>&1 &
MCP_PID=$!
wait_health $MCP_PORT "mcp-online" $MCP_PID

echo "[gen] ScholarQA-CSv2 (N=$N, DR-Tulu-8B) ..."
python workflows/auto_search_sft.py generate-dataset sqav2 \
    --num-examples $N --max-concurrent 20 --batch-size 20 --use-cache \
    --config workflows/auto_search_sft.yaml \
    --config-overrides "$OVERRIDES" \
    --output "$OUT/sqav2.jsonl" < /dev/null

echo "[grade] ScholarQA-CSv2 rubric coverage (sqa_cs_v2; astabench/inspect via uv) ..."
{ python scripts/evaluate.py sqa_cs_v2 "$OUT/sqav2.jsonl" --save_path "$OUT/sqa_eval" 2>&1 | tee "$OUT/sqav2_score.txt"; } \
    || echo "[warn] sqa grading failed — generation saved; grade later"

echo "[done] A1 sqav2 outputs in $OUT"
