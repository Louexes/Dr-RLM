#!/bin/bash
#SBATCH --job-name=w1_a2rec_drb
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=07:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_drb_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/logs/a2rec_drb_%j.err

# W1 / A2-REC — REPL substrate WITH recursion, per-AGENT tool budget == A3's 10 (per-node).
# Isolates the value of recursion vs A2-flat (each agent budget-matched to the flat baseline;
# recursion only adds more agents = the TTS control). Deep Research Bench (the expensive arm).
set -euo pipefail
export ARM=A2rec
export OUT=/gpfs/home5/lgehringer/Dr-RLM/drrlm/runs/A2rec
export BENCH=deep_research_bench
export MCP_PORT=8053
export MODEL=gpt-5-mini
export MAX_DEPTH=2                 # root + one level of REAL searching sub-agents
export ORCHESTRATOR=true
export TOOL_BUDGET_SCOPE=node
export MAX_TOOL_CALLS=10
export ITEM_TIMEOUT=${ITEM_TIMEOUT:-900}
export NUM_SHARDS=${NUM_SHARDS:-6}
export NUMEX=                       # all of the DRB subset (50)
export GRADE=1
bash /gpfs/home5/lgehringer/Dr-RLM/drrlm/agent/run.sh
