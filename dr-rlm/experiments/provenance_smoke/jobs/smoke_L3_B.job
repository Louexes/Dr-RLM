#!/bin/bash
# =============================================================================
# RUN B — L3 on the FULL DR Tulu composite reward (rubric + citation + format + search).
#
# Same L3 config as Run A (ledger_support, full_R, rer_pernode) but the reward adds DR Tulu's
# two PROCESS terms, RE-EXPRESSED for our recursive harness (a verbatim port is meaningless —
# DR Tulu's format/num_search_turns key on <answer>/<search> tags we don't emit, and root-only
# search counting would penalize delegation; see docs/RL_TRAINING_LOG.md). Harness-native:
#   format = 0.5*(substantive report) + 0.5*(>=1 cite)   [no <answer>/<search>-query sub-terms]
#   search = min(tree-wide ledger snippet count / cap, 1) [counts children's retrievals]
# Weights = DR Tulu's REWARD_WEIGHTS: R = 0.5*rubric + 0.2*citation + 0.2*format + 0.1*search.
# Run B is the "trained like DR Tulu" faithfulness/ablation arm; Run A (outcome-only) is the
# clean headline. A-vs-B = does adding the process terms help or hurt the RLM?
# =============================================================================
#SBATCH --job-name=smoke_L3_B
#SBATCH --partition=gpu_h100
#SBATCH --gpus=4
#SBATCH --cpus-per-task=64
#SBATCH --time=10:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/smoke_L3_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/smoke_L3_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$DRRLM/rl/skyrl
OUT=$DRRLM/runs/provenance_smoke
mkdir -p "$OUT"
export PATH="$HOME/.local/bin:$PATH"
set +x; source "$DRRLM/keys.sh"; set -x
# Ray workers do not inherit the shell env NOR see relative paths into dr-rlm/ (the
# working dir is repackaged to scratch): give prompts.py the ABSOLUTE canonical prompt.
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt.txt

# H100: the env has no DeepGEMM build; vLLM on Hopper tries it by default and the
# engine dies at startup (RuntimeError: DeepGEMM backend is not available). Disable it.
export VLLM_USE_DEEP_GEMM=0

# Model cache is complete & verified: force pure-local HF resolution (eliminates the
# transient hub-404 / lock-file failure class seen in job 23673282). uv cache lives on
# scratch to keep home INODE quota healthy (146k-file cache blew the 1M soft limit).
export HF_HUB_OFFLINE=1
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache

# W&B tracking: skyrl asserts on WANDB_API_KEY (and forwards it to Ray workers);
# derive it from the existing `wandb login` credential in ~/.netrc.
export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

# ---- held-constant judge: gemini-2.5-flash (the POC-validated judge; frees all 4 GPUs) ----
export JUDGE_API_KEY="$GEMINI_API_KEY"
export JUDGE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export JUDGE_MODEL="gemini-2.5-flash"

# ---- data / corpus / policy ----
export DATA_DIR=$DRRLM/data/poc_corpus
export MODEL_PATH="Qwen/Qwen3.5-4B"
export SEARCH_BACKEND=local_jsonl
export SEARCH_CORPUS_PATH=$DATA_DIR/corpus.jsonl
export NUM_ENGINES=1 TP_SIZE=4 TRAIN_GPUS=4
export LOGGER=console

# ---- evidence telemetry (opt-in generator hook) ----
export DR_RLM_CREDIT_METRICS_PATH="$OUT/credit_metrics_L3_B.jsonl"
# judge-outage guard: >=90% zero-R trees in a step => no-op update (see CHANGES #13)
export DR_RLM_JUDGE_OUTAGE_GUARD=0.9

# ---- FULL DR Tulu COMPOSITE REWARD (Run B): rubric + citation + format + search ----
# precision reuses LOCAL check_citations verdicts; recall hits Gemini (CHANGES #14).
# format + search are NO-LLM (regex + ledger snippet count) -> no extra judge cost vs A.
export DR_RLM_CITATION_REWARD=1
export DR_RLM_RUBRIC_WEIGHT=0.5
export DR_RLM_CITATION_WEIGHT=0.2
export DR_RLM_FORMAT_WEIGHT=0.2
export DR_RLM_SEARCH_WEIGHT=0.1
export DR_RLM_SEARCH_CAP=8

cd "$SKYRL"
bash examples/train/dr_rlm/configs/run_dr_rlm_L3.sh \
  generator.share_mode=ledger_support \
  generator.root_reward_mode=full_R \
  trainer.algorithm.advantage_estimator=rer_pernode \
  generator.judge_max_concurrency=8 \
  generator.max_recursion_depth=1 \
  generator.max_children_per_node=4 \
  generator.child_return_mode=structured \
  generator.max_turns=10 \
  generator.n_samples_per_prompt=4 \
  generator.chat_template_kwargs.enable_thinking=false \
  generator.sampling_params.max_generate_length=4096 \
  generator.eval_sampling_params.max_generate_length=4096 \
  trainer.policy.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.ref.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.epochs=5 \
  trainer.eval_before_train=false \
  trainer.eval_interval=1000 \
  trainer.ckpt_interval=0 \
  trainer.micro_forward_batch_size_per_gpu=1 \
  trainer.micro_train_batch_size_per_gpu=1 \
  trainer.logger="['console','wandb']" \
  trainer.run_name="smoke_L3_B_full_composite" \
  trainer.log_path="$OUT/L3_B_logs" \
  trainer.ckpt_path="$OUT/L3_B_ckpts" \
  trainer.export_path="$OUT/L3_B_exports"

echo "[smoke_L3_B] done -> telemetry $DR_RLM_CREDIT_METRICS_PATH"
