#!/bin/bash
# =============================================================================
# DR-TULU FLAT ARM — FULL RL (75-step horizon), the flat column of the controlled A/B.
# Faithful Open-Instruct recipe on SkyRL (docs/DRTULU_RL_FAITHFULNESS_AUDIT.md), matched
# to the recursive main arm rl_be68 for cross-arm parity:
#   * init  = dr_tulu_flat_sft_lowlr/served_e13  (the CORRECT low-LR SFT init; gate cov 0.295,
#             entropy 89% STABLE) -- NOT the old 4e-5 CANONICAL_1ep the smoke used.
#   * data  = data/rl_flat300_drtulu (first 300 of rl_fresh_400_drtulu = IDENTICAL prompts to
#             recursive rl_be68_300; 300 prompts x batch4 x epochs1 = 75 steps).
#   * reward= flat composite 0.5 rubric + 0.2 citation + 0.2 format + 0.1 search (run_dr_tulu_flat.sh).
#   * KL 0.05, lr 1e-6, GRPO, thinking-ON, bm25s frozen corpus, 12 tool calls -- all held to eval COMMON.
#   * judge = local Qwen3.5-4B thinking-OFF via judge_server_flat.job (own endpoint, parallel-safe
#             with the running recursive bc/cc judges).
# Chain: self-resuming afterany chunks; done-guard stops once step>=TARGET_STEP. Constant LR over
# 75 steps -> lossless resume. Kill criteria (in-job judge-outage guard + external watchdog):
# hacking signature, entropy floor, KL runaway.
# =============================================================================
#SBATCH --job-name=rl_drtulu_flat
#SBATCH --partition=gpu_h100
#SBATCH --gpus=4
#SBATCH --cpus-per-task=64
#SBATCH --time=10:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/rl_drtulu_flat_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/rl_drtulu_flat_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$DRRLM/rl/skyrl
OUT=$DRRLM/runs/drtulu_flat_rl
CKPT_PATH=/scratch-shared/lgehringer/rl_drtulu_flat_ckpts
EXPORT_PATH=/scratch-shared/lgehringer/rl_drtulu_flat_exports
mkdir -p "$OUT"

# ---- chain done-guard: exit fast once the 75-step horizon is reached ----
TARGET_STEP=75
DONE_STEP=$(cat "$CKPT_PATH/latest_ckpt_global_step.txt" 2>/dev/null || echo 0)
if [ "$DONE_STEP" -ge "$TARGET_STEP" ]; then
  echo "[rl_drtulu_flat] already at step $DONE_STEP >= $TARGET_STEP — cancelling leftover chain jobs"
  for j in $(squeue -h -u lgehringer -n rl_drtulu_flat,rl_judge_flat -o %i); do
    [ "$j" != "${SLURM_JOB_ID:-}" ] && scancel "$j" || true
  done
  exit 0
fi

export PATH="$HOME/.local/bin:$PATH"
set +x; source "$DRRLM/keys.sh"; set -x
export VLLM_USE_DEEP_GEMM=0
export HF_HUB_OFFLINE=1
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache
export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

# ---- local judge rendezvous (own endpoint file; judge_server_flat.job) ----
JUDGE_ENDPOINT_FILE=$DRRLM/runs/provenance_smoke/rl_judge_flat_endpoint.txt
echo "[rl_drtulu_flat] waiting for local judge endpoint (max 60 min) ..."
JUDGE_UP=0
for s in $(seq 1 360); do
  if [ -f "$JUDGE_ENDPOINT_FILE" ] && curl -sf "$(cat $JUDGE_ENDPOINT_FILE)/models" >/dev/null 2>&1; then JUDGE_UP=1; break; fi
  sleep 10
done
if [ "$JUDGE_UP" != "1" ]; then echo "[FATAL] local judge never came up ($JUDGE_ENDPOINT_FILE)"; exit 1; fi
export JUDGE_API_KEY="EMPTY"
export JUDGE_BASE_URL="$(cat $JUDGE_ENDPOINT_FILE)"
export JUDGE_MODEL="rl-judge-qwen35-4b"
echo "[rl_drtulu_flat] judge ready: $JUDGE_BASE_URL ($JUDGE_MODEL)"

cd "$SKYRL"
# Pre-flight: rubric parses+discriminates AND the citation reward path is live (0.2 of composite).
env -u VIRTUAL_ENV ./.venv/bin/python - <<'PYEOF'
import os
from examples.train.dr_rlm.judge import JudgeConfig, score_report_sync, score_in_context_citations_sync
cfg = JudgeConfig(model=os.environ["JUDGE_MODEL"], base_url=os.environ["JUDGE_BASE_URL"], api_key="EMPTY", max_concurrency=5)
good = "Photosynthesis converts light energy into chemical energy in plants, producing glucose and oxygen from CO2 and water."
rubrics = [{"description": "Mentions that light energy is converted to chemical energy", "weight": 1.0},
           {"description": "Names glucose and oxygen as products", "weight": 1.0},
           {"description": "Claims photosynthesis happens in animal cells", "weight": 1.0}]
R, per = score_report_sync(good, "What is photosynthesis?", rubrics, cfg)
print(f"[judge-preflight] rubric R={R:.3f} per={per}")
assert 0.15 < R < 0.99, f"rubric judge pre-flight FAILED: R={R}"
snips = {"ab12cd34-0": "Title: Photosynthesis\nSnippet: Photosynthesis produces glucose and oxygen from carbon dioxide and water using light energy."}
resp = 'Plants make food. <answer><cite id="ab12cd34-0">Photosynthesis produces glucose and oxygen.</cite></answer>'
C = score_in_context_citations_sync("What is photosynthesis?", resp, snips, cfg)
print(f"[judge-preflight] citation C={C:.3f}")
assert C > 0.3, f"citation judge pre-flight FAILED: C={C}"
print("[judge-preflight] OK — rubric + citation paths live")
PYEOF

# ---- data / policy / infra ----
export DATA_DIR=$DRRLM/data/rl_flat300_drtulu                                          # 300 prompts = 75-step horizon; identical to recursive rl_be68_300
export MODEL_PATH=/scratch-shared/lgehringer/ckpts/dr_tulu_flat_sft_lowlr/served_e13   # CORRECT low-LR SFT init (gate 0.295)
export RUN_NAME=rl_drtulu_flat
export LOG_PATH=$OUT/rl_drtulu_flat_logs
export CKPT_PATH EXPORT_PATH
export NUM_ENGINES=1 TP_SIZE=4 TRAIN_GPUS=4
export DR_RLM_CREDIT_METRICS_PATH="$DRRLM/runs/provenance_smoke/credit_metrics_rl_drtulu_flat.jsonl"
export DR_RLM_JUDGE_OUTAGE_GUARD=0.9

# ---- launch: flat composite reward, GRPO, KL 0.05 (run_dr_tulu_flat.sh holds the recipe) ----
bash examples/train/dr_rlm/configs/run_dr_tulu_flat.sh \
  trainer.epochs=1 \
  trainer.ckpt_interval=10 \
  trainer.hf_save_interval=25 \
  trainer.max_ckpts_to_keep=2

echo "[rl_drtulu_flat] done -> telemetry $DR_RLM_CREDIT_METRICS_PATH ; ckpts $CKPT_PATH"
