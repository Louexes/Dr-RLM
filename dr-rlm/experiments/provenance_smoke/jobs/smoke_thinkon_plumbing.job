#!/bin/bash
# =============================================================================
# THINKING-ON PLUMBING SMOKE (2026-07-01).
# Purpose: confirm enable_thinking=true does NOT break RL training, after a full
# SkyRL code audit (docs/THINKING_MODE_SETUP.md): train-inference consistency holds
# (step-wise re-templates the SAME input_ids used to generate), think tokens are
# loss-masked=1 (get_turn_loss_mask over output_ids), enable_thinking flows uniformly.
#
# EXACT copy of the known-good smoke_L3_complete.job (4xH100, Qwen3.5-4B, depth=1,
# structured, max_turns=10, max_generate_length=4096, ledger_support+full_R,
# rer_pernode, gemini-flash judge) with ONE substantive change:
#   generator.chat_template_kwargs.enable_thinking = false -> TRUE
# plus short-duration knobs (epochs=1, no ckpt) since this is a throwaway plumbing check.
# WATCH: (a) rollouts emit </think>+repl per turn un-truncated, (b) reports finalize
# (ready=True, non-zero R), (c) no length-break aborts, (d) train steps complete.
# max_generate_length=4096 already leaves the think block ample room (compact CoT).
# =============================================================================
#SBATCH --job-name=smoke_ton
#SBATCH --partition=gpu_h100
#SBATCH --gpus=4
#SBATCH --cpus-per-task=64
#SBATCH --time=01:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/smoke_ton_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/smoke_ton_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$DRRLM/rl/skyrl
OUT=$DRRLM/runs/provenance_smoke
mkdir -p "$OUT"
export PATH="$HOME/.local/bin:$PATH"
set +x; source "$DRRLM/keys.sh"; set -x
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt.txt

# H100: no DeepGEMM build; vLLM tries it by default and the engine dies at startup.
export VLLM_USE_DEEP_GEMM=0
# NOTE: do NOT set PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True — crashes vLLM V1 engine init.

export HF_HUB_OFFLINE=1
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache
export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

# ---- held-constant judge: gemini-2.5-flash ----
export JUDGE_API_KEY="$GEMINI_API_KEY"
export JUDGE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export JUDGE_MODEL="gemini-2.5-flash"

# ---- data / corpus / policy ----
export DATA_DIR=$DRRLM/data/poc_corpus
export MODEL_PATH="Qwen/Qwen3.5-4B"
export SEARCH_BACKEND=local_jsonl
export SEARCH_CORPUS_PATH=$DATA_DIR/corpus.jsonl
export NUM_ENGINES=1 TP_SIZE=4 TRAIN_GPUS=4
export LOGGER=console

# ---- evidence telemetry + judge-outage guard ----
export DR_RLM_CREDIT_METRICS_PATH="$OUT/credit_metrics_thinkon_smoke.jsonl"
export DR_RLM_JUDGE_OUTAGE_GUARD=0.9

# ---- GROUNDING-AWARE REWARD (identical to known-good, so any break is attributable to thinking) ----
export DR_RLM_CITATION_REWARD=1
export DR_RLM_RUBRIC_WEIGHT=0.5
export DR_RLM_CITATION_WEIGHT=0.2
export DR_RLM_DEPTH_WEIGHTING=0

cd "$SKYRL"
bash examples/train/dr_rlm/configs/run_dr_rlm_L3.sh \
  generator.share_mode=ledger_support \
  generator.root_reward_mode=full_R \
  trainer.algorithm.advantage_estimator=rer_pernode \
  generator.judge_max_concurrency=8 \
  generator.max_recursion_depth=1 \
  generator.max_children_per_node=4 \
  generator.child_return_mode=structured \
  generator.max_turns=10 \
  generator.n_samples_per_prompt=4 \
  generator.chat_template_kwargs.enable_thinking=true \
  generator.sampling_params.max_generate_length=4096 \
  generator.eval_sampling_params.max_generate_length=4096 \
  trainer.policy.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.ref.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.epochs=1 \
  trainer.eval_before_train=false \
  trainer.eval_interval=1000 \
  trainer.ckpt_interval=1000 \
  trainer.max_ckpts_to_keep=1 \
  trainer.micro_forward_batch_size_per_gpu=1 \
  trainer.micro_train_batch_size_per_gpu=1 \
  trainer.logger="['console']" \
  trainer.run_name="smoke_thinkon_plumbing" \
  trainer.log_path="$OUT/thinkon_smoke_logs" \
  trainer.ckpt_path="/scratch-shared/lgehringer/smoke_thinkon_ckpts" \
  trainer.export_path="$OUT/thinkon_smoke_exports"

echo "[smoke_thinkon_plumbing] done -> telemetry $DR_RLM_CREDIT_METRICS_PATH"
