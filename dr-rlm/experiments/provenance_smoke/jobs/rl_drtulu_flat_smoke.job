#!/bin/bash
# =============================================================================
# DR-TULU FLAT BASELINE RL — SMOKE (3 steps, 12 prompts x 4 samples)
#
# First-light for the faithful flat arm (docs/DRTULU_RL_FAITHFULNESS_AUDIT.md):
# DrTuluEnv (ReAct <call_tool>/<answer>, frozen bm25s, composite reward
# 0.5·rubric + 0.2·citation + 0.2·format + 0.1·search) under stock GRPO in
# SkyRL, init = dr_tulu_flat_sft_CANONICAL_1ep_served (gate-passed 0.288).
#
# SUCCESS GATE: 3 steps complete; per-component rewards non-degenerate
# (format ≈ 1 at init, rubric in (0,1) spread within groups, citation > 0 for
# cited rollouts); no protocol breakage (tool calls parsed, obs injected);
# judge keeps up at DR_TULU_JUDGE_CONCURRENCY=5.
#
# Judge: local Qwen3.5-4B thinking-OFF via judge_server.job (endpoint file
# rendezvous, same as rl_full150). Offline env tests already green
# (tests/test_dr_tulu_env.py, 11 passed).
# =============================================================================
#SBATCH --job-name=drtulu_rl_smoke
#SBATCH --partition=gpu_h100
#SBATCH --gpus=4
#SBATCH --cpus-per-task=64
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_rl_smoke_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_rl_smoke_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$DRRLM/rl/skyrl
OUT=$DRRLM/runs/drtulu_flat_rl
mkdir -p "$OUT"
export PATH="$HOME/.local/bin:$PATH"
set +x; source "$DRRLM/keys.sh"; set -x

# H100: no DeepGEMM build; vLLM tries it by default and the engine dies at startup.
export VLLM_USE_DEEP_GEMM=0
export HF_HUB_OFFLINE=1
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache
export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

# ---- LOCAL judge rendezvous (judge_server.job, same file as rl_full150) ----
JUDGE_ENDPOINT_FILE=$DRRLM/runs/provenance_smoke/rl_judge_endpoint.txt
echo "[smoke] waiting for local judge endpoint (max 60 min) ..."
JUDGE_UP=0
for s in $(seq 1 360); do
  if [ -f "$JUDGE_ENDPOINT_FILE" ] && curl -sf "$(cat $JUDGE_ENDPOINT_FILE)/models" >/dev/null 2>&1; then JUDGE_UP=1; break; fi
  sleep 10
done
if [ "$JUDGE_UP" != "1" ]; then echo "[FATAL] local judge never came up ($JUDGE_ENDPOINT_FILE)"; exit 1; fi
export JUDGE_API_KEY="EMPTY"
export JUDGE_BASE_URL="$(cat $JUDGE_ENDPOINT_FILE)"
export JUDGE_MODEL="rl-judge-qwen35-4b"
echo "[smoke] judge ready: $JUDGE_BASE_URL"

cd "$SKYRL"

# Pre-flight 1: rubric judge parses + discriminates (same probe as rl_full150).
# Pre-flight 2: the CITATION reward path (new for the flat arm) returns a sane
# value on a hand-built cited answer — a dead citation judge would silently
# zero 0.2 of the composite for the whole run.
env -u VIRTUAL_ENV ./.venv/bin/python - <<'PYEOF'
import os
from examples.train.dr_rlm.judge import JudgeConfig, score_report_sync, score_in_context_citations_sync
cfg = JudgeConfig(model=os.environ["JUDGE_MODEL"], base_url=os.environ["JUDGE_BASE_URL"], api_key="EMPTY", max_concurrency=5)
good = "Photosynthesis converts light energy into chemical energy in plants, producing glucose and oxygen from CO2 and water."
rubrics = [{"description": "Mentions that light energy is converted to chemical energy", "weight": 1.0},
           {"description": "Names glucose and oxygen as products", "weight": 1.0},
           {"description": "Claims photosynthesis happens in animal cells", "weight": 1.0}]
R, per = score_report_sync(good, "What is photosynthesis?", rubrics, cfg)
print(f"[judge-preflight] rubric R={R:.3f} per={per}")
assert 0.15 < R < 0.99, f"rubric judge pre-flight FAILED: R={R}"
snips = {"ab12cd34-0": "Title: Photosynthesis\nSnippet: Photosynthesis produces glucose and oxygen from carbon dioxide and water using light energy."}
resp = 'Plants make food. <answer><cite id="ab12cd34-0">Photosynthesis produces glucose and oxygen.</cite></answer>'
C = score_in_context_citations_sync("What is photosynthesis?", resp, snips, cfg)
print(f"[judge-preflight] citation C={C:.3f}")
assert C > 0.3, f"citation judge pre-flight FAILED: C={C} (supported claim should score well)"
print("[judge-preflight] OK — rubric + citation paths live")
PYEOF

# ---- 12-prompt smoke subset (deterministic head of the paired 600) ----
SMOKE_DATA=$OUT/data_smoke
env -u VIRTUAL_ENV ./.venv/bin/python - <<PYEOF
import datasets, os
src = "$DRRLM/data/rl_fresh_400_drtulu"
os.makedirs("$SMOKE_DATA", exist_ok=True)
datasets.Dataset.from_parquet(f"{src}/train.parquet").select(range(12)).to_parquet("$SMOKE_DATA/train.parquet")
datasets.Dataset.from_parquet(f"{src}/validation.parquet").to_parquet("$SMOKE_DATA/validation.parquet")
print("smoke data ready")
PYEOF

# ---- launch: 12 prompts / batch 4 = 3 steps ----
export DATA_DIR=$SMOKE_DATA
export MODEL_PATH=/scratch-shared/lgehringer/ckpts/dr_tulu_flat_sft_CANONICAL_1ep_served
export RUN_NAME=drtulu_flat_rl_smoke
export CKPT_PATH=/scratch-shared/lgehringer/drtulu_flat_smoke_ckpts
export EXPORT_PATH=/scratch-shared/lgehringer/drtulu_flat_smoke_exports
export LOG_PATH=$OUT/smoke_logs

bash examples/train/dr_rlm/configs/run_dr_tulu_flat.sh \
  trainer.ckpt_interval=100 \
  trainer.hf_save_interval=100

echo "[smoke] done — check $OUT/smoke_logs + W&B run $RUN_NAME for reward components"
