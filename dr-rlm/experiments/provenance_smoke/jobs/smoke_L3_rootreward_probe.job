#!/bin/bash
# =============================================================================
# ROOT-REWARD PROBE — "rising-R" linchpin validation (thesis RQ2 primary).
#
# Config = Run A (variant #2): children on ledger_support provenance credit, ROOT on the
# grounding-aware report reward (rubric + citation), under per-role baseline separation
# (rer_pernode). This is the FULL METHOD that must produce orphans-DOWN *and* R-UP.
#
# Purpose: validate the make-or-break linchpin BEFORE the 150-step headline run --- does
# per-role separation keep the children citing (orphans keep dropping like v1-clean) while
# the root earns the report reward? Run A trended right (orphans 92.5->mid-80s) but OOM'd
# at step 20 with checkpointing OFF. THIS run differs from Run A in ONE way: ckpt_interval=5
# so the trainer/Ray host-RAM leak (unfixed; ~step 17-20) costs only a partial chunk and we
# resume. Success = orphan% keeps falling + report_R holds/ticks up. Failure = orphans go
# flat ~85-93% (v3 mode) => per-role separation not isolating.
#   - Expectation: this validates VIABILITY + early R trend; a CONVERGED R-rise needs the
#     150-step headline run. Watch the orphan trajectory --- it diverges by ~step 10.
# Record: docs/RL_TRAINING_LOG.md.
# =============================================================================
#SBATCH --job-name=smoke_L3_rootprobe
#SBATCH --partition=gpu_h100
#SBATCH --gpus=4
#SBATCH --cpus-per-task=64
#SBATCH --time=10:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/smoke_L3_rootprobe_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/smoke_L3_rootprobe_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$DRRLM/rl/skyrl
OUT=$DRRLM/runs/provenance_smoke
mkdir -p "$OUT"
export PATH="$HOME/.local/bin:$PATH"
set +x; source "$DRRLM/keys.sh"; set -x
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt.txt

# H100: vLLM tries DeepGEMM by default and the engine dies (no DeepGEMM build). Disable it.
export VLLM_USE_DEEP_GEMM=0
# Pure-local HF resolution; uv cache on scratch (home inode quota).
export HF_HUB_OFFLINE=1
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache
export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

# ---- held-constant judge: gemini-2.5-flash (citation RECALL calls; precision reuses local) ----
export JUDGE_API_KEY="$GEMINI_API_KEY"
export JUDGE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export JUDGE_MODEL="gemini-2.5-flash"

# ---- data / corpus / policy ----
export DATA_DIR=$DRRLM/data/poc_corpus
export MODEL_PATH="Qwen/Qwen3.5-4B"
export SEARCH_BACKEND=local_jsonl
export SEARCH_CORPUS_PATH=$DATA_DIR/corpus.jsonl
export NUM_ENGINES=1 TP_SIZE=4 TRAIN_GPUS=4
export LOGGER=console

# ---- evidence telemetry (watch orphan% + report_R here) ----
export DR_RLM_CREDIT_METRICS_PATH="$OUT/credit_metrics_rootprobe.jsonl"
export DR_RLM_JUDGE_OUTAGE_GUARD=0.9

# ---- GROUNDING-AWARE REWARD (root gets it): blend DR Tulu citation_reward into R ----
export DR_RLM_CITATION_REWARD=1
export DR_RLM_RUBRIC_WEIGHT=0.5
export DR_RLM_CITATION_WEIGHT=0.2

cd "$SKYRL"
bash examples/train/dr_rlm/configs/run_dr_rlm_L3.sh \
  generator.share_mode=ledger_support \
  generator.root_reward_mode=full_R \
  trainer.algorithm.advantage_estimator=rer_pernode \
  generator.judge_max_concurrency=8 \
  generator.max_recursion_depth=1 \
  generator.max_children_per_node=4 \
  generator.child_return_mode=structured \
  generator.max_turns=10 \
  generator.n_samples_per_prompt=4 \
  generator.chat_template_kwargs.enable_thinking=false \
  generator.sampling_params.max_generate_length=4096 \
  generator.eval_sampling_params.max_generate_length=4096 \
  trainer.policy.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.ref.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.epochs=5 \
  trainer.eval_before_train=false \
  trainer.eval_interval=1000 \
  trainer.ckpt_interval=5 \
  trainer.max_ckpts_to_keep=2 \
  trainer.micro_forward_batch_size_per_gpu=1 \
  trainer.micro_train_batch_size_per_gpu=1 \
  trainer.logger="['console','wandb']" \
  trainer.run_name="smoke_L3_rootreward_probe" \
  trainer.log_path="$OUT/rootprobe_logs" \
  trainer.ckpt_path="/scratch-shared/lgehringer/rootprobe_ckpts" \
  trainer.export_path="/scratch-shared/lgehringer/rootprobe_exports"

echo "[smoke_L3_rootprobe] done -> telemetry $DR_RLM_CREDIT_METRICS_PATH"
