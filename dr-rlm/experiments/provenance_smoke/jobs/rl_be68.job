#!/bin/bash
# =============================================================================
# FRESH 100-STEP RUN @ KL 0.05 (2026-07-08) — THE thesis training run, relaunched clean.
# Supersedes rl_full150 (KL 0.01, contracted synthesis by step 53) after the KL probe
# (24482019) PASSED its gate: contraction reversed, E[R] best-of-training, trifecta held.
# Deltas vs rl_full150.job: kl_loss_coef=0.05; FRESH from 2ep-SFT init (NO resume — new empty
# ckpt dir); data = rl_fresh_400 (first 400 of the seed-42 600; 100 steps x batch 4, zero
# repetition; SAME subset for the DR-Tulu flat arm = identical-prompts fairness contract).
# Recipe otherwise UNCHANGED: ledger_support + full_R + rer_pernode + depthW=0 + rubric-only +
# local thinking-OFF judge + consistent harness. Chain: self-resuming 10h chunks (~45 steps/chunk
# at probe pace; 2-3 chunks). Kill criteria: hacking signature, entropy <0.25, KL runaway.
# Inherited config below (from rl_full150.job):
# PHASE 1 — RL from 2ep SFT, TRAIN/EVAL-CONSISTENT HARNESS (2026-07-05).
# CONSISTENCY FIX (user 2026-07-05): the RL harness MUST match the eval/SFT harness (same principle
# we locked for the untrained-eval baselines). Phase 0/0b rolled on poc_corpus/local_jsonl — but the
# SFT init learned on frozen_corpus/bm25s and ALL evals use it, so poc was a distribution mismatch
# (likely feeding the finalization failures). Now aligned to eval: search_backend=bm25s +
# frozen_corpus + bm25s_index, max_children=10, max_generate_length=8192 (all = eval COMMON).
# Prompts = drtulu_rl_decompose40 (the rl-split train set, held out from SFT+eval). Reward rubric-only
# (grounding-aware = follow-up), epochs=3 (~24 steps, each of 32 prompts seen 3x, fits 8h) = the real trifecta test + ckpt@4.
#
# Goal: settle EMPIRICALLY whether the 2ep SFT ckpt is a good RL init (vs untrained), per the
# 3 guardrails: (1) step-0 rollout finalize/empty-rate + mean reward, (2) policy entropy stays
# off the floor (SFT-init entropy is load-bearing under kl_loss anchor), (3) KL-to-init bounded.
# ONLY changes vs the locked config: init=2ep SFT (grafted), thinking-ON (matches SFT + validated
# by smoke_thinkon_plumbing), rubric-only reward (a2 judge-load fix), epochs=1 (~8 steps, ckpt@4).
# poc_corpus kept = the fully-calibrated plumbing, lowest infra risk. If healthy -> Phase 1 promotes
# to frozen_corpus + rl-split prompts + grounding-aware reward for the real thesis checkpoint.
#
# Config = "variant 2" (grounding-aware root report reward) with the PER-ROLE SEPARATION FIX:
#   * children   : ledger_support provenance credit            (validated child signal)
#   * root       : root_reward_mode=full_R + grounding-aware R  (rubric + citation -> R rises)
#   * separation : advantage_estimator=rer_pernode             (depth-cohort baseline ON)
#   * THE FIX    : DR_RLM_DEPTH_WEIGHTING=0                     (now default; set explicitly)
#
# Why this differs from Run A (which had R-up but citing-flat): Run A ran with the depth
# inverse-frequency WEIGHTING on (the old default). In our shallow trees that up-weights the
# rare ROOT and down-weights the common CHILDREN, halving the children's gradient share
# (~83%->50%) and starving citing. The depth-cohort BASELINE (the real per-role separation)
# was never the problem; the weighting was. With weighting off, citing children keep ~80% of
# the gradient (numerically verified, tests/test_advantage.py) while the root still gets ~20%
# (vs credit_share's ~0) -> citing holds AND R trains. See docs/RL_TRAINING_LOG.md
# (per-role-separation fix) and docs/PROVENANCE_VALIDATION_SUMMARY.md.
#
# Infra: checkpointing ON (Run A had ckpt_interval=0 and OOM'd unrecoverably at step 20);
# judge-outage guard; fresh-quota single-run-per-day. Chunkable like v1-clean.
# =============================================================================
#SBATCH --job-name=rl_be68
#SBATCH --partition=gpu_h100
#SBATCH --gpus=4
#SBATCH --cpus-per-task=64
#SBATCH --time=10:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/rl_be68_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/rl_be68_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$DRRLM/rl/skyrl

# chain guard: epochs=1 over 400 prompts = exactly 100 steps; later chunks in the afterany
# chain exit immediately once done so they don't burn spin-up + idle judge time.
TARGET_STEP=75   # 75-step LR horizon (constant -> lossless resume). PHASE 1 stops at 50 via monitor auto-scancel; relaunch resumes 50->75 on prompts 201-300 (zero repeat).
DONE_STEP=$(cat /scratch-shared/lgehringer/rl_be68_ckpts/latest_ckpt_global_step.txt 2>/dev/null || echo 0)
if [ "$DONE_STEP" -ge "$TARGET_STEP" ]; then
  echo "[rl_be68] already at step $DONE_STEP >= $TARGET_STEP — cancelling leftover chain jobs"
  for j in $(squeue -h -u lgehringer -n rl_be68,rl_judge -o %i); do
    [ "$j" != "${SLURM_JOB_ID:-}" ] && scancel "$j" || true
  done
  exit 0
fi
OUT=$DRRLM/runs/provenance_smoke
mkdir -p "$OUT"
export PATH="$HOME/.local/bin:$PATH"
set +x; source "$DRRLM/keys.sh"; set -x
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt   # thinking-ON, matches SFT init

# H100: no DeepGEMM build; vLLM tries it by default and the engine dies at startup.
export VLLM_USE_DEEP_GEMM=0
# NOTE: do NOT set PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True — crashes vLLM V1 engine init.

export HF_HUB_OFFLINE=1
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache
export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

# ---- LOCAL judge (user decision 2026-07-06: no Gemini anywhere) ----
# Qwen3.5-4B thinking-OFF served by judge_server.job on its own GPU; rendezvous via endpoint file.
# Same judge model as eval => train≡eval consistency now covers the reward model too.
# NB: reward-function delta vs the 24-step trifecta run (which was Gemini-scored) — logged.
JUDGE_ENDPOINT_FILE=$DRRLM/runs/provenance_smoke/rl_judge_endpoint.txt
echo "[rl_be68] waiting for local judge endpoint (max 60 min) ..."
JUDGE_UP=0
for s in $(seq 1 360); do
  if [ -f "$JUDGE_ENDPOINT_FILE" ] && curl -sf "$(cat $JUDGE_ENDPOINT_FILE)/models" >/dev/null 2>&1; then JUDGE_UP=1; break; fi
  sleep 10
done
if [ "$JUDGE_UP" != "1" ]; then echo "[FATAL] local judge never came up ($JUDGE_ENDPOINT_FILE)"; exit 1; fi
export JUDGE_API_KEY="EMPTY"
export JUDGE_BASE_URL="$(cat $JUDGE_ENDPOINT_FILE)"
export JUDGE_MODEL="rl-judge-qwen35-4b"
echo "[rl_be68] judge ready: $JUDGE_BASE_URL ($JUDGE_MODEL)"

# Pre-flight: the local judge must return a PARSEABLE, sane rubric score before we spend
# spin-up + training. A judge that can't emit the expected format makes every R silently 0.0
# (judge.py returns 0.0 on parse failure) and the outage guard would abort mid-run instead.
cd "$SKYRL"
env -u VIRTUAL_ENV ./.venv/bin/python - <<'PYEOF'
import os
from examples.train.dr_rlm.judge import JudgeConfig, score_report_sync
cfg = JudgeConfig(model=os.environ["JUDGE_MODEL"], base_url=os.environ["JUDGE_BASE_URL"], api_key="EMPTY")
good = "Photosynthesis converts light energy into chemical energy in plants, producing glucose and oxygen from CO2 and water."
rubrics = [{"description": "Mentions that light energy is converted to chemical energy", "weight": 1.0},
           {"description": "Names glucose and oxygen as products", "weight": 1.0},
           {"description": "Claims photosynthesis happens in animal cells", "weight": 1.0}]
R, per = score_report_sync(good, "What is photosynthesis?", rubrics, cfg)
print(f"[judge-preflight] R={R:.3f} per-criterion={per}")
assert R > 0.15, f"judge pre-flight FAILED: R={R} (parse failure or judge scoring everything 0)"
assert R < 0.99, f"judge pre-flight suspicious: R={R} (scoring everything 1 incl. the false criterion)"
print("[judge-preflight] OK — local judge parses and discriminates")
PYEOF

# ---- data / corpus / policy ----
export DATA_DIR=$DRRLM/data/rl_be68_300   # 300 prompts = 75-step horizon; constant across phases so resume is clean. Monitor halts phase 1 at step 50.
export MODEL_PATH="/scratch-shared/lgehringer/ckpts/sft_recipe_sweep/B_lowlr/hf/global_step_68/served"   # NEW SFT init = B_lowlr e68 (lr2e-5, DRB 0.321 > untr/oldRL, entropy 69%)
export SEARCH_BACKEND=bm25s
export SEARCH_CORPUS_PATH=$DRRLM/data/frozen_corpus/corpus.jsonl
export SEARCH_INDEX_PATH=$DRRLM/data/frozen_corpus/bm25s_index
export NUM_ENGINES=1 TP_SIZE=4 TRAIN_GPUS=4
export LOGGER=console

# ---- evidence telemetry + judge-outage guard ----
export DR_RLM_CREDIT_METRICS_PATH="$OUT/credit_metrics_rl_be68.jsonl"
export DR_RLM_JUDGE_OUTAGE_GUARD=0.9

# ---- GROUNDING-AWARE REWARD (root R = rubric + citation) ----
# precision reuses LOCAL check_citations verdicts; recall hits Gemini (CHANGES #14).
# RUBRIC-ONLY reward (a2 fix): grounding-aware per-claim recall calls caused Gemini burst-outage.
# Root R = rubric coverage only; child citing still driven by ledger_support credit.
# export DR_RLM_CITATION_REWARD=1   # (grounding-aware) — FOLLOW-UP once judge-load managed


# ---- THE PER-ROLE-SEPARATION FIX (2026-06-23) ----
# Keep the depth-cohort baseline (separates root vs child baselines), but DISABLE the depth
# inverse-frequency weighting that down-weights the children in shallow trees. This is now the
# default, but set explicitly so the run is self-documenting. DR_RLM_DEPTH_WEIGHTING=1 would
# reproduce the Run A / v3 citing-flat failure. See tests/test_advantage.py.
export DR_RLM_DEPTH_WEIGHTING=0

cd "$SKYRL"
bash examples/train/dr_rlm/configs/run_dr_rlm_L3.sh \
  generator.share_mode=ledger_support \
  generator.root_reward_mode=full_R \
  trainer.algorithm.advantage_estimator=rer_pernode \
  trainer.algorithm.kl_loss_coef=0.05 \
  generator.judge_max_concurrency=5 \
  generator.max_recursion_depth=1 \
  generator.max_children_per_node=10 \
  generator.child_return_mode=structured \
  generator.max_turns=10 \
  generator.n_samples_per_prompt=4 \
  generator.chat_template_kwargs.enable_thinking=true \
  generator.sampling_params.max_generate_length=8192 \
  generator.eval_sampling_params.max_generate_length=8192 \
  trainer.policy.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.ref.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.epochs=1 \
  trainer.eval_before_train=false \
  trainer.eval_interval=1000 \
  trainer.ckpt_interval=10 \
  trainer.hf_save_interval=25 \
  trainer.max_ckpts_to_keep=2 \
  trainer.micro_forward_batch_size_per_gpu=1 \
  trainer.micro_train_batch_size_per_gpu=1 \
  trainer.logger="['console','wandb']" \
  trainer.run_name="rl_be68" \
  trainer.log_path="$OUT/rl_be68_logs" \
  trainer.ckpt_path="/scratch-shared/lgehringer/rl_be68_ckpts" \
  trainer.export_path="/scratch-shared/lgehringer/rl_be68_exports"

echo "[rl_be68] done -> telemetry $DR_RLM_CREDIT_METRICS_PATH"
# SUCCESS GATE: orphans drop like v1-clean (child citing held) AND R(alive) rises above
# v1-clean's flat ~0.75. If orphans flatten -> separation still failing (check the
# DrRlmTrainer node_depth warning in the log). If R flat -> root signal too weak (raise
# DR_RLM_CITATION_WEIGHT or add the orchestration term).
