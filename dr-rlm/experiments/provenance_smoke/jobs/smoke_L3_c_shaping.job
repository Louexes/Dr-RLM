#!/bin/bash
# =============================================================================
# (c) SINGLE-PHASE + CHILD-CITING SHAPING — cold-start bootstrap test.
#
# Diagnosis from probe 24193291: under full_R + rer_pernode + ledger_support, child
# citing stays flat (orphans ~94%) NOT because of baseline crush (estimator verified
# clean) but because child citing is too SPARSE at cold-start (~6% of children emit a
# parseable own-evidence cite) — so the dense root gradient (every root earns full_R)
# drowns the sparse child gradient in the shared policy. credit_share only escaped this
# by zeroing the root gradient (=> R flat).
#
# (c) attacks the SPARSITY directly: DR_RLM_CHILD_CITE_SHAPING adds a DENSE per-child
# reward for emitting valid own-evidence citations at all (capped, root never shaped),
# so every citing child gets a gradient that competes with the root's. This is the ONLY
# change vs probe 24193291 (full_R + rer_pernode + ledger_support + grounding-aware R).
#
# SUCCESS  = cite/child RISES (mean n_cited over children climbs off ~0.15) AND R holds/ticks up.
# FAILURE  = cite/child stays flat ~0.15 by ~step 10-12  => shaping insufficient => fall back to (a).
# NB the r_a-orphan% metric is now partly mechanical (a shaped citing child has r_a>0), so
#    judge SUCCESS on the BEHAVIORAL metric: mean n_cited/child and %children-that-cite.
# Record: docs/RL_TRAINING_LOG.md.
# =============================================================================
#SBATCH --job-name=smoke_L3_c_shaping
#SBATCH --partition=gpu_h100
#SBATCH --gpus=4
#SBATCH --cpus-per-task=64
#SBATCH --time=10:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/smoke_L3_c_shaping_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/smoke_L3_c_shaping_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$DRRLM/rl/skyrl
OUT=$DRRLM/runs/provenance_smoke
mkdir -p "$OUT"
export PATH="$HOME/.local/bin:$PATH"
set +x; source "$DRRLM/keys.sh"; set -x
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt.txt

# H100: vLLM tries DeepGEMM by default and the engine dies (no DeepGEMM build). Disable it.
export VLLM_USE_DEEP_GEMM=0
# Pure-local HF resolution; uv cache on scratch (home inode quota).
export HF_HUB_OFFLINE=1
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache
export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

# ---- held-constant judge: gemini-2.5-flash (citation RECALL calls; precision reuses local) ----
export JUDGE_API_KEY="$GEMINI_API_KEY"
export JUDGE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export JUDGE_MODEL="gemini-2.5-flash"

# ---- data / corpus / policy ----
export DATA_DIR=$DRRLM/data/poc_corpus
export MODEL_PATH="Qwen/Qwen3.5-4B"
export SEARCH_BACKEND=local_jsonl
export SEARCH_CORPUS_PATH=$DATA_DIR/corpus.jsonl
export NUM_ENGINES=1 TP_SIZE=4 TRAIN_GPUS=4
export LOGGER=console

# ---- evidence telemetry (watch cite/child + report_R here) ----
export DR_RLM_CREDIT_METRICS_PATH="$OUT/credit_metrics_c_shaping.jsonl"
export DR_RLM_JUDGE_OUTAGE_GUARD=0.9

# ---- GROUNDING-AWARE REWARD (root gets it): blend DR Tulu citation_reward into R ----
export DR_RLM_CITATION_REWARD=1
export DR_RLM_RUBRIC_WEIGHT=0.5
export DR_RLM_CITATION_WEIGHT=0.2

# ---- (c) THE NEW LEVER: dense child-citing shaping (root never shaped, capped) ----
# Bonus per child = 0.3 * min(own_valid_cites, 3) / 3  (max +0.3, comparable to evidence_credit
# scale ~0.34). Constant for this confirmation smoke; the full run would anneal it toward 0.
export DR_RLM_CHILD_CITE_SHAPING=0.3
export DR_RLM_CHILD_CITE_CAP=3

cd "$SKYRL"
bash examples/train/dr_rlm/configs/run_dr_rlm_L3.sh \
  generator.share_mode=ledger_support \
  generator.root_reward_mode=full_R \
  trainer.algorithm.advantage_estimator=rer_pernode \
  generator.judge_max_concurrency=8 \
  generator.max_recursion_depth=1 \
  generator.max_children_per_node=4 \
  generator.child_return_mode=structured \
  generator.max_turns=10 \
  generator.n_samples_per_prompt=4 \
  generator.chat_template_kwargs.enable_thinking=false \
  generator.sampling_params.max_generate_length=4096 \
  generator.eval_sampling_params.max_generate_length=4096 \
  trainer.policy.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.ref.fsdp_config.wrap_policy.transformer_layer_cls_to_wrap="['Qwen3_5DecoderLayer']" \
  trainer.epochs=5 \
  trainer.eval_before_train=false \
  trainer.eval_interval=1000 \
  trainer.ckpt_interval=5 \
  trainer.max_ckpts_to_keep=2 \
  trainer.micro_forward_batch_size_per_gpu=1 \
  trainer.micro_train_batch_size_per_gpu=1 \
  trainer.logger="['console','wandb']" \
  trainer.run_name="smoke_L3_c_shaping" \
  trainer.log_path="$OUT/c_shaping_logs" \
  trainer.ckpt_path="/scratch-shared/lgehringer/c_shaping_ckpts" \
  trainer.export_path="/scratch-shared/lgehringer/c_shaping_exports"

echo "[smoke_L3_c_shaping] done -> telemetry $DR_RLM_CREDIT_METRICS_PATH"
