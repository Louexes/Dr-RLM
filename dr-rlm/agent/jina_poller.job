#!/bin/bash
# SLURM-resident Jina balance poller — auto-submits frozen_baseline_v1.job when the key
# regains credit. Lives on SLURM (not in an interactive session) because session monitors are
# killed by compaction/restarts; a queued job survives everything. 1 core on staging
# (internet-enabled, ~free SBUs). Polls every 10 min, re-sources keys.sh each poll so a
# key swap is picked up without resubmission. Exits after submitting (or if a baseline
# is already queued). Log: runs/logs/jina_poller_<jobid>.out
#SBATCH --job-name=jina_poller
#SBATCH --partition=staging
#SBATCH --cpus-per-task=1
#SBATCH --mem=1G
#SBATCH --time=48:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/jina_poller_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/jina_poller_%j.err
set -uo pipefail

JOB=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent/frozen_baseline_v1.job
KEYS=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/keys.sh

# Single-poller guard: if another jina_poller is already queued/running, bow out.
others=$(squeue -u "$USER" -h -n jina_poller -o %i | grep -v "^${SLURM_JOB_ID}$" | wc -l)
if (( others > 0 )); then
  echo "$(date -Is) another jina_poller is already running — exiting"
  exit 0
fi

last_mtime=$(stat -c %Y "$KEYS" 2>/dev/null || echo 0)
echo "$(date -Is) poller up (job $SLURM_JOB_ID); keys.sh mtime=$last_mtime"

while true; do
  m=$(stat -c %Y "$KEYS" 2>/dev/null || echo 0)
  if [[ "$m" != "$last_mtime" ]]; then
    echo "$(date -Is) keys.sh changed — testing the new key"
    last_mtime=$m
  fi
  source "$KEYS" >/dev/null 2>&1 || true
  resp=$(curl -s -m 20 "https://r.jina.ai/https://example.com" \
         -H "Authorization: Bearer ${JINA_API_KEY:-}" || true)
  if [[ -n "$resp" && "$resp" != *InsufficientBalanceError* \
        && "$resp" != *'"code":402'* && "$resp" != *'"code":401'* ]]; then
    echo "$(date -Is) JINA HEALTHY: ${resp:0:120}"
    if squeue -u "$USER" -h -o %j | grep -q '^frozen_baseline_v1$'; then
      echo "$(date -Is) frozen_baseline_v1 already in queue — not double-submitting"
      exit 0
    fi
    out=$(cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent && sbatch "$JOB" 2>&1)
    rc=$?
    echo "$(date -Is) sbatch frozen_baseline_v1 (rc=$rc): $out"
    exit $rc
  fi
  echo "$(date -Is) jina still unfunded (${resp:0:80})"
  sleep 600
done
