#!/bin/bash
# SLURM job — OFFLINE depth-2 validation (DRB n=8, snapshot corpus, verification ON).
# Recursion beyond depth 1 is UNVALIDATED on the current contract: everything since V1 ran
# MAX_DEPTH=1 (depth 2 once exploded width pre-caps: ~18 agents/item). The RL recursion story
# assumes the COORDINATOR band works. Checks: tree shape (width caps hold per node), no
# collapses/uncited, citation flow up TWO hops (worker->coordinator->root), cost, RACE/FACT
# vs the depth-1 control arm from runs/offline_ab_citeverify (same corpus, same items).
#SBATCH --job-name=offline_depth2
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_depth2_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_depth2_%j.err
set -euo pipefail

cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent
export ARMS=structured
export DR_RLM_CAPTURE_LEDGER=1
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export TOKENIZER=Qwen/Qwen3-8B
export BENCH=deep_research_bench
export NUMEX=8
export MAX_DEPTH=2
export SEARCH_BACKEND=local_jsonl
export SEARCH_CORPUS_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/offline_corpus/drb.jsonl
export MAX_TOOL_CALLS=200
export MAX_CHILDREN=4          # tighter per-node cap at depth 2 (4 + 4x4 = max 21 nodes/tree)
export GRADE=1
export SAVE_TRAJ=1
export CITATION_VERIFY=1
export OUT=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/offline_depth2

echo "[job ${SLURM_JOB_ID:-local}] offline depth-2 validation, n=8, width cap 4"
exec ./ab_child_return.sh
