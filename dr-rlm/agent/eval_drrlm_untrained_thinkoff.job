#!/bin/bash
# ============================================================================
# Untrained DR-RLM baseline — THINKING-OFF (ResearchQA N=120). RLM native mode.
# Locked config: depth=1, max_turns=10, max_children=10, max_completion=8192,
#   child_return=structured, search=bm25s frozen, sampling=DR-Tulu params
#   (temp1.0/top_p1.0/top_k off/pp0/min_p0), canonical prompt.
# EXECUTION: generate.py runs items SEQUENTIALLY, so to use the GPU we run SHARDS
#   parallel shard-processes against ONE vLLM server (it batches them). NO --enforce-eager
#   (CUDA graphs on). Thinking-off policy doubles as the thinking-off judge.
# ============================================================================
#SBATCH --job-name=drrlm_toff
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=256G
#SBATCH --time=02:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_toff_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_toff_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B; PORT=8005; GRADER_ALIAS=gpt-4.1-mini-2025-04-14
FROZEN=$DRRLM/data/frozen_corpus; OUT=$DRRLM/runs/drrlm_untrained_thinkoff; TASK=researchqa; N=120; SHARDS=6
JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"
# NO rm of shard_*.jsonl: generate.py resumes by example_id (skips already-done rows, appends),
# so a relaunch after a crash CONTINUES instead of restarting. Clear $OUT manually for a clean run.
rm -f "$OUT/${TASK}.jsonl"   # only the merged file (rebuilt from shards at the end)
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl

VLLM_LOG="$DRRLM/runs/logs/drrlm_toff_vllm_${JOBID}.log"
echo "[serve] vllm $MODEL THINKING-OFF (graphs on, policy+judge) -> $VLLM_LOG"
vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.90 --max-model-len 32768 \
  --max-num-seqs 32 --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$MODEL" "$GRADER_ALIAS" > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!; trap 'kill $VLLM_PID 2>/dev/null || true' EXIT
for s in $(seq 1 240); do
  curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; break; }
  sleep 5; kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$VLLM_LOG"; exit 1; }
done

GEN=$DRRLM/agent/generate.py; cd "$AGENT"
echo "[gen] DR-RLM THINKING-OFF depth=1 N=$N across $SHARDS parallel shards ..."
COMMON="--driver new --benchmark $TASK --model $MODEL --tokenizer-path $MODEL \
  --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
  --max-recursion-depth 1 --max-iterations 10 --max-completion-tokens 8192 \
  --max-tool-calls 80 --max-children 10 --child-return-mode structured \
  --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
  --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
  --abort-after-dead-items 1000 --num-examples $N"
pids=()
for i in $(seq 0 $((SHARDS-1))); do
  python "$GEN" $COMMON --num-shards "$SHARDS" --shard "$i" \
    --output "$OUT/shard_${i}.jsonl" --save-trajectories "$OUT/traj_${i}" \
    > "$OUT/shard_${i}.log" 2>&1 < /dev/null &
  pids+=($!)
done
echo "[gen] launched ${#pids[@]} shard processes; waiting ..."
fail=0; for p in "${pids[@]}"; do wait "$p" || { echo "[warn] a shard exited nonzero"; fail=$((fail+1)); }; done
cat "$OUT"/shard_*.jsonl > "$OUT/${TASK}.jsonl" 2>/dev/null || true
echo "[gen] done ($fail shard(s) nonzero). merged rows: $(wc -l < "$OUT/${TASK}.jsonl" 2>/dev/null)"

echo; echo "=== generation health ==="
python - "$OUT/${TASK}.jsonl" <<'PY'
import json,sys
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
ne=sum(1 for r in rows if (r.get("final_response") or "").strip())
cit=sum((r.get("additional_output_data") or {}).get("n_cited_ids",0) for r in rows)
print(f"rows={len(rows)}/120  non-empty={ne}  Σcited_ids={cit}")
PY

echo; echo "=== GRADE (thinking-OFF judge, same endpoint) ==="
OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
  python scripts/evaluate.py "$TASK" "$OUT/${TASK}.jsonl" 2>&1 | grep -viE "Coverage for|Expected 8|Questions:|Authlib|joserfc|Computing rubric" | tail -8
python - "$OUT/${TASK}_eval_results.json" <<'PY'
import json,sys,os
f=sys.argv[1]
if os.path.exists(f):
    d=json.load(open(f)); print("UNTRAINED DR-RLM (thinking-OFF) coverage:", d.get("score") or d.get("metrics",{}).get("coverage"), "| n=", d.get("num_examples"))
PY
echo "[done] $OUT/${TASK}.jsonl"
