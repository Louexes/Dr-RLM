#!/bin/bash
# ============================================================================
# Grade SQA-CS-v2 reports OFF-GPU (staging = internet, ~0 SBU) via astabench/
# inspect_ai + Gemini flash. run_eval.py self-manages a py3.11 env with `uv run`,
# so no venv to build. Caches on scratch to protect the home inode quota.
# Reusable: pass SQA_INPUT (the banked sqav2.jsonl reports) + SQA_OUTDIR.
#   run_eval.py `run` = convert (-> asta format) + eval (Gemini scorer).
# ============================================================================
#SBATCH --job-name=sqa_grade
#SBATCH --partition=staging
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sqa_grade_%j.out
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
SQA_INPUT=${SQA_INPUT:?set SQA_INPUT=<path to sqav2.jsonl reports>}
SQA_OUTDIR=${SQA_OUTDIR:-$(dirname "$SQA_INPUT")/sqa_eval}
source "$DRRLM/keys.sh"                                # exports GEMINI_API_KEY
export GOOGLE_API_KEY="$GEMINI_API_KEY"
export UV_CACHE_DIR=${UV_CACHE_DIR:-/scratch-shared/lgehringer/uv_cache}   # inode safety (not $HOME); overridable to dodge a corrupted cache
export HF_HOME=/scratch-shared/lgehringer/hf_cache
mkdir -p "$SQA_OUTDIR" "$UV_CACHE_DIR"
cd "$AGENT"
echo "[sqa-grade] input=$SQA_INPUT  outdir=$SQA_OUTDIR  scorer=google/gemini-2.5-flash"
python evaluation/sqa_eval/run_eval.py run \
  --input_file "$SQA_INPUT" \
  --scorer_model "google/gemini-2.5-flash" \
  --max_connections 16 \
  --output_dir "$SQA_OUTDIR"
echo; echo "===== SQA score files in $SQA_OUTDIR ====="
ls -la "$SQA_OUTDIR" 2>/dev/null
grep -rhiE "global_avg|score" "$SQA_OUTDIR"/*.json "$SQA_OUTDIR"/*score* 2>/dev/null | head
