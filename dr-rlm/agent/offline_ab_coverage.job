#!/bin/bash
# SLURM job — OFFLINE A/B: coverage-CHECKLIST prompt on vs off (DRB n=16, snapshot corpus).
# Targets comprehensiveness, the weakest RACE dim (0.264 vs 0.379 instr-following at n16).
# Treatment = prompt VARIANT via DR_RLM_PROMPT_FILE (canonical system_prompt.txt untouched —
# the clean prompt-A/B pattern): ORCHESTRATOR must (1) write an explicit `aspects = [...]`
# checklist on turn 1 and (2) gap-check the draft against it before submitting.
# Both arms: citation verification OFF (one variable at a time).
#SBATCH --job-name=offline_ab_coverage
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_ab_coverage_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_ab_coverage_%j.err
set -euo pipefail

cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent
BASE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/offline_ab_coverage

COMMON_ENV() {
  export ARMS=structured
  export DR_RLM_CAPTURE_LEDGER=1
  export MODEL=gemini-2.5-flash
  export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
  export MODEL_API_KEY_ENV=GEMINI_API_KEY
  export TOKENIZER=Qwen/Qwen3-8B
  export BENCH=deep_research_bench
  export NUMEX=16
  export MAX_DEPTH=1
  export SEARCH_BACKEND=local_jsonl
  export SEARCH_CORPUS_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/offline_corpus/drb.jsonl
  export MAX_TOOL_CALLS=200
  export MAX_CHILDREN=6
  export GRADE=1
  export SAVE_TRAJ=1
  export CITATION_VERIFY=0
}

COMMON_ENV; unset DR_RLM_PROMPT_FILE || true
export OUT=$BASE/control
echo "[ab] arm CONTROL (canonical prompt) ..."; ./ab_child_return.sh || echo "[warn] control failed"

COMMON_ENV
export DR_RLM_PROMPT_FILE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/prompts/variants/coverage_checklist.txt
export OUT=$BASE/checklist
echo "[ab] arm CHECKLIST (coverage variant) ..."; ./ab_child_return.sh || echo "[warn] checklist failed"

echo "[offline_ab_coverage] done -> $BASE"
