#!/bin/bash
# TEMPLATE — fair DR-Tulu baseline run with task statements IDENTICAL to DR-RLM's.
# Fill in: MODEL serving (vllm for DR-Tulu-8B, or an API model via their config), MCP
# backend port, benchmark + n. Requires the two steelman patches in
# dr-tulu/agent/workflows/auto_search_sft.py (see dr-rlm/docs/patches_to_deps.md).
#
# The framing JSON below MUST be kept in sync with dr-rlm/agent/infer_driver._TASK_FRAMING
# (post-adoption values: neutral RQA statement; symmetric HB rubric-axis statement; DRB and
# sqav2 statements as in _TASK_FRAMING) — both systems then receive byte-identical task
# statements, satisfying the task-framing parity requirement from the 2026-06-12 fairness
# audit (their stock harness otherwise gives DRB/RQA/HB the generic "write a short
# paragraph" YAML instruction).
#SBATCH --job-name=baseline_drtulu_symmetric
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=08:00:00
set -euo pipefail

source /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/keys.sh
cd /gpfs/home5/lgehringer/Dr-RLM/dr-tulu/agent

export DR_TULU_FRAMING_JSON="$(python3 - <<'PYEOF'
import json, re, pathlib
# Single source of truth: read _TASK_FRAMING out of the DR-RLM driver so the two systems
# can never drift apart.
src = pathlib.Path('/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent/infer_driver.py').read_text()
m = re.search(r'_TASK_FRAMING = \{(.*?)\n\}', src, re.DOTALL)
ns = {}
exec('FRAMING = {' + m.group(1) + '\n}', ns)
print(json.dumps(ns['FRAMING']))
PYEOF
)"

TASK=${TASK:?set TASK (deep_research_bench|researchqa|healthbench|sqav2)}
python workflows/auto_search_sft.py \
    generate-dataset "$TASK" \
    --num-examples "${NUMEX:?set NUMEX}" \
    --max-concurrent 20 --batch-size 20 \
    --config workflows/auto_search_sft.yaml \
    --config-overrides "use_browse_agent=true,search_agent_max_tool_calls=10,browse_tool_name=jina" \
    --output "${OUT:?set OUT}/$TASK.jsonl"
