#!/bin/bash
# ============================================================================
# UNTRAINED DR-TULU (ReAct) baseline eval — Qwen3.5-4B, frozen bm25s corpus.
# "flat baseline" = DR-Tulu's ORIGINAL ReAct harness, 1:1. Retrieval held IDENTICAL
# to DR-RLM via the in-process bm25s bridge (dr_agent/tool_interface/local_bm25s.py,
# reuses the RLM's _Bm25sBackend over the SAME frozen index). No MCP server, no web.
#
# Locked alignment (see memory project-final-eval-protocol; RL config = run_dr_rlm_L3.sh):
#   sampling      temp 1.0 (top_p 1.0 default), single sample           [= RL rollout]
#   per-gen cap   search_agent_max_tokens=1024                          [= max_generate_length]
#   tool budget   search_agent_max_tool_calls=12 (native ceiling)       [RLM = 6 turns]
#   search k      number_documents_to_search=10                         [= RLM search_top_k]
#   thinking      OFF (enable_thinking=false at serve)
#   tools         bm25s search (snippet_search + google_search) + bm25s browse(get_doc parity)
#   corpus/judge  frozen_corpus + Qwen3.5-4B judge (graded separately)
#
# DEFAULT = 2-item SMOKE (confirms loader honors the locked subset + full pipeline).
# Bump SMOKE_N / set FULL=1 only when launching the real run.
# ============================================================================
#SBATCH --job-name=drtulu_untr
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=01:40:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_untr_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_untr_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
DRRLM=$REPO/dr-rlm
AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B
PORT=8001                      # avoid clashing with any MCP default on 8000
FROZEN=$DRRLM/data/frozen_corpus
OUT=$DRRLM/runs/drtulu_untrained
TASK=researchqa
SMOKE_N=12                     # preview size; FULL=1 (default now) -> whole locked subset
FULL="${FULL:-1}"             # smoke already passed (job 24313711, 11/12 non-empty) -> default to the full run
GRADER_ALIAS=gpt-4.1-mini-2025-04-14   # researchqa grader's hardcoded judge name -> alias served Qwen to it
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false
export OPENAI_API_KEY=EMPTY
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl

# --- serve Qwen3.5-4B (thinking off, eager) -------------------------------------
VLLM_LOG="$DRRLM/runs/logs/drtulu_untr_vllm_${SLURM_JOB_ID:-local}.log"
echo "[serve] vllm serve $MODEL (thinking off, eager) -> $VLLM_LOG"
vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.85 --max-model-len 32768 --enforce-eager \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$MODEL" "$GRADER_ALIAS" > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'kill $VLLM_PID 2>/dev/null || true' EXIT
for s in $(seq 1 180); do
  curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; break; }
  sleep 5; kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$VLLM_LOG"; exit 1; }
done

# --- run the ReAct harness over the frozen corpus -------------------------------
NUMEX="${SMOKE_N}"; [ "$FULL" = "1" ] && NUMEX="$(wc -l < "$RESEARCHQA_LOCAL_PATH")"   # explicit count (avoid untested 'final_run' string)
OVERRIDES="search_tool_name=bm25s,browse_tool_name=bm25s"
OVERRIDES="$OVERRIDES,bm25s_index_path=$FROZEN/bm25s_index,bm25s_corpus_path=$FROZEN/corpus.jsonl"
OVERRIDES="$OVERRIDES,search_agent_base_url=http://localhost:$PORT/v1"
OVERRIDES="$OVERRIDES,search_agent_model_name=$MODEL,search_agent_tokenizer_name=$MODEL"
OVERRIDES="$OVERRIDES,search_agent_temperature=1.0,search_agent_max_tokens=1024"
OVERRIDES="$OVERRIDES,search_agent_max_tool_calls=12,number_documents_to_search=10"
OVERRIDES="$OVERRIDES,tool_calling_mode=parser,use_browse_agent=false"

cd "$AGENT"
rm -f "$OUT/${TASK}.jsonl"      # clean slate (--use-cache resumes from existing output)
echo "[gen] DR-Tulu ReAct $TASK num-examples=$NUMEX  (bm25s frozen corpus, temp 1.0)"
# --use-cache routes through the batch path (workflow.py:610) that injects dataset_name into
# each item; the non-batch self.map path leaves it None -> "Invalid dataset name" (job 24313482).
python "workflows/auto_search_sft.py" generate-dataset "$TASK" \
  --num-examples "$NUMEX" --max-concurrent 8 --batch-size 8 --use-cache \
  --config "workflows/auto_search_sft.yaml" \
  --config-overrides "$OVERRIDES" \
  --output "$OUT/${TASK}.jsonl" < /dev/null

echo; echo "=== DR-TULU UNTRAINED ($TASK) — non-empty / lengths / search usage ==="
python - "$OUT/${TASK}.jsonl" <<'PY'
import json, sys
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
ne=[r for r in rows if (r.get('final_response') or '').strip()]
def ncalls(r):
    t=r.get('full_traces') or {}; tc=t.get('tool_calls') or []
    return len(tc)
print(f"rows={len(rows)} non-empty={len(ne)} ({100*len(ne)//max(1,len(rows))}%)")
lens=sorted((len(r.get('final_response') or '') for r in rows))
calls=[ncalls(r) for r in rows]
print(f"len: min {lens[0]} median {lens[len(lens)//2]} max {lens[-1]} | tool_calls: min {min(calls)} mean {sum(calls)/max(1,len(calls)):.1f} max {max(calls)}")
PY

# --- grade: researchqa COVERAGE with the LOCAL Qwen judge (same grader the RLM baselines use) ---
# evaluate.py:347 hardcodes judge name 'gpt-4.1-mini-2025-04-14' -> we aliased the served Qwen to it.
echo; echo "=== GRADE (researchqa coverage, judge=local Qwen3.5-4B) ==="
OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
  python scripts/evaluate.py "$TASK" "$OUT/${TASK}.jsonl" 2>&1 | tee "$OUT/score_${TASK}.txt" | tail -25
echo "[done] reports: $OUT/${TASK}.jsonl ; score: $OUT/score_${TASK}.txt"
