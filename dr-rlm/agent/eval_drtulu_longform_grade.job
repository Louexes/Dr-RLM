#!/bin/bash
# ============================================================================
# Grade DR-Tulu long-form HB + DRB OFF-GPU (staging = internet, ~0 SBU), Gemini.
# Config-aligned with every existing anchor (all HB/DRB grading is Gemini per
# docs/EVAL_GRADING_REQUIREMENTS.md + EXPERIMENT_LOG rows 118/135/169):
#   HB   = evaluate.py healthbench --grader-model gemini-2.5-flash
#   DRB  = deep_research_bench_eval/run_eval.py  (RACE gemini-2.5-pro, FACT gemini-2.5-flash)
# SQA is graded separately by eval_sqa_grade.job (astabench/uv). Pass OUT + TAG.
# ============================================================================
#SBATCH --job-name=drtulu_lf_grade
#SBATCH --partition=staging
#SBATCH --cpus-per-task=8
#SBATCH --time=03:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_lf_grade_%j.out
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
OUT=${OUT:?set OUT=<run dir with healthbench.jsonl + deep_research_bench.jsonl>}
TAG=${TAG:-$(basename "$OUT")}
source "$VENV/bin/activate"
source "$DRRLM/keys.sh"                                   # GEMINI_API_KEY
export OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export OPENAI_API_KEY="$GEMINI_API_KEY"
export GOOGLE_API_KEY="$GEMINI_API_KEY"                   # DRB run_eval reads GEMINI/GOOGLE
export HEALTHBENCH_LOCAL_PATH=$DRRLM/data/subsets/healthbench_strat120.jsonl
export HF_HOME=/scratch-shared/lgehringer/hf_cache
export PYTHONPATH=$AGENT:${PYTHONPATH:-}
cd "$AGENT"

echo "########## GRADE HealthBench (gemini-2.5-flash) ##########"
hb="$OUT/healthbench.jsonl"
if [ -s "$hb" ]; then
  python scripts/evaluate.py healthbench "$hb" --grader-model gemini-2.5-flash \
    --save_path "$OUT/healthbench_eval_results.json" \
    2>&1 | grep -viE "Authlib|joserfc|Loaded [0-9]+ examples from HF" | tail -15
else echo "[skip] no $hb"; fi

echo; echo "########## GRADE DRB (RACE gemini-2.5-pro / FACT gemini-2.5-flash, EN-only) ##########"
drb="$OUT/deep_research_bench.jsonl"
if [ -s "$drb" ]; then
  python evaluation/deep_research_bench_eval/run_eval.py \
    --input_file "$drb" --task_name "$TAG" --only_en \
    --output_dir "$OUT/drb_eval_${TAG}" \
    2>&1 | grep -viE "Authlib|joserfc" | tail -20
else echo "[skip] no $drb"; fi

echo; echo "===== DR-Tulu long-form ($TAG) HB + DRB summary ====="
python - "$OUT" "$TAG" <<'PY'
import json,os,sys
OUT,TAG=sys.argv[1],sys.argv[2]
hb=os.path.join(OUT,"healthbench_eval_results.json")
if os.path.exists(hb):
    d=json.load(open(hb)); print(f"  HealthBench score={d.get('score')}  n={d.get('num_examples') or d.get('n')}")
dd=os.path.join(OUT,f"drb_eval_{TAG}")
for m in ("race","fact"):
    p=os.path.join(dd,m)
    if os.path.isdir(p):
        js=[f for f in os.listdir(p) if f.endswith('.json')]
        print(f"  DRB {m}: {p} ({len(js)} json)")
PY
echo "[note] SQA graded separately: sbatch --export=ALL,SQA_INPUT=$OUT/sqav2.jsonl eval_sqa_grade.job"
