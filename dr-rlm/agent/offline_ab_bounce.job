#!/bin/bash
# SLURM job — OFFLINE A/B: empty-citations BOUNCE on top of the capstone (DRB n=16) + a
# capstone REPLICATE (DRB n=16, no bounce) for run-to-run variance. The bounce is the
# env-side one-time gate (citations_bounce flag) targeting the 5/16 carry-displacement
# roots no prompt iteration fixed. Refs: capstone 6.00 cites/4.29 valid/0.714 valid_rate/
# RACE 0.330/zero-cite 7-of-16 (2 honest); control 11.25/4.58/0.407/0.352.
#SBATCH --job-name=offline_ab_bounce
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_ab_bounce_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_ab_bounce_%j.err
set -euo pipefail
cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent
BASE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/offline_ab_bounce

COMMON_ENV() {
  export ARMS=structured
  export DR_RLM_CAPTURE_LEDGER=1
  export MODEL=gemini-2.5-flash
  export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
  export MODEL_API_KEY_ENV=GEMINI_API_KEY
  export TOKENIZER=Qwen/Qwen3-8B
  export BENCH=deep_research_bench
  export NUMEX=16
  export MAX_DEPTH=1
  export SEARCH_BACKEND=local_jsonl
  export SEARCH_CORPUS_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/offline_corpus/drb.jsonl
  export MAX_TOOL_CALLS=200
  export MAX_CHILDREN=6
  export GRADE=1
  export SAVE_TRAJ=1
  export CITATION_VERIFY=0
  export CHECK_TOOL=1
  export DR_RLM_PROMPT_FILE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/prompts/variants/reclaim_filter.txt
}

COMMON_ENV; export CITE_BOUNCE=1 OUT=$BASE/bounce
echo "[ab] arm CAPSTONE+BOUNCE ..."
./ab_child_return.sh || echo "[warn] bounce arm failed"

COMMON_ENV; export CITE_BOUNCE=0 OUT=$BASE/replicate
echo "[ab] arm CAPSTONE-REPLICATE (variance) ..."
./ab_child_return.sh || echo "[warn] replicate arm failed"

echo "[offline_ab_bounce] done -> $BASE"
