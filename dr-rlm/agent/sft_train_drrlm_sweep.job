#!/bin/bash
# ============================================================================
# DR-RLM (recursive) cold-start SFT via SkyRL native SFT  (PLAN pivot 2026-07-04:
# LlamaFactory can't load Qwen3.5 (qwen3_5 needs transformers 5.8; LF pins <=4.52.4).
# SkyRL native SFT shares the RL stack -> guaranteed SFT->RL handoff: same transformers 5.8,
# same text-only load (language_model_only=true -> Qwen3_5ForCausalLM), same tokenizer/template.
#
# DR-Tulu design choices preserved (fair comparison), only the training infra changed:
#   data recipe (rejection-sampled R>=0.6 / cite / finalize), prompts, ReAct/REPL harness,
#   loss-masking of tool+subagent outputs, cosine LR + warmup, full FT, hyperparameters.
#   Masking is by SkyRL's ALL_ASSISTANT_MESSAGES: tool_output/subagent_output are USER turns
#   -> automatically excluded from loss; reasoning (<think>) + code + cited report kept.
#   Validated: 8/8 think turns preserved, tool/subagent outputs masked (2026-07-04).
# ============================================================================
#SBATCH --job-name=sft_sweep
#SBATCH --partition=gpu_h100
#SBATCH --gpus=2
#SBATCH --cpus-per-task=32
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_sweep_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_sweep_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$REPO/rl/skyrl
DATA=$REPO/data/sft/primary/dr_rlm_recursive_primary.jsonl
CKPT=/scratch-shared/lgehringer/ckpts/dr_rlm_sft_sweep
mkdir -p "$CKPT" "$REPO/runs/logs"

export HF_HOME=/scratch-shared/lgehringer/hf_cache HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache

# CUDA toolkit (flash-attn / any JIT compile)
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2024 2>/dev/null || true; module load CUDA/12.6.0 2>/dev/null || true
export CUDA_HOME=${CUDA_HOME:-${EBROOTCUDA:-}}

# W&B ONLINE (live dashboard); skyrl asserts on WANDB_API_KEY + forwards it to Ray workers
export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

[ -s "$DATA" ] || { echo "[FATAL] SFT data missing: $DATA"; exit 1; }
echo "[sft] DR-RLM recursive: $(wc -l < "$DATA") rows -> SkyRL native SFT (Qwen3.5-4B text-only)"

cd "$SKYRL"
# NODE-FIX (per run_dr_rlm_L3.sh): launch via venv python DIRECTLY, NOT `uv run` — on these
# gpu_h100 nodes Ray re-launches every worker via `uv run` and hangs (ray._private import).
# The .venv already carries the --extra fsdp deps.
env -u VIRTUAL_ENV ./.venv/bin/python -m skyrl.train.main_sft \
    strategy=fsdp2 \
    model.path=Qwen/Qwen3.5-4B \
    language_model_only=true \
    dataset_name="$DATA" \
    messages_key=conversations \
    train_on_what=all_assistant_messages \
    max_length=32768 \
    num_steps=102 \
    batch_size=8 \
    micro_train_batch_size_per_gpu=1 \
    use_sample_packing=false \
    optimizer_config.lr=4e-5 \
    optimizer_config.scheduler=cosine \
    optimizer_config.num_warmup_steps=10 \
    optimizer_config.weight_decay=0.0 \
    optimizer_config.max_grad_norm=1.0 \
    placement.num_nodes=1 \
    placement.num_gpus_per_node=2 \
    fsdp_config.cpu_offload=false \
    fsdp_config.reshard_after_forward=true \
    seed=42 \
    logger="['console','wandb']" \
    project_name=dr-rlm-sft \
    run_name=drrlm_recursive_sweep \
    ckpt_path="$CKPT" \
    hf_save_interval=34 \
    export_path="$CKPT/hf" \
    "$@"

echo "[sft] done -> HF checkpoint under $CKPT/hf/"
