#!/bin/bash
# ============================================================================
# Untrained DR-Tulu (flat ReAct) SHORT-FORM guardrail baseline — THINKING-ON, GEN ONLY.
# The flat counterpart of eval_drrlm_shortform_thinkon.job. SAME substrate as DR-RLM:
# same 3 coverage-safe subsets (N=120), same bm25s frozen corpus, same 32k / temp 1.0 /
# max_tokens 8192. DR-Tulu's OWN native harness config (max_tool_calls=12, docs=10,
# parser mode, no browse) — mirrors the 0.268 long-form anchor (eval_drtulu_thinkon_full.job);
# the flat-vs-recursive difference IS the comparison. Grading = separate off-GPU step
# with the SAME grader as DR-RLM (gemini-2.5-flash) for a fair head-to-head.
# ============================================================================
#SBATCH --job-name=drtulu_sf_ton
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=02:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_sf_ton_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_sf_ton_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
# model is env-overridable so the SAME file serves untrained / SFT / RL columns:
GEN_MODEL_PATH=${GEN_MODEL_PATH:-Qwen/Qwen3.5-4B}   # serve path (base HF id, or a local grafted ckpt dir)
SERVED_NAME=${SERVED_NAME:-Qwen/Qwen3.5-4B}          # API / served-model-name
TOKENIZER=${TOKENIZER:-Qwen/Qwen3.5-4B}              # grafted ckpts carry the base tokenizer
PORT=${PORT:-8010}
FROZEN=$DRRLM/data/frozen_corpus; OUT=${OUT:-$DRRLM/runs/drtulu_untrained_shortform_thinkon}
N=120; JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY
export SIMPLEQA_LOCAL_PATH=$DRRLM/data/subsets/simpleqa_eval120.jsonl
export TWOWIKI_LOCAL_PATH=$DRRLM/data/subsets/2wiki_eval120.jsonl
export WEBWALKER_LOCAL_PATH=$DRRLM/data/subsets/webwalker_eval120.jsonl

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){
  local log="$DRRLM/runs/logs/drtulu_sf_ton_vllm_${JOBID}.log"
  echo "[serve] vllm $GEN_MODEL_PATH (name=$SERVED_NAME) enable_thinking=true -> $log"
  vllm serve "$GEN_MODEL_PATH" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.85 --max-model-len 32768 --enforce-eager \
    --default-chat-template-kwargs '{"enable_thinking": true}' \
    --served-model-name "$SERVED_NAME" > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 200); do
    curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$log"; exit 1; }
  done; echo "[FATAL] vllm never ready"; exit 1
}

serve
OV="search_tool_name=bm25s,browse_tool_name=bm25s"
OV="$OV,bm25s_index_path=$FROZEN/bm25s_index,bm25s_corpus_path=$FROZEN/corpus.jsonl"
OV="$OV,search_agent_base_url=http://localhost:$PORT/v1"
OV="$OV,search_agent_model_name=$SERVED_NAME,search_agent_tokenizer_name=$TOKENIZER"
OV="$OV,search_agent_temperature=1.0,search_agent_max_tokens=8192"
OV="$OV,search_agent_max_tool_calls=12,number_documents_to_search=10"
OV="$OV,tool_calling_mode=parser,use_browse_agent=false"
cd "$AGENT"

for TASK in simpleqa 2wiki webwalker; do
  echo; echo "########## GEN $TASK (DR-Tulu ReAct, thinking-ON, N=$N) ##########"
  rm -f "$OUT/${TASK}.jsonl"
  python "workflows/auto_search_sft.py" generate-dataset "$TASK" \
    --num-examples "$N" --max-concurrent 8 --batch-size 8 --use-cache \
    --config "workflows/auto_search_sft.yaml" --config-overrides "$OV" \
    --output "$OUT/${TASK}.jsonl" < /dev/null 2>&1 | tail -8
  python - "$OUT/${TASK}.jsonl" "$TASK" <<'PY'
import json,sys
def walk(o):
    if isinstance(o,dict):
        for k,v in o.items(): yield (k,v); yield from walk(v)
    elif isinstance(o,list):
        for v in o: yield from walk(v)
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
ne=[r for r in rows if (r.get("final_response") or "").strip()]
srch=sum(1 for r in rows if sum(v for k,v in walk(r.get("full_traces") or {}) if k=="tool_call_count" and isinstance(v,int))>0)
print(f"[health:{sys.argv[2]}] rows={len(rows)}/120  finalized={len(ne)}/{len(rows)}  retrieval-alive={srch}/{len(rows)}")
PY
done
echo; echo "[done] gen complete — releasing GPU. Grade off-GPU: sbatch agent/eval_drtulu_shortform_grade.job"
