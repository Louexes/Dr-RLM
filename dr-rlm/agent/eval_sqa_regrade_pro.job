#!/bin/bash
# SQA re-grade with the STRONG grader (gemini-2.5-pro) across the 3 recursive stages,
# SEQUENTIALLY (one stage at a time -> respects Gemini rate limits; no cross-stage parallelism).
# Tests whether the RL-vs-untrained SQA tie (-0.014, flash-graded) moves under a stronger,
# rubric-faithful grader. Same astabench/inspect harness, ONLY scorer_model swapped flash->pro.
#SBATCH --job-name=sqa_regrade_pro
#SBATCH --partition=staging
#SBATCH --cpus-per-task=8
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sqa_regrade_pro_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sqa_regrade_pro_%j.err
set -uo pipefail
REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
SCORER=${SCORER:-google/gemini-2.5-pro}
source "$DRRLM/keys.sh"; export GOOGLE_API_KEY="$GEMINI_API_KEY"
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache HF_HOME=/scratch-shared/lgehringer/hf_cache
cd "$AGENT"
declare -A STAGE=(
  [untrained]="$DRRLM/runs/drrlm_untrained_thinkon/sqav2.jsonl"
  [sft]="$DRRLM/runs/drrlm_sft2ep_thinkon/sqav2.jsonl"
  [rl]="$DRRLM/runs/drrlm_fresh100_thinkon/sqav2.jsonl"
)
for name in untrained sft rl; do   # sequential: one Gemini stream at a time
  IN="${STAGE[$name]}"; OUT="$(dirname "$IN")/sqa_eval_pro"
  echo "########## SQA REGRADE [$name] scorer=$SCORER -> $OUT ##########"
  python evaluation/sqa_eval/run_eval.py run --input_file "$IN" --scorer_model "$SCORER" --max_connections 8 --output_dir "$OUT" 2>&1 \
    | grep -viE "^\s*$|Downloading|it/s\]" | tail -25
  echo "[regrade $name] score files:"; ls -la "$OUT" 2>/dev/null | tail -3
done
echo "===== DONE. Extract global_avg from each sqa_eval_pro/*.eval (compare to flash: untr/sft/rl) ====="
