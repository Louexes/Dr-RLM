#!/bin/bash
# ============================================================================
# DIAGNOSTIC (not a baseline): does untrained DR-Tulu actually SEARCH if we turn
# thinking ON? The thinking-OFF full run did 0 searches on all 120 items (answered
# from memory, fabricated cites) -> 0.227 coverage. The DR-Tulu paper's "Qwen3-8B +
# Search" baseline (46.3) used LIVE web + an 8B model that DID retrieve. This probe
# isolates the thinking lever on OUR harness: same bm25s bridge, same 12 items, but
# enable_thinking=true and a larger per-gen budget (so a <think> block doesn't eat the
# turn before the model can emit <call_tool>). Confirms three things at once:
#   (a) does the model emit <call_tool name="snippet_search">  (does it search at all)
#   (b) does the bm25s bridge fire + inject real <snippet id=...> from the frozen corpus
#   (c) does coverage climb when answers are grounded
# DIAGNOSTIC DEVIATIONS from the parity baseline: enable_thinking=true, max_tokens 4096.
# ============================================================================
#SBATCH --job-name=drtulu_think
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=00:50:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_think_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_think_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
DRRLM=$REPO/dr-rlm
AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B
PORT=8002
FROZEN=$DRRLM/data/frozen_corpus
OUT=$DRRLM/runs/drtulu_thinkon_probe
TASK=researchqa
N=12
GRADER_ALIAS=gpt-4.1-mini-2025-04-14
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false
export OPENAI_API_KEY=EMPTY
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl

# --- serve Qwen3.5-4B with THINKING ON ------------------------------------------
VLLM_LOG="$DRRLM/runs/logs/drtulu_think_vllm_${SLURM_JOB_ID:-local}.log"
echo "[serve] vllm serve $MODEL (THINKING ON, eager) -> $VLLM_LOG"
vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.85 --max-model-len 32768 --enforce-eager \
  --default-chat-template-kwargs '{"enable_thinking": true}' \
  --served-model-name "$MODEL" "$GRADER_ALIAS" > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'kill $VLLM_PID 2>/dev/null || true' EXIT
for s in $(seq 1 180); do
  curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; break; }
  sleep 5; kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$VLLM_LOG"; exit 1; }
done

OVERRIDES="search_tool_name=bm25s,browse_tool_name=bm25s"
OVERRIDES="$OVERRIDES,bm25s_index_path=$FROZEN/bm25s_index,bm25s_corpus_path=$FROZEN/corpus.jsonl"
OVERRIDES="$OVERRIDES,search_agent_base_url=http://localhost:$PORT/v1"
OVERRIDES="$OVERRIDES,search_agent_model_name=$MODEL,search_agent_tokenizer_name=$MODEL"
OVERRIDES="$OVERRIDES,search_agent_temperature=1.0,search_agent_max_tokens=4096"   # bigger budget so <think> doesn't eat the turn
OVERRIDES="$OVERRIDES,search_agent_max_tool_calls=12,number_documents_to_search=10"
OVERRIDES="$OVERRIDES,tool_calling_mode=parser,use_browse_agent=false"

cd "$AGENT"
rm -f "$OUT/${TASK}.jsonl"
echo "[gen] DR-Tulu ReAct (THINKING ON) $TASK N=$N ..."
python "workflows/auto_search_sft.py" generate-dataset "$TASK" \
  --num-examples "$N" --max-concurrent 6 --batch-size 6 --use-cache \
  --config "workflows/auto_search_sft.yaml" \
  --config-overrides "$OVERRIDES" \
  --output "$OUT/${TASK}.jsonl" < /dev/null

echo; echo "=== DID IT SEARCH? bridge fire? real snippets? (per item) ==="
python - "$OUT/${TASK}.jsonl" <<'PY'
import json, sys, re
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
def searches(ft):
    n=int(ft.get("tool_call_count") or 0)
    for t in (ft.get("tool_calls") or []):
        if isinstance(t,dict): n+=int(t.get("tool_call_count") or 0)
    return n
tot_s=0; tot_inj=0; tot_realcite=0
for r in rows:
    ft=r.get("full_traces") or {}
    gt=ft.get("generated_text") or ""
    s=searches(ft)
    calltags=gt.count("<call_tool")
    injected=gt.count("<snippet id=") + gt.count("<tool_output")
    fr=r.get("final_response") or ""
    cites=re.findall(r'<cite id="?([^">]+)"?>', fr)
    realcite=sum(1 for c in cites if re.match(r'^[0-9a-f]{6,}-\d+$', c))  # call_id-index surfaced ids
    tot_s+=s; tot_inj+=injected; tot_realcite+=realcite
    print(f"  {str(r.get('example_id',''))[:12]} searches={s} call_tags={calltags} snippets_injected={injected} len={len(fr)} cites={len(cites)} surfaced-id-cites={realcite}")
print(f"\nTOT: items={len(rows)} items-that-searched={sum(1 for r in rows if searches(r.get('full_traces') or {})>0)}/{len(rows)} total_searches={tot_s} total_snippet_injections={tot_inj} surfaced-id-cites={tot_realcite}")
PY

# !!! BUG (do NOT grade here): this serve is thinking-ON, so the judge on this same endpoint
# also thinks -> grading stalls (every verdict emits <think>). Grade the banked reports in a
# SEPARATE thinking-off serve instead: dr-rlm/agent/grade_thinkon_probe.job. (Kept disabled.)
echo; echo "=== reports banked; grade separately with grade_thinkon_probe.job (thinking-off judge) ==="
if false; then
OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
  python scripts/evaluate.py "$TASK" "$OUT/${TASK}.jsonl" 2>&1 | grep -iE "coverage|overall|score" | grep -viE "Coverage for|Expected|Questions" | tail -8
fi
python - "$OUT/researchqa_eval_results.json" <<'PY'
import json,sys,os
f=sys.argv[1]
if os.path.exists(f):
    d=json.load(open(f)); print("AGGREGATE coverage:", d.get("score") or d.get("metrics",{}).get("coverage"))
PY
echo "[done] reports: $OUT/${TASK}.jsonl"
