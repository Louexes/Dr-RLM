#!/bin/bash
# SLURM job — OFFLINE harness smoke: 2 DRB items over the snapshot corpus (zero Serper/Jina).
# Validates the offline iteration loop Louis asked for: search() -> local_jsonl over
# data/offline_corpus/healthbench.jsonl (harvested from our own saved run ledgers), citations,
# child contracts, trajectories — everything but live retrieval. Only Gemini tokens spent.
#SBATCH --job-name=offline_hb_check
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=01:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_hb_check_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_hb_check_%j.err
set -euo pipefail

cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent
export ARMS=structured
export DR_RLM_CAPTURE_LEDGER=1
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export TOKENIZER=Qwen/Qwen3-8B
export BENCH=healthbench
export NUMEX=7
export MAX_DEPTH=1
export SEARCH_BACKEND=local_jsonl
export SEARCH_CORPUS_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/offline_corpus/healthbench.jsonl
export MAX_TOOL_CALLS=200
export MAX_CHILDREN=6
export GRADE=1
export SAVE_TRAJ=1
export CITATION_VERIFY=1
export HEALTHBENCH_LOCAL_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/subsets/healthbench_hard_repr.jsonl
export OUT=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/offline_hb_check

echo "[job ${SLURM_JOB_ID:-local}] offline smoke: HealthBench n=7 mechanics check, adopted config"
exec ./ab_child_return.sh
