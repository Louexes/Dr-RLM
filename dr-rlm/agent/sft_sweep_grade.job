#!/bin/bash
# ============================================================================
# SFT recipe-sweep GRADE (off-GPU, staging/internet) — RACE-grades every DRB-24 gen from the
# sweep and prints the decision table: config x epoch -> finalization / recursion% / orphan% / DRB RACE,
# vs anchors (untrained DRB 0.291, banked 2ep-canonical 0.179). ~0 SBU (Gemini off-GPU).
# Submit AFTER all 3 gen jobs: sbatch --dependency=afterok:<genA>:<genB>:<genC> this.job
# ============================================================================
#SBATCH --job-name=sftsw_grade
#SBATCH --partition=staging
#SBATCH --cpus-per-task=8
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sftsw_grade_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sftsw_grade_%j.err
set -uo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
SWEEP=$DRRLM/runs/sft_sweep
source "$VENV/bin/activate"
source "$DRRLM/keys.sh"
export OPENAI_API_KEY="$GEMINI_API_KEY" GOOGLE_API_KEY="$GEMINI_API_KEY"

cd "$AGENT"
for jsonl in "$SWEEP"/*/e*/deep_research_bench.jsonl; do
  [ -s "$jsonl" ] || continue
  d=$(dirname "$jsonl"); tag=$(echo "$d" | sed "s|$SWEEP/||;s|/|_|g")
  if ls "$d"/race/**/race_result.txt >/dev/null 2>&1; then echo "[skip graded] $tag"; continue; fi
  echo "=== RACE grading $tag ==="
  python evaluation/deep_research_bench_eval/run_eval.py \
    --input_file "$jsonl" --task_name "$tag" --only_en --output_dir "$d" 2>&1 \
    | grep -iE 'overall_score|RACE|error' | tail -5
done

echo; echo "############## SFT RECIPE SWEEP — DECISION TABLE ##############"
cd "$DRRLM"
python - "$SWEEP" <<'PY'
import glob, os, re, sys
sweep = sys.argv[1]
def race_overall(d):
    for f in glob.glob(os.path.join(d, "**", "race_result.txt"), recursive=True):
        for line in open(f):
            m = re.search(r"overall_score:\s*([\d.]+)", line)
            if m: return float(m.group(1))
    return None
def behav(d):
    f = os.path.join(d, "behavioral.txt")
    out = {"final": None, "rec": None, "orphan": None}
    if not os.path.exists(f): return out
    txt = open(f).read()
    for key, pat in {"final": r"finaliz\w*[^\d]*([\d.]+)",
                     "rec":   r"recursion[^\d]*([\d.]+)",
                     "orphan":r"orphan[^\d]*([\d.]+)"}.items():
        m = re.search(pat, txt, re.I)
        if m: out[key] = float(m.group(1))
    return out
def f(x, p=3): return "  --  " if x is None else f"{x:.{p}f}"
def sgn(x): return "  --  " if x is None else (f"+{x:.3f}" if x >= 0 else f"{x:.3f}")

# --- DRB-24 baselines (same subset+grader as the sweep) ---
UNTR = race_overall(os.path.join(sweep, "_baseline", "euntrained"))
CANON = race_overall(os.path.join(sweep, "_baseline", "ecanon2ep"))  # THE existing RL init
print("DRB-24 baselines (same subset+grader):")
print(f"  untrained base      = {f(UNTR)}")
print(f"  2ep-canonical (RL init) = {f(CANON)}   <- beat THIS to have a better init\n")

hdr = f"{'config/epoch':20}{'final':>7}{'recur':>7}{'orph':>7}{'DRB24':>8}{'Δ untr':>9}{'Δ RLinit':>10}  {'verdict':>18}"
print(hdr); print("-"*len(hdr))
rows=[]
for d in sorted(glob.glob(os.path.join(sweep, "*", "e*"))):
    tag = os.path.relpath(d, sweep)
    if tag.startswith("_baseline"): continue
    r = race_overall(d); b = behav(d)
    du = None if (r is None or UNTR is None) else r-UNTR
    dc = None if (r is None or CANON is None) else r-CANON
    beh_ok = (b['rec'] is not None and b['rec'] >= 0.5) and (b['final'] is not None and b['final'] >= 0.7)
    if r is None: verdict = "no score"
    elif not beh_ok: verdict = "BEHAVIOR-FAIL"          # scaffold lost -> unusable init
    elif CANON is not None and r >= CANON: verdict = "BETTER INIT ✓"
    elif UNTR is not None and r >= UNTR-0.005: verdict = "≥untr, <RLinit"
    else: verdict = "below"
    print(f"{tag:20}{f(b['final'],2):>7}{f(b['rec'],2):>7}{f(b['orphan'],2):>7}{f(r):>8}{sgn(du):>9}{sgn(dc):>10}  {verdict:>18}")
    if r is not None: rows.append((tag, r, b, beh_ok))
usable = [x for x in rows if x[3]]
if usable:
    best = max(usable, key=lambda x: x[1])
    tag, r = best[0], best[1]
    if CANON is not None and r >= CANON:
        call = f"GO: {tag} DRB24={r:.3f} beats RL-init {CANON:.3f} (+{r-CANON:.3f}) w/ behavior intact -> healthy init, 50-step RL x3"
    else:
        call = f"LEAN FALLBACK: best usable {tag}={r:.3f} does NOT beat RL-init {f(CANON)} -> banked 100-step run stands"
    print(f"\n{call}")
else:
    print("\n[no behavior-passing config scored — check gen/grade logs]")
PY
echo "[done] decision table above"
