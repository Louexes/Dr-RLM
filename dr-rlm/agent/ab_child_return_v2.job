#!/bin/bash
# SLURM batch job — prose-vs-structured child-return A/B, V2 (FINDINGS design).
# Mirrors V1's task set (DRB ids 51-58 = first 8 of drb_en50.jsonl) so the prose arm and
# task difficulty are directly comparable to runs/ab_child_return_v1. NOTE: the structured
# arm here is the NEW FINDINGS contract (atoms + salvage + width cap), not V1's structured
# rewrite — so structured is a fresh measurement, prose + task set are the anchors.
# Fresh OUT dir keeps V1 and the disputed n=20 run intact.
#SBATCH --job-name=ab_child_return_v2
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/ab_child_return_v2_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/ab_child_return_v2_%j.err
set -euo pipefail

mkdir -p /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs
cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent

export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export TOKENIZER=Qwen/Qwen3-8B
export BENCH=deep_research_bench
export NUMEX=8                 # first 8 of drb_en50 = ids 51-58, the V1 set
export MAX_DEPTH=1
export SEARCH_BACKEND=web
export MAX_TOOL_CALLS=80
export MAX_CHILDREN=6
export GRADE=1
export SAVE_TRAJ=1
export OUT=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/ab_child_return_v2

echo "[job ${SLURM_JOB_ID:-local}] $(hostname) starting A/B V2 n=8 (resumes from existing rows in $OUT)"
exec ./ab_child_return.sh
