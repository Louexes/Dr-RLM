#!/bin/bash
# STEP 2 — DR-RLM (recursive arm) cold-start SFT training.
# Prereq: run sft_preflight.job first (repairs the lf_train venv + passes Gate A think-preservation
# and Gate B span-masking). This job assumes the venv imports torch+deepspeed+llamafactory.
# Data = data/sft/primary/dr_rlm_recursive_primary.jsonl (registered as dr_rlm_recursive_primary),
# config = sft/llama-factory/train/dr_rlm_sft.yaml (Qwen3.5-4B, full FT, z3, dual span mask, 3 ep).
#SBATCH --job-name=sft_train_drrlm
#SBATCH --partition=gpu_h100
#SBATCH --gpus=2
#SBATCH --cpus-per-task=32
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_train_drrlm_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_train_drrlm_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
LF=$DRRLM/sft/llama-factory
# ACTIVATE (not $V/binary) so llamafactory-cli's inner torchrun resolves venv python, not
# /usr/bin/python3.11 + ~/.local torch (that gave ModuleNotFoundError: No module named 'llamafactory')
set +u; source /scratch-shared/lgehringer/venvs/lf_train/bin/activate; set -u
export HF_HOME=/scratch-shared/lgehringer/hf_cache HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export FORCE_TORCHRUN=1                       # LF multi-GPU launcher
# W&B offline (compute nodes mirror HF-offline); dir on scratch to spare home inodes.
# after the run: `wandb sync /scratch-shared/lgehringer/wandb/offline-run-*` from a login node.
export WANDB_MODE=offline WANDB_DIR=/scratch-shared/lgehringer/wandb
export WANDB_PROJECT=dr-rlm-sft WANDB_NAME=drrlm_recursive_primary

# deepspeed JIT-compiles CUDA ops at runtime -> needs nvcc from the CUDA toolkit module
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2024 2>/dev/null || true; module load CUDA/12.6.0 2>/dev/null || true
export CUDA_HOME=${CUDA_HOME:-${EBROOTCUDA:-}}
echo "[cuda] CUDA_HOME=$CUDA_HOME nvcc=$(command -v nvcc || echo MISSING)"

# fail fast if the venv wasn't repaired by preflight
python -c "import torch, deepspeed, llamafactory; assert torch.cuda.is_available()" \
  || { echo "[FATAL] lf_train venv not ready — run sft_preflight.job first"; exit 1; }

cd "$LF"
echo "[train] DR-RLM SFT: Qwen3.5-4B, $(wc -l < $DRRLM/data/sft/primary/dr_rlm_recursive_primary.jsonl) rows, 3 epochs"
llamafactory-cli train train/dr_rlm_sft.yaml

echo "[train] done -> $LF/ckpts/dr_rlm_sft"
ls -la "$LF/ckpts/dr_rlm_sft" 2>/dev/null | head
