#!/bin/bash
# EPOCH SWEEP behavioral probe: 1/2/3-epoch SFT checkpoints vs untrained (reused), thinking-ON,
# same 16 ResearchQA prompts + same thinking-OFF judge. Finds the "knee" — protocol installed
# (finalize/cite) with entropy preserved (pair with sweep_heldout_nll for the overfit axis).
#SBATCH --job-name=sweep_probe
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sweep_probe_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sweep_probe_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
BASE_MODEL=Qwen/Qwen3.5-4B
BASE_SNAP=/scratch-shared/lgehringer/hf_cache/hub/models--Qwen--Qwen3.5-4B/snapshots/851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
SWEEP=/scratch-shared/lgehringer/ckpts/dr_rlm_sft_sweep
PORT=8008; GRADER_ALIAS=gpt-4.1-mini-2025-04-14
FROZEN=$DRRLM/data/frozen_corpus; TASK=researchqa; N=16; SHARDS=4
JOBID=${SLURM_JOB_ID:-local}
UNTR=$DRRLM/runs/probe_untrained_ton    # reuse existing untrained arm (already generated + graded)
mkdir -p "$DRRLM/runs/logs"
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY HF_HOME=/scratch-shared/lgehringer/hf_cache HF_HUB_OFFLINE=1
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt

# --- graft each epoch checkpoint -> servable (reuses scripts/graft_text_into_multimodal.py) ---
for STEP in 34 68 102; do
  SRC=$SWEEP/hf/global_step_$STEP/policy; DST=$SWEEP/served_$STEP
  [ -d "$SRC" ] || { echo "[FATAL] missing checkpoint $SRC"; exit 1; }
  if [ ! -f "$DST/config.json" ]; then
    echo "[graft] step $STEP -> $DST"
    python "$DRRLM/scripts/graft_text_into_multimodal.py" --base "$BASE_SNAP" --text "$SRC" --out "$DST"
  fi
done

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){  # $1=model $2=think $3=name $4=tag [$5=alias]
  local model="$1" think="$2" name="$3" tag="$4" alias="${5:-}"
  local log="$DRRLM/runs/logs/sweep_vllm_${tag}_${JOBID}.log"
  vllm serve "$model" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
    --default-chat-template-kwargs "{\"enable_thinking\": $think}" \
    --served-model-name "$name" $alias > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 300); do curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve:$tag] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm($tag) died"; tail -40 "$log"; exit 1; }; done
  echo "[FATAL] vllm($tag) never ready"; exit 1; }
swap_kill(){ kill "$CUR_PID" 2>/dev/null || true; CUR_PID=""
  for s in $(seq 1 24); do curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && sleep 5 || break; done; }
gen_arm(){ local name="$1" out="$2"; local GEN=$DRRLM/agent/generate.py; cd "$AGENT"
  rm -f "$out"/shard_*.jsonl "$out/${TASK}.jsonl"; mkdir -p "$out"
  local COMMON="--driver new --benchmark $TASK --model $name --tokenizer-path $BASE_MODEL \
    --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
    --max-recursion-depth 1 --max-iterations 10 --max-completion-tokens 8192 \
    --max-tool-calls 80 --max-children 10 --child-return-mode structured \
    --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
    --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
    --abort-after-dead-items 1000 --num-examples $N"
  local pids=(); for i in $(seq 0 $((SHARDS-1))); do
    python "$GEN" $COMMON --num-shards "$SHARDS" --shard "$i" --output "$out/shard_${i}.jsonl" \
      --save-trajectories "$out/traj_${i}" > "$out/shard_${i}.log" 2>&1 < /dev/null & pids+=($!); done
  local fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
  cat "$out"/shard_*.jsonl > "$out/${TASK}.jsonl" 2>/dev/null || true
  echo "[gen] $name -> $(wc -l < "$out/${TASK}.jsonl") rows ($fail fails)"; }

# --- gen each epoch arm (thinking-ON) ---
for STEP in 34 68 102; do
  ep=$((STEP/34))
  echo "===== ${ep}ep (step $STEP) gen ====="
  serve "$SWEEP/served_$STEP" true "sft_${ep}ep" "g$STEP"
  gen_arm "sft_${ep}ep" "$DRRLM/runs/sweep_${ep}ep"
  swap_kill
done

# --- judge thinking-OFF, grade the 3 sweep arms (untrained already graded) ---
echo "===== JUDGE (thinking-OFF) ====="
serve "$BASE_MODEL" false "$BASE_MODEL" judge "$GRADER_ALIAS"
cd "$AGENT"
for ep in 1 2 3; do
  out=$DRRLM/runs/sweep_${ep}ep
  OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
    python scripts/evaluate.py "$TASK" "$out/${TASK}.jsonl" 2>&1 | grep -viE "Coverage for|Expected 8|Questions:|Authlib|joserfc|Computing rubric" | tail -3
  python - "$out/${TASK}_eval_results.json" "$ep" <<'PY'
import json,sys,os
f,ep=sys.argv[1],sys.argv[2]
if os.path.exists(f): d=json.load(open(f)); print(f"[{ep}ep] coverage:", d.get("score") or d.get("metrics",{}).get("coverage"),"| n=",d.get("num_examples"))
PY
done
swap_kill

# --- behavioral diff across all arms ---
echo; echo "===== SWEEP behavioral: Untrained vs 1/2/3 epoch ====="
cd "$DRRLM"
python analysis/behavioral_metrics.py \
  --run "Untrained:$UNTR/${TASK}.jsonl" \
  --run "1ep:$DRRLM/runs/sweep_1ep/${TASK}.jsonl" \
  --run "2ep:$DRRLM/runs/sweep_2ep/${TASK}.jsonl" \
  --run "3ep:$DRRLM/runs/sweep_3ep/${TASK}.jsonl" 2>&1 | tail -40
echo "[done] sweep probe"
