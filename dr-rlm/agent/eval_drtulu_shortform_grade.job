#!/bin/bash
# ============================================================================
# Grade the untrained DR-Tulu short-form baseline OFF-GPU — SAME grader as the
# DR-RLM short-form baseline (gemini-2.5-flash) for a fair head-to-head. Runs on
# staging (internet, ~0 SBU). DR-Tulu output rows carry gold in original_data.
# ============================================================================
#SBATCH --job-name=drtulu_sf_grade
#SBATCH --partition=staging
#SBATCH --cpus-per-task=4
#SBATCH --time=01:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_sf_grade_%j.out
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
OUT=${OUT:-$DRRLM/runs/drtulu_untrained_shortform_thinkon}
source "$VENV/bin/activate"
source "$DRRLM/keys.sh"
export OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export OPENAI_API_KEY="$GEMINI_API_KEY"
export PYTHONPATH=$AGENT:${PYTHONPATH:-}
cd "$AGENT"

for TASK in simpleqa 2wiki webwalker; do
  f="$OUT/${TASK}.jsonl"
  [ -s "$f" ] || { echo "[skip] $TASK: no gen output"; continue; }
  echo; echo "########## GRADE $TASK (gemini-2.5-flash) ##########"
  python scripts/evaluate.py "$TASK" "$f" --grader-model gemini-2.5-flash \
    2>&1 | grep -viE "Authlib|joserfc|Loaded [0-9]+ examples from HF" | tail -12
done

echo; echo "===== SHORT-FORM UNTRAINED DR-TULU (thinking-ON) SUMMARY ====="
python - "$OUT" <<'PY'
import json,os,sys
OUT=sys.argv[1]; LOCK=120
for t in ("simpleqa","2wiki","webwalker"):
    rf=os.path.join(OUT,f"{t}_eval_results.json")
    if os.path.exists(rf):
        d=json.load(open(rf)); sc=d.get("score") or (d.get("metrics") or {}).get("accuracy"); n=d.get("num_examples") or d.get("n")
        correct=round(sc*n) if sc is not None and n else None
        strict=correct/LOCK if correct is not None else None
        print(f"  {t:10s} correct={correct}/n={n}  over-completed={sc}  strict-over-120={strict}")
    else:
        print(f"  {t:10s} (no results file)")
PY
