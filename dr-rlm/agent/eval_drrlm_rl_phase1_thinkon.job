#!/bin/bash
# ============================================================================
# DR-RLM 2-EPOCH SFT eval — THINKING-ON (ResearchQA N=120). SFT column of the
# Untrained->SFT->RL progression. CONFIG IS BYTE-IDENTICAL to the untrained thinking-ON
# baseline (eval_drrlm_untrained_thinkon.job, coverage 0.237) — the ONLY difference is the
# generation model: 2ep SFT checkpoint vs base Qwen3.5-4B. Judge is the SAME base-Qwen
# thinking-OFF grader (aliased gpt-4.1-mini). So the coverage delta = TRAINING, nothing else.
#   gen model : dr_rlm_sft_CANONICAL_2ep_served (grafted, vLLM-servable) — thinking-ON
#   judge     : Qwen/Qwen3.5-4B thinking-OFF (identical to untrained baseline)
# No DR_RLM_CAPTURE_LEDGER (untrained RQA baseline didn't set it; RQA=coverage only, no FACT).
# ============================================================================
#SBATCH --job-name=drrlm_rl_p1
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=03:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_rl_p1_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_rl_p1_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
GEN_MODEL_PATH=/scratch-shared/lgehringer/ckpts/dr_rlm_rl_phase1_served
JUDGE_MODEL=Qwen/Qwen3.5-4B      # judge = base, thinking-OFF (SAME as untrained baseline)
TOKENIZER=Qwen/Qwen3.5-4B        # identical tokenizer (grafted ckpt carries the base tokenizer)
MODEL=drrlm_rl_phase1              # served-model-name / API name for the gen model
PORT=8014; GRADER_ALIAS=gpt-4.1-mini-2025-04-14
FROZEN=$DRRLM/data/frozen_corpus; OUT=$DRRLM/runs/drrlm_rl_phase1_thinkon; TASK=researchqa; N=120; SHARDS=8
JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"; rm -f "$OUT"/shard_*.jsonl "$OUT/${TASK}.jsonl"
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY
export HF_HOME=/scratch-shared/lgehringer/hf_cache HF_HUB_OFFLINE=1
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){  # $1=model_to_serve $2=enable_thinking $3=served_name $4=tag [$5=alias]
  local model="$1" think="$2" name="$3" tag="$4" alias="${5:-}"
  local log="$DRRLM/runs/logs/drrlm_sft2ep_vllm_${tag}_${JOBID}.log"
  echo "[serve:$tag] vllm $model enable_thinking=$think name=$name -> $log"
  vllm serve "$model" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
    --default-chat-template-kwargs "{\"enable_thinking\": $think}" \
    --served-model-name "$name" $alias > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 300); do
    curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve:$tag] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm($tag) died"; tail -40 "$log"; exit 1; }
  done; echo "[FATAL] vllm($tag) never ready"; exit 1
}

# --- PHASE 1: generation, THINKING ON, sharded (SFT 2ep model) ---
serve "$GEN_MODEL_PATH" true "$MODEL" gen
GEN=$DRRLM/agent/generate.py; cd "$AGENT"
echo "[gen] DR-RLM 2ep-SFT THINKING-ON depth=1 N=$N across $SHARDS parallel shards (prompt=$DR_RLM_PROMPT_FILE) ..."
COMMON="--driver new --benchmark $TASK --model $MODEL --tokenizer-path $TOKENIZER \
  --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
  --max-recursion-depth 1 --max-iterations 10 --max-completion-tokens 8192 \
  --max-tool-calls 80 --max-children 10 --child-return-mode structured \
  --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
  --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
  --abort-after-dead-items 1000 --num-examples $N"
pids=()
for i in $(seq 0 $((SHARDS-1))); do
  python "$GEN" $COMMON --num-shards "$SHARDS" --shard "$i" \
    --output "$OUT/shard_${i}.jsonl" --save-trajectories "$OUT/traj_${i}" \
    > "$OUT/shard_${i}.log" 2>&1 < /dev/null &
  pids+=($!)
done
echo "[gen] launched ${#pids[@]} shard processes; waiting ..."
fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
cat "$OUT"/shard_*.jsonl > "$OUT/${TASK}.jsonl" 2>/dev/null || true
echo "[gen] done ($fail shard(s) nonzero). merged rows: $(wc -l < "$OUT/${TASK}.jsonl" 2>/dev/null)"

echo; echo "=== generation health (did <think> appear + repl still parsed?) ==="
python - "$OUT/${TASK}.jsonl" <<'PY'
import json,sys
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
ne=sum(1 for r in rows if (r.get("final_response") or "").strip())
def alltext(o):
    if isinstance(o,dict):
        for v in o.values(): yield from alltext(v)
    elif isinstance(o,list):
        for v in o: yield from alltext(v)
    elif isinstance(o,str): yield o
think=repl=0
for r in rows:
    for t in alltext(r.get("full_traces") or {}):
        think+=t.count("</think>"); repl+=t.count("```repl")
print(f"rows={len(rows)}/120  non-empty={ne}  Σ</think>={think}  Σ```repl```={repl}")
PY

# --- PHASE 2: grading, thinking-OFF base-Qwen judge (SAME as untrained baseline) ---
echo; echo "[swap] killing thinking-ON gen serve, starting thinking-OFF judge ..."
kill "$CUR_PID" 2>/dev/null || true; CUR_PID=""
for s in $(seq 1 24); do curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && sleep 5 || break; done
serve "$JUDGE_MODEL" false "$JUDGE_MODEL" judge "$GRADER_ALIAS"
echo "=== GRADE (thinking-OFF judge) ==="
OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
  python scripts/evaluate.py "$TASK" "$OUT/${TASK}.jsonl" 2>&1 | grep -viE "Coverage for|Expected 8|Questions:|Authlib|joserfc|Computing rubric" | tail -8
python - "$OUT/${TASK}_eval_results.json" <<'PY'
import json,sys,os
f=sys.argv[1]
if os.path.exists(f):
    d=json.load(open(f)); print("DR-RLM 2ep-SFT (thinking-ON) coverage:", d.get("score") or d.get("metrics",{}).get("coverage"), "| n=", d.get("num_examples"), "| untrained anchor=0.237")
PY
echo "[done] $OUT/${TASK}.jsonl"
