#!/bin/bash
# ============================================================================
# Untrained DR-RLM SHORT-FORM guardrail baseline — THINKING-ON, GEN ONLY.
# 3 benchmarks × N=120 (SimpleQA / 2Wiki / WebWalker-English), one vLLM serve,
# 8 parallel shards each. Same locked COMMON as the long-form untrained baselines
# (depth1/turns10/8192/children10/structured/bm25s frozen corpus, thinkon prompt).
# Grading is a SEPARATE off-GPU step (eval_drrlm_shortform_grade.job) — GPU nodes
# have no internet. Trajectories NOT saved (full_traces are embedded in each row;
# protects the home inode quota). Releases the GPU as soon as gen is done.
# pilot (24476627) verified: retrieval alive (100-712 snippets/item), recursion OK;
# thinking-ON finalizes ~25% (documented deficit) -> strict baseline, as decided.
# ============================================================================
#SBATCH --job-name=drrlm_sf_ton
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_sf_ton_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_sf_ton_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
# model is env-overridable so the SAME file serves untrained / SFT / RL columns:
GEN_MODEL_PATH=${GEN_MODEL_PATH:-Qwen/Qwen3.5-4B}   # serve path (base HF id, or a local grafted ckpt dir)
SERVED_NAME=${SERVED_NAME:-Qwen/Qwen3.5-4B}          # API / served-model-name
TOKENIZER=${TOKENIZER:-Qwen/Qwen3.5-4B}              # grafted ckpts carry the base tokenizer
PORT=${PORT:-8008}
FROZEN=$DRRLM/data/frozen_corpus; OUT=${OUT:-$DRRLM/runs/drrlm_untrained_shortform_thinkon}
N=120; SHARDS=8; JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY
export PYTHONPATH=$AGENT:$DRRLM/agent:${PYTHONPATH:-}
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt
export SIMPLEQA_LOCAL_PATH=$DRRLM/data/subsets/simpleqa_eval120.jsonl
export TWOWIKI_LOCAL_PATH=$DRRLM/data/subsets/2wiki_eval120.jsonl
export WEBWALKER_LOCAL_PATH=$DRRLM/data/subsets/webwalker_eval120.jsonl

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){
  local log="$DRRLM/runs/logs/drrlm_sf_ton_vllm_${JOBID}.log"
  echo "[serve] vllm $GEN_MODEL_PATH (name=$SERVED_NAME) enable_thinking=true -> $log"
  vllm serve "$GEN_MODEL_PATH" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
    --default-chat-template-kwargs '{"enable_thinking": true}' \
    --served-model-name "$SERVED_NAME" > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 240); do
    curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$log"; exit 1; }
  done; echo "[FATAL] vllm never ready"; exit 1
}

serve
GEN=$DRRLM/agent/generate.py; cd "$AGENT"
COMMON_TAIL="--model $SERVED_NAME --tokenizer-path $TOKENIZER \
  --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
  --max-recursion-depth 1 --max-iterations 10 --max-completion-tokens 8192 \
  --max-tool-calls 80 --max-children 10 --child-return-mode structured \
  --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
  --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
  --abort-after-dead-items 1000 --num-examples $N"

for TASK in simpleqa 2wiki webwalker; do
  echo; echo "########## GEN $TASK (thinking-ON, N=$N, $SHARDS shards) ##########"
  rm -f "$OUT"/${TASK}_shard_*.jsonl "$OUT/${TASK}.jsonl"
  pids=()
  for i in $(seq 0 $((SHARDS-1))); do
    python "$GEN" --driver new --benchmark "$TASK" $COMMON_TAIL --num-shards "$SHARDS" --shard "$i" \
      --output "$OUT/${TASK}_shard_${i}.jsonl" > "$OUT/${TASK}_shard_${i}.log" 2>&1 < /dev/null &
    pids+=($!)
  done
  fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
  cat "$OUT"/${TASK}_shard_*.jsonl > "$OUT/${TASK}.jsonl" 2>/dev/null || true
  echo "[gen] $TASK done ($fail shard(s) nonzero). rows: $(wc -l < "$OUT/${TASK}.jsonl" 2>/dev/null)"
  python - "$OUT/${TASK}.jsonl" "$TASK" <<'PY'
import json,sys
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
ne=[r for r in rows if (r.get("final_response") or "").strip()]
snip=[r for r in rows if (r.get("additional_output_data") or {}).get("n_surfaced_snippets",0)>0]
print(f"[health:{sys.argv[2]}] rows={len(rows)}/120  finalized={len(ne)}/{len(rows)}  retrieval-alive={len(snip)}/{len(rows)}")
PY
done

echo; echo "[done] gen complete — releasing GPU. Grade off-GPU: sbatch agent/eval_drrlm_shortform_grade.job"
