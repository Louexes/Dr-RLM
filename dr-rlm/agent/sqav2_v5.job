#!/bin/bash
# SLURM job — sqav2 (ScholarQA-CS-v2) cross-benchmark validation, current harness.
# The 3rd in-distribution long-form benchmark (DRB + ResearchQA done; this completes the set).
# Same harness/fixes as the cross-bench run; SQA framing in _TASK_FRAMING. n=8 of sqav2_cs100.
#   Est Serper: ~13 calls/item x 8 ~= 105 credits.
#SBATCH --job-name=sqav2_v5
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sqav2_v5_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sqav2_v5_%j.err
set -euo pipefail

mkdir -p /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs
cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent

export ARMS=structured
export DR_RLM_CAPTURE_LEDGER=1
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export TOKENIZER=Qwen/Qwen3-8B
export BENCH=sqav2
export SQAV2_LOCAL_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/subsets/sqav2_cs100.jsonl
export NUMEX=8
export MAX_DEPTH=1
export SEARCH_BACKEND=web
export MAX_TOOL_CALLS=200
export MAX_CHILDREN=6
export MCP_PORT=8033
export GRADE=1
export SAVE_TRAJ=1
export OUT=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/crossbench_v5/sqav2

echo "[job ${SLURM_JOB_ID:-local}] $(hostname) sqav2 (ScholarQA-CS-v2) n=8, current harness"
exec ./ab_child_return.sh
