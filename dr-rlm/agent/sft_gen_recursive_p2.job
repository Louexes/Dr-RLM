#!/bin/bash
# ============================================================================
# SFT STEP 1 PASS 2 (recursive arm) — supplementary sampling over the 140 prompts
# that did not yield a kept+cited root in pass 1 (filters unchanged, n_samples 2->3).
# Qwen3.6-27B (TP=2, thinking-ON, 131k ctx) drives OUR recursive REPL harness over the
# frozen bm25s corpus on the 200 frozen manifest prompts; local Qwen3.5-4B judge
# (thinking-OFF, alias gpt-4.1-mini) scores rubric coverage for rejection sampling.
# Stages: [0] serve teacher+judge  [1] GATE: serialization smoke (2 prompts)
#         [2] rubric drafting (200 prompts, DR-Tulu F.2-style, local)
#         [3] 8-shard gen_recursive_sft (n_samples=2, threshold=0.6, root+child rows)
#         [4] merge + filter (cite/recursion/<=32k-tok student-tokenizer, DROP not truncate)
# Output: data/sft/dr_rlm_recursive_sft.jsonl (LLaMA-Factory sharegpt, span-mask tags baked)
# ============================================================================
#SBATCH --job-name=sft_gen_rec2
#SBATCH --partition=gpu_h100
#SBATCH --gpus=3
#SBATCH --cpus-per-task=48
#SBATCH --time=06:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_genrec2_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_genrec2_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
SKYPY=$DRRLM/rl/skyrl/.venv/bin/python
TEACHER_DIR=/scratch-shared/lgehringer/models/Qwen3.6-27B
TEACHER=Qwen/Qwen3.6-27B; TPORT=8006
JUDGE=gpt-4.1-mini-2025-04-14; JPORT=8100
FROZEN=$DRRLM/data/frozen_corpus; OUT=$DRRLM/runs/sft_gen_rec2ursive; SFTD=$DRRLM/data/sft
SHARDS=8; JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$SFTD" "$DRRLM/runs/logs"
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY JUDGE_API_KEY=EMPTY
export VLLM_USE_DEEP_GEMM=0 HF_HUB_OFFLINE=1 DR_RLM_CAPTURE_LEDGER=1
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt

PIDS=(); cleanup(){ for p in "${PIDS[@]}"; do kill "$p" 2>/dev/null || true; done; }; trap cleanup EXIT
wait_ready(){ # $1=port $2=tag $3=pid
  for s in $(seq 1 240); do
    curl -sf "http://localhost:$1/v1/models" >/dev/null 2>&1 && { echo "[serve:$2] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$3" 2>/dev/null || { echo "[FATAL] vllm($2) died"; exit 1; }
  done; echo "[FATAL] vllm($2) never ready"; exit 1
}

# --- STAGE 0: serve teacher (GPUs 0,1) + judge (GPU 2) ---
CUDA_VISIBLE_DEVICES=0,1 vllm serve "$TEACHER_DIR" --host 0.0.0.0 --port $TPORT \
  --tensor-parallel-size 2 --gpu-memory-utilization 0.90 --max-model-len 131072 \
  --max-num-seqs 32 --default-chat-template-kwargs '{"enable_thinking": true}' \
  --served-model-name "$TEACHER" > "$DRRLM/runs/logs/sft_genrec_vllm_teacher_${JOBID}.log" 2>&1 &
PIDS+=($!); TPID=$!
CUDA_VISIBLE_DEVICES=2 vllm serve Qwen/Qwen3.5-4B --host 0.0.0.0 --port $JPORT \
  --tensor-parallel-size 1 --gpu-memory-utilization 0.90 --max-model-len 32768 \
  --max-num-seqs 32 --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$JUDGE" > "$DRRLM/runs/logs/sft_genrec_vllm_judge_${JOBID}.log" 2>&1 &
PIDS+=($!); JPID=$!
wait_ready $TPORT teacher $TPID; wait_ready $JPORT judge $JPID

GENCOMMON="--model $TEACHER --base_url http://localhost:$TPORT/v1 \
  --n_samples 3 --max_depth 2 --max_iterations 10 --max_concurrent_subcalls 4 --temperature 0.7 \
  --judge_model $JUDGE --judge_base_url http://localhost:$JPORT/v1 --judge_api_key_env JUDGE_API_KEY \
  --search_backend bm25s --search_corpus_path $FROZEN/corpus.jsonl --search_index_path $FROZEN/bm25s_index"

# (pass 2: smoke + rubric stages skipped — pipeline validated, rubrics reused)
cd "$DRRLM/rl/skyrl"

# --- STAGE 3: 8-shard generation with inline rejection sampling ---
python - "$DRRLM/data/sft/sft_prompts_rubrics_pass2.jsonl" "$OUT" $SHARDS <<'PY'
import json, sys
rows = [l for l in open(sys.argv[1]) if l.strip()]
n = int(sys.argv[3])
for i in range(n):
    with open(f"{sys.argv[2]}/shard_in_{i}.jsonl", "w") as f:
        f.writelines(rows[i::n])
print(f"split {len(rows)} rows into {n} shards")
PY
pids=()
for i in $(seq 0 $((SHARDS-1))); do
  env -u VIRTUAL_ENV $SKYPY examples/train/dr_rlm/sft/gen_recursive_sft.py \
    --prompts "$OUT/shard_in_${i}.jsonl" --out_jsonl "$OUT/shard_out_${i}.jsonl" \
    --threshold 0.6 $GENCOMMON > "$OUT/shard_${i}.log" 2>&1 < /dev/null &
  pids+=($!)
done
echo "[gen] launched $SHARDS shard processes ..."
fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
cat "$DRRLM/runs/sft_gen_recursive/merged.jsonl" "$OUT"/shard_out_*.jsonl > "$OUT/merged.jsonl" 2>/dev/null || true
echo "[gen] done ($fail shard(s) nonzero). merged rows: $(wc -l < "$OUT/merged.jsonl")"

# --- STAGE 4: filter (cite / recursion / <=32k student tokens, DROP not truncate) ---
python "$DRRLM/scripts/filter_sft_rows.py" --in "$OUT/merged.jsonl" \
  --out "$SFTD/dr_rlm_recursive_sft.jsonl" --tokenizer Qwen/Qwen3.5-4B --max_tokens 32768
echo "[step1-recursive pass2, union of both passes] complete -> $SFTD/dr_rlm_recursive_sft.jsonl"
