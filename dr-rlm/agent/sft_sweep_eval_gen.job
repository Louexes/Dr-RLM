#!/bin/bash
# ============================================================================
# SFT recipe-sweep EVAL (gen-only) — grafts + serves + DRB-24 gens epochs 2/3/4 of ONE config.
# One gen pass per checkpoint serves BOTH gates: behavioral (finalization/recursion/orphan, from
# the gen jsonl) + DRB RACE discriminator (graded off-GPU by agent/sft_sweep_grade.job on staging).
# Locked eval config IDENTICAL to eval_drrlm_sft2ep_drb_gen.job (thinkon, depth1/turns10/8192/
# children10/structured, bm25s frozen corpus, DR-Tulu sampling, STRICT, capture ledger).
#
# Env in:  CONFIG=<A_moredata|B_lowlr|C_wd>  STEPS="s2 s3 s4"  (epoch 2/3/4 global_steps)
# Submit:  sbatch --dependency=afterok:<sftjob> --export=ALL,CONFIG=...,STEPS="..." this.job
# ============================================================================
#SBATCH --job-name=sftsw_eval
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=160G
#SBATCH --time=03:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sftsw_eval_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sftsw_eval_%j.err
set -euo pipefail

: "${CONFIG:?set CONFIG}"; : "${STEPS:?set STEPS (epoch 2/3/4 global_steps)}"
REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
CKROOT=/scratch-shared/lgehringer/ckpts/sft_recipe_sweep
BASE_SNAP=/scratch-shared/lgehringer/hf_cache/hub/models--Qwen--Qwen3.5-4B/snapshots/851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
FROZEN=$DRRLM/data/frozen_corpus; TASK=deep_research_bench; N=24; SHARDS=6; PORT=8021
JOBID=${SLURM_JOB_ID:-local}
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY HF_HOME=/scratch-shared/lgehringer/hf_cache HF_HUB_OFFLINE=1
export DRB_LOCAL_PATH=$DRRLM/data/subsets/drb_en24.jsonl
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt
export DR_RLM_CAPTURE_LEDGER=1

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){  # $1=model $2=served_name $3=tag
  local model="$1" name="$2" tag="$3"
  local log="$DRRLM/runs/logs/sftsw_${CONFIG}_vllm_${tag}_${JOBID}.log"
  echo "[serve:$tag] vllm $model -> $log"
  vllm serve "$model" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
    --default-chat-template-kwargs '{"enable_thinking": true}' \
    --served-model-name "$name" > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 300); do
    curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve:$tag] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm($tag) died"; tail -40 "$log"; exit 1; }
  done; echo "[FATAL] vllm($tag) never ready"; exit 1
}
swap_kill(){ kill "$CUR_PID" 2>/dev/null || true; CUR_PID=""
  for s in $(seq 1 24); do curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && sleep 5 || break; done; }

for STEP in $STEPS; do
  TEXT=$CKROOT/$CONFIG/hf/global_step_$STEP/policy
  SERVED=$CKROOT/$CONFIG/hf/global_step_$STEP/served
  OUT=$DRRLM/runs/sft_sweep/$CONFIG/e$STEP
  NAME=sweep_${CONFIG}_e${STEP}
  mkdir -p "$OUT"
  echo; echo "################## $CONFIG step=$STEP ##################"
  if [ ! -f "$TEXT/config.json" ]; then echo "[SKIP] missing $TEXT (checkpoint not saved)"; continue; fi
  if [ ! -f "$SERVED/config.json" ]; then
    echo "[graft] $TEXT -> $SERVED"
    python "$DRRLM/scripts/graft_text_into_multimodal.py" --base "$BASE_SNAP" --text "$TEXT" --out "$SERVED"
    [ -f "$SERVED/config.json" ] || { echo "[FATAL] graft failed $CONFIG/$STEP"; exit 1; }
  fi
  serve "$SERVED" "$NAME" "e$STEP"
  rm -f "$OUT"/shard_${TASK}_*.jsonl "$OUT/${TASK}.jsonl"
  GEN=$DRRLM/agent/generate.py; cd "$AGENT"
  COMMON="--driver new --benchmark $TASK --model $NAME --tokenizer-path Qwen/Qwen3.5-4B \
    --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
    --max-recursion-depth 1 --max-iterations 10 --max-completion-tokens 8192 \
    --max-tool-calls 80 --max-children 10 --child-return-mode structured \
    --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
    --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
    --abort-after-dead-items 1000 --num-examples $N"
  pids=()
  for i in $(seq 0 $((SHARDS-1))); do
    python "$GEN" $COMMON --num-shards "$SHARDS" --shard "$i" \
      --output "$OUT/shard_${TASK}_${i}.jsonl" --save-trajectories "$OUT/traj_${TASK}_${i}" \
      > "$OUT/shard_${TASK}_${i}.log" 2>&1 < /dev/null &
    pids+=($!)
  done
  fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
  cat "$OUT"/shard_${TASK}_*.jsonl > "$OUT/${TASK}.jsonl" 2>/dev/null || true
  echo "[gen] $CONFIG/e$STEP rows=$(wc -l < "$OUT/${TASK}.jsonl" 2>/dev/null) ($fail shard fails)"
  # behavioral gate summary (finalization / recursion presence / orphan) — from gen jsonl, no GPU
  cd "$DRRLM"
  python analysis/behavioral_metrics.py --run "${CONFIG}_e${STEP}:$OUT/${TASK}.jsonl" 2>&1 | tail -18 \
    | tee "$OUT/behavioral.txt" || echo "[warn] behavioral_metrics failed for $CONFIG/e$STEP"
  swap_kill
done
echo "[done] $CONFIG gens in $DRRLM/runs/sft_sweep/$CONFIG/ — grade off-GPU via agent/sft_sweep_grade.job"
