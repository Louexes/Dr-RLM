#!/bin/bash
# SLURM job — OFFLINE A/B: pre-submit citation VERIFICATION on vs off (DRB n=16).
# First experiment on the snapshot-corpus iteration loop (zero Serper/Jina; Gemini only).
# Hypothesis: batch-judging each (claim, snippet) pair at finalize and dropping explicit
# UNSUPPORTED ones raises FACT valid_rate (was 0.345 hard / 0.72 mixed) WITHOUT losing
# valid citations (avg_valid_citations must hold) or RACE. Same corpus both arms ->
# reproducible evidence, low-variance comparison.
#SBATCH --job-name=offline_ab_citeverify
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_ab_citeverify_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_ab_citeverify_%j.err
set -euo pipefail

cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent
BASE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/offline_ab_citeverify

COMMON_ENV() {
  export ARMS=structured
  export DR_RLM_CAPTURE_LEDGER=1
  export MODEL=gemini-2.5-flash
  export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
  export MODEL_API_KEY_ENV=GEMINI_API_KEY
  export TOKENIZER=Qwen/Qwen3-8B
  export BENCH=deep_research_bench
  export NUMEX=16
  export MAX_DEPTH=1
  export SEARCH_BACKEND=local_jsonl
  export SEARCH_CORPUS_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/offline_corpus/drb.jsonl
  export MAX_TOOL_CALLS=200
  export MAX_CHILDREN=6
  export GRADE=1
  export SAVE_TRAJ=1
}

COMMON_ENV; export CITATION_VERIFY=0 OUT=$BASE/control
echo "[ab] arm CONTROL (verification off) ..."; ./ab_child_return.sh || echo "[warn] control failed"

COMMON_ENV; export CITATION_VERIFY=1 OUT=$BASE/verify
echo "[ab] arm VERIFY (verification on) ..."; ./ab_child_return.sh || echo "[warn] verify failed"

echo "[offline_ab_citeverify] done -> $BASE"
