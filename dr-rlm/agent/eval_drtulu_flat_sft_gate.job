#!/bin/bash
# ============================================================================
# DR-Tulu FLAT SFT — GATE EVAL (SFT_PLAN Step 3).
# Mirror of eval_drtulu_thinkon_full.job (which set the untrained anchor cov 0.268),
# with TWO changes only: (1) generation serves the GRAFTED flat SFT ckpt (thinking-ON,
# matching the thinking-ON SFT data); (2) the judge stays BASE Qwen3.5-4B thinking-OFF
# (feedback-judge-always-thinking-off). Byte-identical harness/corpus/judge/items to the
# untrained baseline otherwise — only the gen model differs -> clean before/after.
#
# GATE (SFT_PLAN Step 3): DR-Tulu SFT coverage >= its untrained baseline (0.268).
#
# Graft is done inline (guarded): SkyRL text-only export isn't vLLM-servable
# (Qwen3_5ForCausalLM); graft text weights onto the base multimodal shell -> served.
# ============================================================================
#SBATCH --job-name=drtulu_flat_sft_gate
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=01:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_flat_sft_gate_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drtulu_flat_sft_gate_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
BASE=Qwen/Qwen3.5-4B
BASE_SNAP=/scratch-shared/lgehringer/hf_cache/hub/models--Qwen--Qwen3.5-4B/snapshots/851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
CKPT=${CKPT:-/scratch-shared/lgehringer/ckpts/dr_tulu_flat_sft}
TEXT=${TEXT:-$CKPT/hf/global_step_26/policy}
SERVED=${SERVED:-$CKPT/served}
GEN_NAME=${GEN_NAME:-drtulu_flat_sft}   # served-model-name for the gen endpoint
PORT=8004; GRADER_ALIAS=gpt-4.1-mini-2025-04-14
FROZEN=$DRRLM/data/frozen_corpus; OUT=${OUT:-$DRRLM/runs/drtulu_flat_sft_gate}; TASK=researchqa
N=120
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY
export HF_HOME=/scratch-shared/lgehringer/hf_cache
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl

# ---- GRAFT (guarded: skip if already built) ----
if ls "$SERVED"/*.safetensors >/dev/null 2>&1; then
  echo "[graft] already present -> $SERVED (skip)"
else
  echo "[graft] $TEXT -> $SERVED (base shell $BASE_SNAP)"
  python "$DRRLM/scripts/graft_text_into_multimodal.py" --base "$BASE_SNAP" --text "$TEXT" --out "$SERVED"
fi

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){  # $1=model_path  $2=enable_thinking  $3=tag  $4=served-model-name ($5..=extra aliases)
  local model="$1" think="$2" tag="$3" name="$4"; shift 4
  local log="$DRRLM/runs/logs/drtulu_flat_sft_gate_vllm_${tag}_${SLURM_JOB_ID:-local}.log"
  echo "[serve:$tag] vllm $model enable_thinking=$think -> $log"
  vllm serve "$model" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.85 --max-model-len 32768 --enforce-eager \
    --default-chat-template-kwargs "{\"enable_thinking\": $think}" \
    --served-model-name "$name" "$@" > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 200); do
    curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve:$tag] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm($tag) died"; tail -40 "$log"; exit 1; }
  done; echo "[FATAL] vllm($tag) never ready"; exit 1
}

# ---- PHASE 1: generation, SFT ckpt, THINKING ON ----
serve "$SERVED" true gen "$GEN_NAME"
OV="search_tool_name=bm25s,browse_tool_name=bm25s"
OV="$OV,bm25s_index_path=$FROZEN/bm25s_index,bm25s_corpus_path=$FROZEN/corpus.jsonl"
OV="$OV,search_agent_base_url=http://localhost:$PORT/v1"
OV="$OV,search_agent_model_name=$GEN_NAME,search_agent_tokenizer_name=$BASE"
OV="$OV,search_agent_temperature=1.0,search_agent_max_tokens=8192"
OV="$OV,search_agent_max_tool_calls=12,number_documents_to_search=10"
OV="$OV,tool_calling_mode=parser,use_browse_agent=false"
cd "$AGENT"; rm -f "$OUT/${TASK}.jsonl"
echo "[gen] DR-Tulu flat SFT ReAct THINKING-ON $TASK N=$N ..."
python "workflows/auto_search_sft.py" generate-dataset "$TASK" \
  --num-examples "$N" --max-concurrent 8 --batch-size 8 --use-cache \
  --config "workflows/auto_search_sft.yaml" --config-overrides "$OV" \
  --output "$OUT/${TASK}.jsonl" < /dev/null

echo; echo "=== DID SEARCHES EXECUTE? (real tool_call_count + retrieved corpus hits) ==="
python - "$OUT/${TASK}.jsonl" <<'PY'
import json,sys,re
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
def walk(o):
    if isinstance(o,dict):
        for k,v in o.items(): yield ('k',k,v); yield from walk(v)
    elif isinstance(o,list):
        for v in o: yield from walk(v)
    elif isinstance(o,str): yield ('s',None,o)
items_searched=tot_exec=tot_hits=ne=0; cite_real=0; cite_all=0
for r in rows:
    ft=r.get("full_traces") or {}; ex=hits=0
    for kind,k,v in walk(ft):
        if kind=='k' and k=='tool_call_count' and isinstance(v,int): ex+=v
        if kind=='k' and k=='hits' and isinstance(v,list): hits+=len(v)
    if ex>0: items_searched+=1
    tot_exec+=ex; tot_hits+=hits
    fr=r.get("final_response") or ""
    if fr.strip(): ne+=1
    cs=re.findall(r'<cite id="?([^">]+)"?>',fr); cite_all+=len(cs)
    cite_real+=sum(1 for c in cs if re.match(r'^[0-9a-f]{6,}-\d+$',c))
print(f"items={len(rows)} non-empty={ne} ({100*ne//max(1,len(rows))}%)")
print(f"items-that-executed-a-search={items_searched}/{len(rows)}  total executed searches={tot_exec}  total retrieved hits={tot_hits}")
print(f"citations: {cite_all} total, {cite_real} grounded (surfaced snippet ids)")
PY

# ---- PHASE 2: grading, BASE Qwen thinking-OFF judge ----
echo; echo "[swap] killing gen serve, starting BASE thinking-OFF judge ..."
kill "$CUR_PID" 2>/dev/null || true; CUR_PID=""
for s in $(seq 1 24); do curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && sleep 5 || break; done
serve "$BASE" false judge "$BASE" "$GRADER_ALIAS"
echo "=== GRADE (researchqa coverage, thinking-OFF judge) ==="
OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
  python scripts/evaluate.py "$TASK" "$OUT/${TASK}.jsonl" 2>&1 | grep -viE "Coverage for|Expected 8|Questions:|Authlib|joserfc|Computing rubric" | tail -10
python - "$OUT/researchqa_eval_results.json" <<'PY'
import json,sys,os
f=sys.argv[1]
if os.path.exists(f):
    d=json.load(open(f)); cov=d.get("score") or d.get("metrics",{}).get("coverage")
    print(f"DR-Tulu FLAT SFT (thinking-ON) AGGREGATE coverage: {cov} | n={d.get('num_examples')}")
    if cov is not None:
        print(f"GATE (>= untrained 0.268): {'PASS' if cov >= 0.268 else 'FAIL'}  (Δ {cov-0.268:+.3f})")
PY
echo "[done] reports: $OUT/${TASK}.jsonl"
