#!/bin/bash
# ============================================================================
# Resolve the greedy-vs-rollout-temp question: does GREEDY (temp 0.0) make the UNTRAINED
# model degenerate (bare search() loop -> empty) vs the rollout temp (1.0) where RL saw it
# produce output? Same 12 ResearchQA items, identical config, ONLY temperature varies.
# Reports non-empty rate per temp -> tells us the right eval sampling for the baseline.
# ============================================================================
#SBATCH --job-name=temp_sweep
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=00:40:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/temp_sweep_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/temp_sweep_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
DRRLM=$REPO/dr-rlm
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B
PORT=8000
FROZEN=$DRRLM/data/frozen_corpus
OUT=$DRRLM/runs/temp_sweep
N=12
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false
export OPENAI_API_KEY=EMPTY
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt.txt

VLLM_LOG="$DRRLM/runs/logs/temp_sweep_vllm_${SLURM_JOB_ID:-local}.log"
echo "[serve] vllm serve $MODEL (thinking off, eager) -> $VLLM_LOG"
vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.85 --max-model-len 32768 --enforce-eager \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$MODEL" > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'kill $VLLM_PID 2>/dev/null || true' EXIT
for s in $(seq 1 180); do
  curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; break; }
  sleep 5; kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$VLLM_LOG"; exit 1; }
done

AGENT=$REPO/dr-tulu/agent; GEN=$DRRLM/agent/generate.py
cd "$AGENT"
for T in 0.0 0.7 1.0; do
  echo "[gen] researchqa N=$N temperature=$T (flat depth=0) ..."
  python "$GEN" \
    --driver new --benchmark researchqa --model "$MODEL" --tokenizer-path "$MODEL" \
    --base-url "http://localhost:$PORT/v1" --api-key-env OPENAI_API_KEY \
    --max-iterations 6 --max-completion-tokens 1024 --temperature "$T" \
    --max-tool-calls 80 --max-children 4 --child-return-mode structured \
    --search-backend bm25s \
    --search-corpus-path "$FROZEN/corpus.jsonl" --search-index-path "$FROZEN/bm25s_index" \
    --max-recursion-depth 0 --abort-after-dead-items 1000 --num-examples "$N" \
    --output "$OUT/rqa_t${T}.jsonl" < /dev/null || echo "[warn] temp $T gen failed"
done

echo; echo "=== NON-EMPTY RATE BY TEMPERATURE (the answer) ==="
python - <<'PY'
import json, os
OUT=os.environ["DRRLM"]+"/runs/temp_sweep" if "DRRLM" in os.environ else "/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/temp_sweep"
for T in ["0.0","0.7","1.0"]:
    f=f"{OUT}/rqa_t{T}.jsonl"
    if not os.path.exists(f): print(f"temp {T}: NO FILE"); continue
    rows=[json.loads(l) for l in open(f,encoding='utf-8').read().split("\n") if l.strip()]
    ne=sum(1 for r in rows if (r.get('final_response') or '').strip())
    lens=[len(r.get('final_response') or '') for r in rows]
    print(f"temp {T}: non-empty {ne}/{len(rows)} ({100*ne//max(1,len(rows))}%)  | report lens: {sorted(lens, reverse=True)}")
PY
echo "[done]"
