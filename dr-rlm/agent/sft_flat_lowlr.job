#!/bin/bash
# ============================================================================
# DR-Tulu FLAT SFT — EPOCH SWEEP (1ep + 2ep snapshots from ONE deterministic run).
# Same recipe as sft_train_drtulu_flat_skyrl.job (seed 42, identical config) but with
# hf_save_interval=13 -> HF exports at step 13 (=1 epoch) AND step 26 (=2 epochs).
# Purpose: apply the recursive arm's OWN selection rule to the flat arm (its 2ep was
# itself a sweep output, not a fixed target): pick the least-over-fit epoch that installs
# the protocol AND beats the untrained baseline (gate) with entropy preserved (RL guard).
# The 2ep snapshot here == the already-scored dr_tulu_flat_sft/global_step_26 (same seed),
# so only the 1ep needs a fresh gate eval.
# ============================================================================
#SBATCH --job-name=sft_flat_lowlr
#SBATCH --partition=gpu_h100
#SBATCH --gpus=2
#SBATCH --cpus-per-task=32
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_sweep_drtulu_flat_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_sweep_drtulu_flat_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
SKYRL=$REPO/rl/skyrl
DATA=$REPO/data/sft/primary/dr_tulu_flat_primary_multiturn.jsonl
CKPT=/scratch-shared/lgehringer/ckpts/dr_tulu_flat_sft_lowlr
mkdir -p "$CKPT" "$REPO/runs/logs"

export HF_HOME=/scratch-shared/lgehringer/hf_cache HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export UV_CACHE_DIR=/scratch-shared/lgehringer/uv_cache

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2024 2>/dev/null || true; module load CUDA/12.6.0 2>/dev/null || true
export CUDA_HOME=${CUDA_HOME:-${EBROOTCUDA:-}}

export WANDB_API_KEY=$(python3 -c "import netrc;print(netrc.netrc().authenticators('api.wandb.ai')[2])")

[ -s "$DATA" ] || { echo "[FATAL] SFT data missing: $DATA"; exit 1; }
echo "[sft] DR-Tulu flat SWEEP: $(wc -l < "$DATA") rows -> per-epoch snapshots 13/26/39/52 (ep1-4), lr2e-5"

cd "$SKYRL"
env -u VIRTUAL_ENV ./.venv/bin/python -m skyrl.train.main_sft \
    strategy=fsdp2 \
    model.path=Qwen/Qwen3.5-4B \
    language_model_only=true \
    dataset_name="$DATA" \
    messages_key=conversations \
    train_on_what=all_assistant_messages \
    max_length=32768 \
    num_steps=52 \
    batch_size=8 \
    micro_train_batch_size_per_gpu=1 \
    use_sample_packing=false \
    optimizer_config.lr=2e-5 \
    optimizer_config.scheduler=cosine \
    optimizer_config.num_warmup_steps=3 \
    optimizer_config.weight_decay=0.0 \
    optimizer_config.max_grad_norm=1.0 \
    placement.num_nodes=1 \
    placement.num_gpus_per_node=2 \
    fsdp_config.cpu_offload=false \
    fsdp_config.reshard_after_forward=true \
    seed=42 \
    logger="['console','wandb']" \
    project_name=dr-rlm-sft \
    run_name=drtulu_flat_lowlr \
    ckpt_path="$CKPT" \
    hf_save_interval=13 \
    export_path="$CKPT/hf" \
    "$@"

echo "[sft] done -> HF snapshots under $CKPT/hf/ (global_step_13/26/39/52)"
