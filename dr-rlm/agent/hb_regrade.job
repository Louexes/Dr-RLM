#!/bin/bash
# SLURM job — re-grade the existing HealthBench 7/8 rows (NO generation, NO Serper).
# Two login-node grading attempts died silently (login nodes reap long processes — the HB
# rubric grader makes hundreds of Gemini judge calls). Grading belongs on a compute node.
#SBATCH --job-name=hb_regrade
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/hb_regrade_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/hb_regrade_%j.err
set -euo pipefail

DRRLM=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm
HB=$DRRLM/runs/crossbench_v5/healthbench/structured
source /gpfs/home5/lgehringer/venvs/rlm_vllm311_headers/bin/activate
source "$DRRLM/keys.sh"
# ROOT CAUSE of every prior grading stall: HealthBench's grader (ChatCompletionSampler) builds
# a PLAIN `OpenAI()` client -> api.openai.com, but we pass --grader-model gemini-2.5-flash,
# which OpenAI doesn't serve -> DETERMINISTIC 404 model_not_found retried forever (it was never
# a transient Gemini outage). The openai client honors these envs — route it to Gemini's
# OpenAI-compatible endpoint so the gemini judge actually resolves:
export OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export OPENAI_API_KEY="$GEMINI_API_KEY"
cd /gpfs/home5/lgehringer/Dr-RLM/dr-tulu/agent

rm -rf "$HB/hb_eval"
echo "[hb_regrade] grading $(wc -l < "$HB/healthbench.jsonl") rows ..."
python scripts/evaluate.py healthbench "$HB/healthbench.jsonl" \
  --save_path "$HB/hb_eval" --grader-model gemini-2.5-flash 2>&1 | tee "$HB/healthbench_score.txt"
echo "[hb_regrade] done"
