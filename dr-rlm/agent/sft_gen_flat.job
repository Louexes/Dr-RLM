#!/bin/bash
# ============================================================================
# SFT STEP 1 (flat arm) — teacher data generation (SFT_PLAN_2026-07-03.md, D2 symmetry).
# SAME teacher (Qwen3.6-27B), SAME 200 frozen manifest prompts, SAME rubrics + judge +
# filters as the recursive arm — but through DR-Tulu's OWN ReAct harness
# (auto_search_sft.py generate-dataset) with the bm25s frozen-corpus bridge, thinking-ON.
# Output format = dr-tulu's SFT convention ([system, user, assistant-fulltrace]) for
# their LLaMA-Factory fork with mask_span_types="tool_output".
# Submit with --dependency=afterok:<recursive job> (needs its stage-2 rubrics file).
# ============================================================================
#SBATCH --job-name=sft_gen_flat
#SBATCH --partition=gpu_h100
#SBATCH --gpus=3
#SBATCH --cpus-per-task=48
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_genflat_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_genflat_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
TEACHER_DIR=/scratch-shared/lgehringer/models/Qwen3.6-27B
TEACHER=Qwen/Qwen3.6-27B; TPORT=8006
JUDGE=gpt-4.1-mini-2025-04-14; JPORT=8100
FROZEN=$DRRLM/data/frozen_corpus; OUT=$DRRLM/runs/sft_gen_flat; SFTD=$DRRLM/data/sft
RUBRICS=$SFTD/sft_prompts_rubrics.jsonl
# FAITHFUL (2026-07-04): use DR-Tulu's OWN stock long_form instruction — the exact string
# their loaders/routing append to OpenScholar/SearchArena long-form SFT prompts — read
# VERBATIM from their YAML at runtime (no hand-copy / drift). Earlier custom framings
# under-searched (median 1 tool call, 142-word answers) because they didn't demand
# grounded multi-section reports the way the stock instruction does.
FRAMING=$(python - <<'PY'
import yaml, glob
f = glob.glob('/gpfs/home5/lgehringer/Dr-RLM/dr-tulu/agent/**/unified_tool_calling_v20250907.yaml', recursive=True)[0]
print(yaml.safe_load(open(f))['additional_instructions']['long_form'], end='')
PY
)
JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY JUDGE_API_KEY=EMPTY
export VLLM_USE_DEEP_GEMM=0 HF_HUB_OFFLINE=1

[ -s "$RUBRICS" ] || { echo "[FATAL] rubrics file missing: $RUBRICS (recursive-arm stage 2 must run first)"; exit 1; }

# --- flat SFT input: manifest prompts in researchqa local schema (id = manifest qid).
# SFT_FLAT_INPUT env overrides with a pre-built file (e.g. uncovered-prompts top-up). ---
if [ -n "${SFT_FLAT_INPUT:-}" ]; then
  export RESEARCHQA_LOCAL_PATH=$SFT_FLAT_INPUT
  echo "[input] using override: $SFT_FLAT_INPUT ($(wc -l < "$SFT_FLAT_INPUT") rows)"
else
  python - "$DRRLM/data/subsets/sft_prompts_manifest.json" "$OUT/sft_prompts_researchqa_fmt.jsonl" <<'PY'
import json, sys
m = json.load(open(sys.argv[1]))
with open(sys.argv[2], "w") as f:
    for e in m["entries"]:
        f.write(json.dumps({"id": e["qid"], "query": e["question"]}, ensure_ascii=False) + "\n")
print(f"wrote {len(m['entries'])} flat-arm input rows")
PY
  export RESEARCHQA_LOCAL_PATH=$OUT/sft_prompts_researchqa_fmt.jsonl
fi
# Build with python: FRAMING contains embedded double quotes; naive shell interpolation
# produced INVALID JSON in attempt-3 and the workflow SILENTLY fell back to the loader's
# default 240-260-word ResearchQA instruction (json.loads in a bare try/except).
export DR_TULU_FRAMING_JSON=$(FR="$FRAMING" python -c "import json,os; print(json.dumps({'researchqa': os.environ['FR']}))")
python - <<'PY'
import json, os
assert json.loads(os.environ["DR_TULU_FRAMING_JSON"])["researchqa"], "framing JSON broken"
print("[framing] JSON valid, v2 framing armed")
PY

PIDS=(); cleanup(){ for p in "${PIDS[@]}"; do kill "$p" 2>/dev/null || true; done; }; trap cleanup EXIT
wait_ready(){ for s in $(seq 1 240); do
    curl -sf "http://localhost:$1/v1/models" >/dev/null 2>&1 && { echo "[serve:$2] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$3" 2>/dev/null || { echo "[FATAL] vllm($2) died"; exit 1; }
  done; echo "[FATAL] vllm($2) never ready"; exit 1; }

CUDA_VISIBLE_DEVICES=0,1 vllm serve "$TEACHER_DIR" --host 0.0.0.0 --port $TPORT \
  --tensor-parallel-size 2 --gpu-memory-utilization 0.90 --max-model-len 131072 \
  --max-num-seqs 32 --default-chat-template-kwargs '{"enable_thinking": true}' \
  --served-model-name "$TEACHER" > "$DRRLM/runs/logs/sft_genflat_vllm_teacher_${JOBID}.log" 2>&1 &
PIDS+=($!); TPID=$!
CUDA_VISIBLE_DEVICES=2 vllm serve Qwen/Qwen3.5-4B --host 0.0.0.0 --port $JPORT \
  --tensor-parallel-size 1 --gpu-memory-utilization 0.90 --max-model-len 32768 \
  --max-num-seqs 32 --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$JUDGE" > "$DRRLM/runs/logs/sft_genflat_vllm_judge_${JOBID}.log" 2>&1 &
PIDS+=($!); JPID=$!
wait_ready $TPORT teacher $TPID; wait_ready $JPORT judge $JPID

# --- generation: dr-tulu ReAct harness, config mirrors the flat eval jobs ---
OV="search_tool_name=bm25s,browse_tool_name=bm25s"
OV="$OV,bm25s_index_path=$FROZEN/bm25s_index,bm25s_corpus_path=$FROZEN/corpus.jsonl"
OV="$OV,search_agent_base_url=http://localhost:$TPORT/v1"
OV="$OV,search_agent_model_name=$TEACHER,search_agent_tokenizer_name=$TEACHER_DIR"
# FAITHFUL stock hyperparameters (auto_search_sft.yaml + auto_search.sh): temp 1.0,
# max_tokens 32000, max_tool_calls 10, 10 docs. use_browse_agent=false is the corpus
# substitution (stock uses jina live-web browse; we're on the frozen bm25s corpus).
OV="$OV,search_agent_temperature=${GEN_TEMP:-1.0},search_agent_max_tokens=32000"
OV="$OV,search_agent_max_tool_calls=10,number_documents_to_search=10"
OV="$OV,tool_calling_mode=parser,use_browse_agent=false"
cd "$AGENT"
# Independent sampling passes (the batch path's "cache" is only output-file resume, so
# distinct output files = fresh temp-1.0 samples). FAITHFUL rerun starts a clean pass
# series (p10+) — all prior passes used non-stock framing/hyperparams and are discarded.
PASSES=${PASSES:-"10 11 12"}
for p in $PASSES; do
  rm -f "$OUT/researchqa_p${p}.jsonl"
  echo "[gen] flat teacher gen pass $p: 200 prompts through DR-Tulu ReAct ..."
  python "workflows/auto_search_sft.py" generate-dataset researchqa \
    --num-examples 200 --max-concurrent 8 --batch-size 8 --use-cache \
    --config "workflows/auto_search_sft.yaml" --config-overrides "$OV" \
    --output "$OUT/researchqa_p${p}.jsonl" < /dev/null
  echo "[gen] pass $p done. rows: $(wc -l < "$OUT/researchqa_p${p}.jsonl")"
done
rm -f "$OUT/researchqa.jsonl"
for p in $PASSES; do cat "$OUT/researchqa_p${p}.jsonl" >> "$OUT/researchqa.jsonl"; done

# --- convert + filter (same judge, rubrics, threshold, length rule as recursive arm) ---
python "$DRRLM/scripts/flat_traces_to_sft.py" --in "$OUT/researchqa.jsonl" \
  --out "$SFTD/dr_tulu_flat_sft_all.jsonl" --rubrics "$RUBRICS" --framing "$FRAMING" \
  --judge_base_url "http://localhost:$JPORT/v1" --judge_model "$JUDGE" \
  --threshold 0.6 --tokenizer Qwen/Qwen3.5-4B --max_tokens 32768
# best-R per prompt (mirrors gen_recursive_sft's keep-best rejection sampling);
# merges with any EXISTING final file so top-up rounds accumulate
python - "$SFTD/dr_tulu_flat_sft_all.jsonl" "$SFTD/dr_tulu_flat_sft.jsonl" <<'PY'
import json, os, sys
best = {}
for path in (sys.argv[2], sys.argv[1]):  # existing final first, then this round
    if os.path.exists(path):
        for l in open(path):
            r = json.loads(l)
            q = r["_qid"]
            if q not in best or r["_R"] > best[q]["_R"]:
                best[q] = r
with open(sys.argv[2], "w") as f:
    for r in best.values():
        f.write(json.dumps(r, ensure_ascii=False) + "\n")
print(f"deduped best-per-prompt (incl. prior rounds): {len(best)} rows")
PY
echo "[step1-flat] complete -> $SFTD/dr_tulu_flat_sft.jsonl"
