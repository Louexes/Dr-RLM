#!/bin/bash
# ============================================================================
# DR-RLM 2ep-SFT eval (gen-only, Gemini grade off-GPU) — HEALTHBENCH (N=120) — THINKING-ON (RLM native).
# Matches the SFT/RL training direction (thinking-ON) so untrained->SFT->RL is
# apples-to-apples. Companion to eval_drrlm_untrained_thinkon.job (ResearchQA).
# Locked config: depth=1, max_turns=10, max_children=10, max_completion=8192,
#   structured, bm25s frozen, DR-Tulu sampling. THINKING-ON: enable_thinking=true
#   + DR_RLM_PROMPT_FILE=system_prompt_thinkon.txt. STRICT (no salvage flags).
# Two serves: thinking-ON gen, then a SEPARATE thinking-OFF LOCAL Qwen judge
#   (judge is ALWAYS thinking-off). Held constant vs untrained DR-Tulu HB: same
#   subset (healthbench_strat120), same local judge. NO Gemini.
# WALL 06:00: HB local-judge rubric grading is SLOW (serial ~16 calls/min); gen
#   is merged+banked BEFORE grading so a grade timeout never loses reports.
# ============================================================================
#SBATCH --job-name=drrlm_sft2ep_hb
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=160G
#SBATCH --time=06:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_sft2ep_hb_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_sft2ep_hb_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=/scratch-shared/lgehringer/ckpts/dr_rlm_sft_CANONICAL_2ep_served; PORT=8011; GRADER_ALIAS=gpt-4.1-mini-2025-04-14; LOGPFX=drrlm_sft2ep_hb
FROZEN=$DRRLM/data/frozen_corpus; OUT=$DRRLM/runs/drrlm_sft2ep_thinkon; TASK=healthbench; N=120; SHARDS=8
JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"
rm -f "$OUT"/shard_${TASK}_*.jsonl "$OUT/${TASK}.jsonl"   # ONLY this task's files (keep researchqa/others)
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY HF_HOME=/scratch-shared/lgehringer/hf_cache HF_HUB_OFFLINE=1
export HEALTHBENCH_LOCAL_PATH=$DRRLM/data/subsets/healthbench_strat120.jsonl
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt
export DR_RLM_CAPTURE_LEDGER=1   # capture evidence ledger (harmless for HB rubric grading; consistent for trained-model evals)

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){  # $1=enable_thinking $2=tag [$3=alias]
  local think="$1" tag="$2" alias="${3:-}"
  local log="$DRRLM/runs/logs/${LOGPFX}_vllm_${tag}_${JOBID}.log"
  echo "[serve:$tag] vllm $MODEL enable_thinking=$think -> $log"
  vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
    --default-chat-template-kwargs "{\"enable_thinking\": $think}" \
    --served-model-name "$MODEL" $alias > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 240); do
    curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve:$tag] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm($tag) died"; tail -40 "$log"; exit 1; }
  done; echo "[FATAL] vllm($tag) never ready"; exit 1
}

# --- PHASE 1: generation, THINKING ON, sharded ---
serve true gen
GEN=$DRRLM/agent/generate.py; cd "$AGENT"
echo "[gen] DR-RLM THINKING-ON depth=1 $TASK N=$N across $SHARDS shards (prompt=$DR_RLM_PROMPT_FILE) ..."
COMMON="--driver new --benchmark $TASK --model $MODEL --tokenizer-path $MODEL \
  --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
  --max-recursion-depth 1 --max-iterations 10 --max-completion-tokens 8192 \
  --max-tool-calls 80 --max-children 10 --child-return-mode structured \
  --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
  --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
  --abort-after-dead-items 1000 --num-examples $N"
pids=()
for i in $(seq 0 $((SHARDS-1))); do
  python "$GEN" $COMMON --num-shards "$SHARDS" --shard "$i" \
    --output "$OUT/shard_${TASK}_${i}.jsonl" --save-trajectories "$OUT/traj_${TASK}_${i}" \
    > "$OUT/shard_${TASK}_${i}.log" 2>&1 < /dev/null &
  pids+=($!)
done
echo "[gen] launched ${#pids[@]} shard processes; waiting ..."
fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
cat "$OUT"/shard_${TASK}_*.jsonl > "$OUT/${TASK}.jsonl" 2>/dev/null || true
echo "[gen] done ($fail shard(s) nonzero). merged rows: $(wc -l < "$OUT/${TASK}.jsonl" 2>/dev/null)"

echo; echo "=== generation health (think + repl) ==="
python - "$OUT/${TASK}.jsonl" <<'PY'
import json,sys
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
ne=sum(1 for r in rows if (r.get("final_response") or "").strip())
cit=sum((r.get("additional_output_data") or {}).get("n_cited_ids",0) for r in rows)
def alltext(o):
    if isinstance(o,dict):
        for v in o.values(): yield from alltext(v)
    elif isinstance(o,list):
        for v in o: yield from alltext(v)
    elif isinstance(o,str): yield o
think=repl=0
for r in rows:
    for t in alltext(r.get("full_traces") or {}): think+=t.count("</think>"); repl+=t.count("```repl")
print(f"rows={len(rows)}  non-empty={ne}  Σcited_ids={cit}  Σ</think>={think}  Σ```repl```={repl}")
PY

# --- GEN-ONLY: bank reports; grade OFF-GPU via Gemini flash (local judge retry-storms; untrained HB was Gemini-graded) ---
echo; echo "[done] HB reports BANKED (NOT graded here — Gemini flash off-GPU): $OUT/${TASK}.jsonl"
echo "       grade later (interactive internet node): source $DRRLM/keys.sh"
echo "       grade HealthBench off-GPU with the Gemini-flash grader."
