#!/bin/bash
# SLURM job — OFFLINE A/B: NEUTRAL task framing + generic self-measurement principle (RQA n=8).
# Task-framing parity fix (fairness audit 2026-06-12): the adopted RQA framing names the REPL
# and leaks grading info ("loses points"), so it cannot be given verbatim to the DR-Tulu
# baseline. This arm splits it fairly: the TASK statement becomes system-agnostic (the
# dr-tulu loader's original requirement, adapted to retrieved snippets — identical text both
# systems), and the MEANS (measure your draft programmatically) moves to the system prompt as
# a generic benchmark-neutral FINISHING principle (prompts/variants/neutral_framing.txt).
# Reference (runs/offline_ab_rqa_length/hardlimit): coverage 0.602, words mean 257 on-target.
# Success = coverage and word compliance hold; then adopt: canonical _TASK_FRAMING entries
# de-RLM-ified + the generic principle into canonical system_prompt.txt (when no jobs queued).
#SBATCH --job-name=offline_ab_rqa_neutral
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_ab_rqa_neutral_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_ab_rqa_neutral_%j.err
set -euo pipefail

cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent
BASE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/offline_ab_rqa_neutral

export ARMS=structured
export DR_RLM_CAPTURE_LEDGER=1
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export TOKENIZER=Qwen/Qwen3-8B
export BENCH=researchqa
export NUMEX=8
export MAX_DEPTH=1
export SEARCH_BACKEND=local_jsonl
export SEARCH_CORPUS_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/offline_corpus/researchqa.jsonl
export MAX_TOOL_CALLS=200
export MAX_CHILDREN=6
export GRADE=1
export SAVE_TRAJ=1
export CITATION_VERIFY=0

# Neutral task statement (system-agnostic; identical text would go to the DR-Tulu baseline):
export DR_RLM_TASK_FRAMING_JSON='{"researchqa": "Answer the question completely and precisely in 240-260 words. Write one to three paragraphs (do not enumerate the facts), and support every statement with an in-line citation to a retrieved snippet."}'
# Generic self-measurement principle (architecture-native means, benchmark-neutral):
export DR_RLM_PROMPT_FILE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/prompts/variants/neutral_framing.txt
export OUT=$BASE/neutral

echo "[ab] arm NEUTRAL-FRAMING (shared task statement + generic REPL principle) ..."
./ab_child_return.sh || echo "[warn] neutral arm failed"
echo "[offline_ab_rqa_neutral] done -> $BASE"
