#!/bin/bash
# ============================================================================
# "AFTER" arm: rerun the ResearchQA N=12 test at Qwen3.5-4B's OFFICIAL non-thinking
# recommended sampling (model card): temp 0.7, top_p 0.8, top_k 20, min_p 0, presence_penalty 1.5.
# Compare non-empty rate vs the GREEDY reference (temp 0.0 -> 0/8 = 0% non-empty, all loops).
# presence_penalty 1.5 is the anti-repetition lever that should break the bare-search() loop.
# ============================================================================
#SBATCH --job-name=rec_sampling
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/rec_sampling_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/rec_sampling_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
DRRLM=$REPO/dr-rlm
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B
PORT=8000
FROZEN=$DRRLM/data/frozen_corpus
OUT=$DRRLM/runs/rec_sampling
N=12
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false
export OPENAI_API_KEY=EMPTY
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt.txt

VLLM_LOG="$DRRLM/runs/logs/rec_sampling_vllm_${SLURM_JOB_ID:-local}.log"
echo "[serve] vllm serve $MODEL (thinking off, eager) -> $VLLM_LOG"
vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.85 --max-model-len 32768 --enforce-eager \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$MODEL" > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'kill $VLLM_PID 2>/dev/null || true' EXIT
for s in $(seq 1 180); do
  curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; break; }
  sleep 5; kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$VLLM_LOG"; exit 1; }
done

AGENT=$REPO/dr-tulu/agent; GEN=$DRRLM/agent/generate.py
cd "$AGENT"
echo "[gen] researchqa N=$N @ RECOMMENDED: temp0.7 top_p0.8 top_k20 min_p0 presence_penalty1.5 ..."
python "$GEN" \
  --driver new --benchmark researchqa --model "$MODEL" --tokenizer-path "$MODEL" \
  --base-url "http://localhost:$PORT/v1" --api-key-env OPENAI_API_KEY \
  --max-iterations 6 --max-completion-tokens 1024 \
  --temperature 0.7 --top-p 0.8 --sampling-top-k 20 --min-p 0.0 --presence-penalty 1.5 \
  --max-tool-calls 80 --max-children 4 --child-return-mode structured \
  --search-backend bm25s \
  --search-corpus-path "$FROZEN/corpus.jsonl" --search-index-path "$FROZEN/bm25s_index" \
  --max-recursion-depth 0 --abort-after-dead-items 1000 --num-examples "$N" \
  --output "$OUT/rqa_recommended.jsonl" --save-trajectories "$OUT/traj" < /dev/null

echo; echo "=== RECOMMENDED vs GREEDY (the comparison) ==="
python - <<'PY'
import json, os
def rate(f):
    if not os.path.exists(f): return None
    rows=[json.loads(l) for l in open(f,encoding='utf-8').read().split("\n") if l.strip()]
    ne=[r for r in rows if (r.get('final_response') or '').strip()]
    lens=sorted((len(r.get('final_response') or '') for r in rows), reverse=True)
    return rows, ne, lens
g=rate("/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/temp_sweep/rqa_t0.0.jsonl")
r=rate("/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/rec_sampling/rqa_recommended.jsonl")
if g: print(f"GREEDY      temp0.0           : non-empty {len(g[1])}/{len(g[0])}  lens={g[2]}")
if r:
    print(f"RECOMMENDED temp0.7+pp1.5+top_k20: non-empty {len(r[1])}/{len(r[0])}  lens={r[2]}")
    if r[1]:
        print("  sample report head:", (r[1][0]['final_response'][:200].replace(chr(10),' ')))
PY
echo "[done]"
