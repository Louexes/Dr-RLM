#!/bin/bash
# ============================================================================
# BASELINE eval — untrained Qwen3.5-4B, flat vs recursive, dual-judge.
#
# Generation config ALIGNED with the gradable RL smoke (smoke_L3_complete.job ->
# run_dr_rlm_L3.sh): enable_thinking=false, temperature=1.0, max_generate_length=1024,
# max_turns=10, max_children_per_node=4, child_return_mode=STRUCTURED, recursion depth=1.
# (The earlier smoke broke recursion by using prose/depth2/6-turns — NOT what RL ran.)
#
# Two graders on the SAME reports to validate the judge:
#   * Qwen3.5-4B  (local vLLM, aliased to the researchqa grader name)
#   * gpt-4.1-mini (real OpenAI API, the benchmark's canonical grader)
# ============================================================================
#SBATCH --job-name=judge_check_q35
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=01:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/eval_base_q35_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/eval_base_q35_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
DRRLM=$REPO/dr-rlm
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B
GRADER_ALIAS=gpt-4.1-mini-2025-04-14       # researchqa's hardcoded grader name -> aliased to MODEL
PORT=8000
FROZEN=$DRRLM/data/frozen_corpus
OUT=$DRRLM/runs/eval_baseline_q35
NUMEX=20
JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"

source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false
export OPENAI_API_KEY=EMPTY                 # policy gen runs against local vLLM (auth ignored)

# ----------------------------------------------------------------------------
# 1. Serve Qwen3.5-4B, thinking OFF (matches RL), aliased for the researchqa grader name.
# ----------------------------------------------------------------------------
VLLM_LOG="$DRRLM/runs/logs/eval_base_q35_vllm_${JOBID}.log"
echo "[serve] vllm serve $MODEL on :$PORT (thinking off, aliased $GRADER_ALIAS) -> $VLLM_LOG"
vllm serve "$MODEL" \
  --host 0.0.0.0 --port "$PORT" \
  --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.85 \
  --max-model-len 32768 \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$MODEL" "$GRADER_ALIAS" \
  > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'echo "[cleanup] killing vllm $VLLM_PID"; kill $VLLM_PID 2>/dev/null || true' EXIT

echo "[serve] waiting for readiness ..."
READY=0
for i in $(seq 1 180); do
  if curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1; then
    echo "[serve] ready after ~$((i*5))s"; READY=1; break
  fi
  sleep 5
  kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died; last 60 log lines:"; tail -60 "$VLLM_LOG"; exit 1; }
done
[[ "$READY" == "1" ]] || { echo "[FATAL] vllm not ready after 15min"; tail -60 "$VLLM_LOG"; exit 1; }

# ----------------------------------------------------------------------------
# 2. Generate flat(d0) + recursive(d1, structured) — RL-aligned generation config.
# ----------------------------------------------------------------------------
AGENT=$REPO/dr-tulu/agent
GEN=$DRRLM/agent/generate.py
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat49.jsonl
cd "$AGENT"

COMMON="--driver new --benchmark researchqa --model $MODEL --tokenizer-path $MODEL \
  --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
  --max-iterations 10 --max-completion-tokens 1024 --temperature 1.0 \
  --max-tool-calls 80 --max-children 4 --child-return-mode structured \
  --search-backend bm25s \
  --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
  --num-examples $NUMEX"

# Judge-validation ONLY needs one set of reports graded by both judges. Flat (d0) is the
# fastest, most reliable report producer; the judge grades final report text either way.
echo "[gen] flat depth=0 (RL-aligned: thinking off) ..."
t0=$SECONDS
python "$GEN" $COMMON --max-recursion-depth 0 \
  --output "$OUT/researchqa_flat.jsonl" \
  --save-trajectories "$OUT/traj_flat" < /dev/null
echo "[gen] flat done in $((SECONDS-t0))s"

# ----------------------------------------------------------------------------
# 3. Dual-judge grading on the SAME reports.
# ----------------------------------------------------------------------------
source "$DRRLM/keys.sh"                      # provides the real OPENAI_API_KEY for gpt-4.1-mini
REAL_OPENAI_KEY="$OPENAI_API_KEY"

for name in flat; do
  f="$OUT/researchqa_$name.jsonl"
  [[ -s "$f" ]] || { echo "[grade $name] SKIP (no output)"; continue; }
  res="${f%.jsonl}_eval_results.json"

  echo "[grade $name] judge=Qwen3.5-4B (local) ..."
  if OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
       python scripts/evaluate.py researchqa "$f" 2>&1 | tee "$OUT/score_qwen_$name.txt"; then
    cp "$res" "$OUT/eval_qwen_$name.json"
  else echo "[warn] Qwen grade ($name) failed"; fi

  echo "[grade $name] judge=gpt-4.1-mini (real OpenAI) ..."
  if OPENAI_BASE_URL="https://api.openai.com/v1" OPENAI_API_KEY="$REAL_OPENAI_KEY" \
       python scripts/evaluate.py researchqa "$f" 2>&1 | tee "$OUT/score_gpt41mini_$name.txt"; then
    cp "$res" "$OUT/eval_gpt41mini_$name.json"
  else echo "[warn] gpt-4.1-mini grade ($name) failed (key/quota?) — Qwen baseline still valid"; fi
done

# ----------------------------------------------------------------------------
# 4. Compare the two judges (per-item coverage + per-criterion agreement).
# ----------------------------------------------------------------------------
python - "$OUT" <<'PY'
import json, sys, os
OUT=sys.argv[1]
def load(p):
    return json.load(open(p)) if os.path.exists(p) else None
print("\n================ JUDGE COMPARISON (Qwen3.5-4B vs gpt-4.1-mini) ================")
_score={ "Not at all":0.0, "Somewhat":0.5, "Mostly":0.75, "Yes":1.0, "Fully":1.0 }
for arm in ["flat"]:
    q=load(f"{OUT}/eval_qwen_{arm}.json"); g=load(f"{OUT}/eval_gpt41mini_{arm}.json")
    if not q or not g: print(f"[{arm}] missing results"); continue
    qc=q["metrics"]["coverage"]; gc=g["metrics"]["coverage"]
    print(f"\n[{arm}]  coverage  Qwen={qc:.3f}  gpt-4.1-mini={gc:.3f}  (n={q['num_examples']})")
    # per-item + per-criterion agreement
    qpe=q.get("per_example_results",{}); gpe=g.get("per_example_results",{})
    tot=agree=0; absdiff=[]
    print(f"  {'item':<26} {'Qwen':>6} {'gpt41':>6}")
    for ex in sorted(qpe):
        if ex not in gpe: continue
        qrs={r['rubric']:r['score'] for r in qpe[ex]}; grs={r['rubric']:r['score'] for r in gpe[ex]}
        qi=sum(_score.get(s,0) for s in qrs.values())/max(1,len(qrs))
        gi=sum(_score.get(s,0) for s in grs.values())/max(1,len(grs))
        absdiff.append(abs(qi-gi))
        print(f"  {ex:<26} {qi:>6.3f} {gi:>6.3f}")
        for rub in qrs:
            if rub in grs:
                tot+=1; agree += (qrs[rub]==grs[rub])
    if tot: print(f"  per-criterion exact agreement: {agree}/{tot} = {agree/tot:.2%}")
    if absdiff: print(f"  mean |coverage diff| per item: {sum(absdiff)/len(absdiff):.3f}")
print("\n=============================================================================")
PY
echo "[done] baseline + judge comparison -> $OUT"
ls -la "$OUT"
