#!/bin/bash
# ============================================================================
# JUDGE VALIDATION — do Qwen3.5-4B and gpt-4.1-mini agree on grading?
#
# Grades an EXISTING set of 49 known-good ResearchQA reports (runs/A2, the W1 RLM
# arm — full content, varying quality) with BOTH judges and compares per-item
# coverage + per-criterion exact agreement. No generation → sidesteps the untrained
# policy's flakiness entirely; the judge grades report TEXT, which doesn't care how
# the report was produced. Far more robust than ~10 flaky fresh generations.
#
# ResearchQA's grader hardcodes "gpt-4.1-mini-2025-04-14" (evaluate.py:347); we alias
# the local Qwen to that name + route OPENAI_BASE_URL to vLLM for the Qwen pass, then
# point it at the real OpenAI API for the gpt-4.1-mini pass.
# ============================================================================
#SBATCH --job-name=judge_val_q35
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=01:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/judge_val_q35_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/judge_val_q35_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
DRRLM=$REPO/dr-rlm
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B
GRADER_ALIAS=gpt-4.1-mini-2025-04-14
PORT=8000
SRC=$DRRLM/runs/A2/researchqa.jsonl          # 49 known-good ResearchQA reports
OUT=$DRRLM/runs/judge_validation
JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"

source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false
cp "$SRC" "$OUT/researchqa.jsonl"            # grade a copy (grader writes *_eval_results.json next to input)

# ----------------------------------------------------------------------------
# 1. Serve Qwen3.5-4B judge (thinking off, aliased to the researchqa grader name).
# ----------------------------------------------------------------------------
VLLM_LOG="$DRRLM/runs/logs/judge_val_q35_vllm_${JOBID}.log"
echo "[serve] vllm serve $MODEL on :$PORT (judge, aliased $GRADER_ALIAS) -> $VLLM_LOG"
vllm serve "$MODEL" \
  --host 0.0.0.0 --port "$PORT" \
  --tensor-parallel-size 1 --gpu-memory-utilization 0.85 --max-model-len 16384 \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$MODEL" "$GRADER_ALIAS" \
  > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'echo "[cleanup] killing vllm $VLLM_PID"; kill $VLLM_PID 2>/dev/null || true' EXIT
echo "[serve] waiting for readiness ..."
READY=0
for i in $(seq 1 180); do
  curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((i*5))s"; READY=1; break; }
  sleep 5; kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$VLLM_LOG"; exit 1; }
done
[[ "$READY" == "1" ]] || { echo "[FATAL] vllm not ready"; tail -40 "$VLLM_LOG"; exit 1; }

# ----------------------------------------------------------------------------
# 2. Grade the SAME reports with both judges.
# ----------------------------------------------------------------------------
AGENT=$REPO/dr-tulu/agent
cd "$AGENT"
f="$OUT/researchqa.jsonl"
res="${f%.jsonl}_eval_results.json"
source "$DRRLM/keys.sh"
REAL_OPENAI_KEY="$OPENAI_API_KEY"

echo "[grade] judge=Qwen3.5-4B (local) ..."
if OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
     python scripts/evaluate.py researchqa "$f" 2>&1 | tee "$OUT/score_qwen.txt"; then
  cp "$res" "$OUT/eval_qwen.json"
else echo "[FATAL] Qwen grade failed"; exit 1; fi

echo "[grade] judge=gpt-4.1-mini (real OpenAI) ..."
if OPENAI_BASE_URL="https://api.openai.com/v1" OPENAI_API_KEY="$REAL_OPENAI_KEY" \
     python scripts/evaluate.py researchqa "$f" 2>&1 | tee "$OUT/score_gpt41mini.txt"; then
  cp "$res" "$OUT/eval_gpt41mini.json"
else echo "[FATAL] gpt-4.1-mini grade failed (key/quota?)"; exit 1; fi

# ----------------------------------------------------------------------------
# 3. Compare the two judges.
# ----------------------------------------------------------------------------
python - "$OUT" <<'PY'
import json, sys, os
OUT=sys.argv[1]
q=json.load(open(f"{OUT}/eval_qwen.json")); g=json.load(open(f"{OUT}/eval_gpt41mini.json"))
_score={"Not at all":0.0,"Somewhat":0.5,"Mostly":0.75,"Yes":1.0,"Fully":1.0}
print("\n================ JUDGE AGREEMENT: Qwen3.5-4B vs gpt-4.1-mini ================")
print(f"overall coverage   Qwen={q['metrics']['coverage']:.3f}   gpt-4.1-mini={g['metrics']['coverage']:.3f}   (n={q['num_examples']})")
qpe=q.get("per_example_results",{}); gpe=g.get("per_example_results",{})
tot=agree=0; absdiff=[]
for ex in sorted(qpe):
    if ex not in gpe: continue
    qrs={r['rubric']:r['score'] for r in qpe[ex]}; grs={r['rubric']:r['score'] for r in gpe[ex]}
    qi=sum(_score.get(s,0) for s in qrs.values())/max(1,len(qrs))
    gi=sum(_score.get(s,0) for s in grs.values())/max(1,len(grs))
    absdiff.append(abs(qi-gi))
    for rub in qrs:
        if rub in grs: tot+=1; agree+=(qrs[rub]==grs[rub])
print(f"per-criterion EXACT agreement : {agree}/{tot} = {agree/tot:.1%}" if tot else "no criteria")
print(f"mean |per-item coverage diff| : {sum(absdiff)/len(absdiff):.3f}  (over {len(absdiff)} items)")
# correlation of per-item coverage
import statistics as st
if len(absdiff)>2:
    qi_all=[sum(_score.get(r['score'],0) for r in qpe[ex])/max(1,len(qpe[ex])) for ex in sorted(qpe) if ex in gpe]
    gi_all=[sum(_score.get(r['score'],0) for r in gpe[ex])/max(1,len(gpe[ex])) for ex in sorted(qpe) if ex in gpe]
    mq,mg=st.mean(qi_all),st.mean(gi_all)
    cov=sum((a-mq)*(b-mg) for a,b in zip(qi_all,gi_all))
    dq=sum((a-mq)**2 for a in qi_all)**.5; dg=sum((b-mg)**2 for b in gi_all)**.5
    if dq and dg: print(f"per-item coverage Pearson r   : {cov/(dq*dg):.3f}")
print("============================================================================")
PY
echo "[done] judge validation -> $OUT"
