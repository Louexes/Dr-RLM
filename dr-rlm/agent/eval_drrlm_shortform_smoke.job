#!/bin/bash
# ============================================================================
# SMOKE TEST — untrained DR-RLM short-form, THINKING-ON, N=4 simpleqa, 1 shard.
# Gate for the full run: confirms (a) subset loads, (b) bm25s retrieval is alive
# (not dead-search abort), (c) final_response is NON-EMPTY (the untrained thinking-ON
# finalization risk — an unfinalized model scores 0 on Exact-Answer). Same locked
# COMMON as the untrained long-form baselines. GEN ONLY — grading is a separate
# off-GPU step (GPU nodes have no internet). Short + cheap: ~1 serve + 4 items.
# ============================================================================
#SBATCH --job-name=drrlm_sf_smoke
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_sf_smoke_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_sf_smoke_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B; PORT=8007
FROZEN=$DRRLM/data/frozen_corpus; OUT=$DRRLM/runs/drrlm_sf_smoke; TASK=simpleqa; N=4
JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"; rm -f "$OUT"/shard_*.jsonl "$OUT/${TASK}.jsonl"
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY
export PYTHONPATH=$AGENT:$DRRLM/agent:${PYTHONPATH:-}
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt
export SIMPLEQA_LOCAL_PATH=$DRRLM/data/subsets/simpleqa_eval120.jsonl
export TWOWIKI_LOCAL_PATH=$DRRLM/data/subsets/2wiki_eval120.jsonl
export WEBWALKER_LOCAL_PATH=$DRRLM/data/subsets/webwalker_eval120.jsonl

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){
  local think="$1" log="$DRRLM/runs/logs/drrlm_sf_smoke_vllm_${JOBID}.log"
  echo "[serve] vllm $MODEL enable_thinking=$think -> $log"
  vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
    --default-chat-template-kwargs "{\"enable_thinking\": $think}" \
    --served-model-name "$MODEL" > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 240); do
    curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$log"; exit 1; }
  done; echo "[FATAL] vllm never ready"; exit 1
}

serve true
GEN=$DRRLM/agent/generate.py; cd "$AGENT"
COMMON="--driver new --benchmark $TASK --model $MODEL --tokenizer-path $MODEL \
  --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
  --max-recursion-depth 1 --max-iterations 10 --max-completion-tokens 8192 \
  --max-tool-calls 80 --max-children 10 --child-return-mode structured \
  --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
  --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
  --abort-after-dead-items 1000 --num-examples $N"
echo "[gen] DR-RLM THINKING-ON smoke $TASK N=$N ..."
python "$GEN" $COMMON --num-shards 1 --shard 0 \
  --output "$OUT/${TASK}.jsonl" --save-trajectories "$OUT/traj" 2>&1 | tail -30

echo; echo "===== SMOKE GATES ====="
python - "$OUT/${TASK}.jsonl" <<'PY'
import json,sys,os
p=sys.argv[1]
if not os.path.exists(p) or os.path.getsize(p)==0:
    print("FAIL: no output rows written"); sys.exit(1)
rows=[json.loads(l) for l in open(p) if l.strip()]
ne=[r for r in rows if (r.get("final_response") or "").strip()]
exact=[r for r in ne if "exact answer" in (r["final_response"] or "").lower()]
# retrieval alive? (correct key: n_surfaced_snippets, aggregated across the tree)
def n_search(r):
    a=r.get("additional_output_data") or {}; return a.get("n_surfaced_snippets",0)
searched=[r for r in rows if n_search(r)>0]
print(f"rows written     : {len(rows)}/4")
print(f"non-empty answer : {len(ne)}/{len(rows)}   <- FINALIZATION gate")
print(f"has 'Exact Answer': {len(exact)}/{len(rows)}")
print(f"retrieval alive  : {len(searched)}/{len(rows)} did >=1 search")
for r in rows[:4]:
    fr=(r.get("final_response") or "").strip().replace("\n"," ")
    print(f"  - {r['example_id'][:8]} search={n_search(r)} ans={fr[:90]!r}")
ok = len(rows)>=3 and len(ne)>=1 and len(searched)>=1
print("VERDICT:", "PASS -> safe to launch full run" if ok else "FAIL -> investigate before full run")
sys.exit(0 if ok else 2)
PY
echo "[done] smoke output: $OUT/${TASK}.jsonl"
