#!/bin/bash
# SLURM job — CAPSTONE cross-benchmark check: reclaim_filter variant on RQA n=8 + HB n=7.
# The capstone (re-claim carry + v3 mechanical filter) won DRB (valid 4.29 @ 0.714, RACE
# 0.330) and sqav2 (global 0.379->0.569, cite precision 0->0.661). Benchmark-neutrality
# discipline: the variant touches DELEGATION+CITATIONS+FINISHING shared by all benchmarks,
# so RQA (ref: coverage 0.602) and HB (ref: 0.240) must hold before canonical adoption.
#SBATCH --job-name=offline_capstone_crossbench
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_capstone_crossbench_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_capstone_crossbench_%j.err
set -euo pipefail
cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent
BASE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/offline_capstone_crossbench

COMMON_ENV() {
  export ARMS=structured
  export DR_RLM_CAPTURE_LEDGER=1
  export MODEL=gemini-2.5-flash
  export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
  export MODEL_API_KEY_ENV=GEMINI_API_KEY
  export TOKENIZER=Qwen/Qwen3-8B
  export MAX_DEPTH=1
  export SEARCH_BACKEND=local_jsonl
  export MAX_TOOL_CALLS=200
  export MAX_CHILDREN=6
  export GRADE=1
  export SAVE_TRAJ=1
  export CITATION_VERIFY=0
  export CHECK_TOOL=1
  export DR_RLM_PROMPT_FILE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/prompts/variants/reclaim_filter.txt
}

COMMON_ENV
export BENCH=researchqa NUMEX=8
export SEARCH_CORPUS_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/offline_corpus/researchqa.jsonl
export OUT=$BASE/researchqa
echo "[capstone] RQA n=8 ..."
./ab_child_return.sh || echo "[warn] rqa failed"

COMMON_ENV
export BENCH=healthbench NUMEX=7
export SEARCH_CORPUS_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/offline_corpus/healthbench.jsonl
export HEALTHBENCH_LOCAL_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/subsets/healthbench_hard_repr.jsonl
export OUT=$BASE/healthbench
echo "[capstone] HB n=7 ..."
./ab_child_return.sh || echo "[warn] hb failed"

echo "[offline_capstone_crossbench] done -> $BASE"
