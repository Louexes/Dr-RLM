#!/bin/bash
# Grade-only: clean rl_be68 (step-75 main provenance arm) ResearchQA coverage.
# The panel RQA job merged with `cat shard_*.jsonl`, whose glob swept in sibling
# benchmarks' shards (254 leaked rows) and crashed the grader on a row lacking orig_id.
# researchqa_clean.jsonl = the 120 real RQA gens (orig_id present). This job serves the
# SAME base-Qwen thinking-OFF judge as every other stage and grades that file only.
#SBATCH --job-name=grade_rqa_rlbe68
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=01:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/grade_rqa_rlbe68_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/grade_rqa_rlbe68_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
JUDGE_MODEL=Qwen/Qwen3.5-4B      # judge = base, thinking-OFF (identical to every other stage)
PORT=8017; GRADER_ALIAS=gpt-4.1-mini-2025-04-14
OUT=$DRRLM/runs/rl_be68_final_thinkon; TASK=researchqa; INPUT=$OUT/researchqa_clean.jsonl
JOBID=${SLURM_JOB_ID:-local}
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY
export HF_HOME=/scratch-shared/lgehringer/hf_cache HF_HUB_OFFLINE=1
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
echo "[serve:judge] Qwen3.5-4B thinking-OFF -> port $PORT"
vllm serve "$JUDGE_MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$JUDGE_MODEL" --served-model-name "$GRADER_ALIAS" \
  > "$DRRLM/runs/logs/grade_rqa_rlbe68_vllm_${JOBID}.log" 2>&1 &
CUR_PID=$!
for s in $(seq 1 300); do
  curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; break; }
  sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$DRRLM/runs/logs/grade_rqa_rlbe68_vllm_${JOBID}.log"; exit 1; }
done

cd "$AGENT"
echo "=== GRADE rl_be68 RQA (thinking-OFF judge, n=120 clean) ==="
OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
  python scripts/evaluate.py "$TASK" "$INPUT" 2>&1 | grep -viE "Coverage for|Expected 8|Questions:|Authlib|joserfc|Computing rubric" | tail -8
python - "${INPUT%.jsonl}_eval_results.json" <<'PY'
import json,sys,os
f=sys.argv[1]
if os.path.exists(f):
    d=json.load(open(f))
    print("rl_be68 RQA coverage:", d.get("score") or d.get("metrics",{}).get("coverage"),
          "| n=", d.get("num_examples"), "| anchors: untrained 0.237 / SFT 0.348")
PY
echo "[done] $INPUT"
