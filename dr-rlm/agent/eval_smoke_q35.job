#!/bin/bash
# ============================================================================
# EVAL SMOKE — frozen bm25s corpus + Qwen3.5-4B as BOTH policy and judge.
#
# First live run of: (1) the bm25s frozen-corpus retrieval path end-to-end,
# (2) Qwen3.5-4B served in vLLM 0.19 (qwen3_5 arch, native-multimodal, text-only
# use), (3) Qwen3.5-4B as the eval grader. ResearchQA, N=2, flat(d0)+recursive(d2).
#
# One vLLM instance serves the policy (generate.py --base-url) AND the grader.
# ResearchQA's grader name is hardcoded "gpt-4.1-mini-2025-04-14" (evaluate.py:347),
# so we ALIAS the served model to that name and route the grader via OPENAI_BASE_URL
# -> Qwen3.5-4B does the grading with zero code edit.
# ============================================================================
#SBATCH --job-name=eval_smoke_q35
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/eval_smoke_q35_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/eval_smoke_q35_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
DRRLM=$REPO/dr-rlm
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B
GRADER_ALIAS=gpt-4.1-mini-2025-04-14      # researchqa's hardcoded grader name -> aliased to MODEL
PORT=8000
FROZEN=$DRRLM/data/frozen_corpus
OUT=$DRRLM/runs/eval_smoke_q35
JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"

source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false
export OPENAI_API_KEY=EMPTY                # fully local; vLLM ignores auth. NO real keys sourced.

# ----------------------------------------------------------------------------
# 1. Serve Qwen3.5-4B (policy + judge), aliased for the researchqa grader name.
# ----------------------------------------------------------------------------
VLLM_LOG="$DRRLM/runs/logs/eval_smoke_q35_vllm_${JOBID}.log"
echo "[serve] vllm serve $MODEL on :$PORT (aliased $GRADER_ALIAS) -> $VLLM_LOG"
# --default-chat-template-kwargs '{"enable_thinking": false}' MATCHES RL
# (run_dr_rlm_L4.sh:110 generator.chat_template_kwargs.enable_thinking=false). Without it,
# Qwen3.5-4B emits a "Thinking Process" preamble, burns its turn budget, and fails the REPL
# print-contract -> empty reports. Applies server-wide (policy gen AND the JSON judge -> both
# want no-think). The Qwen3.5 chat template honors it (emits an empty <think></think> block).
vllm serve "$MODEL" \
  --host 0.0.0.0 --port "$PORT" \
  --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.85 \
  --max-model-len 32768 \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$MODEL" "$GRADER_ALIAS" \
  > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'echo "[cleanup] killing vllm $VLLM_PID"; kill $VLLM_PID 2>/dev/null || true' EXIT

echo "[serve] waiting for readiness ..."
READY=0
for i in $(seq 1 180); do
  if curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1; then
    echo "[serve] ready after ~$((i*5))s"; READY=1; break
  fi
  sleep 5
  kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died during startup; last 60 log lines:"; tail -60 "$VLLM_LOG"; exit 1; }
done
[[ "$READY" == "1" ]] || { echo "[FATAL] vllm not ready after 15min; last 60 log lines:"; tail -60 "$VLLM_LOG"; exit 1; }

# quick sanity: can the served model answer + emit JSON (the judge contract)?
echo "[serve] sanity:"
curl -s "http://localhost:$PORT/v1/chat/completions" \
  -H 'Content-Type: application/json' -H 'Authorization: Bearer EMPTY' \
  -d "{\"model\":\"$GRADER_ALIAS\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with JSON {\\\"ok\\\": 1}\"}],\"temperature\":0,\"max_tokens\":20}" \
  | head -c 400; echo

# ----------------------------------------------------------------------------
# 2. Generate ResearchQA reports (bm25s frozen corpus): flat(d0) then recursive(d2)
# ----------------------------------------------------------------------------
AGENT=$REPO/dr-tulu/agent
GEN=$DRRLM/agent/generate.py
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat49.jsonl
cd "$AGENT"

# Generation config ALIGNED with RL (run_dr_rlm_L4.sh): max_turns=6, max_generate_length=1024,
# temperature=1.0, top_p=1.0 (top_p set in infer_driver). enable_thinking=false is server-side above.
COMMON="--driver new --benchmark researchqa --model $MODEL --tokenizer-path $MODEL \
  --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
  --max-iterations 6 --max-completion-tokens 1024 --temperature 1.0 \
  --max-tool-calls 60 --max-children 4 \
  --search-backend bm25s \
  --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
  --num-examples 2"

for arm in flat:0 recursive:2; do
  name=${arm%%:*}; depth=${arm##*:}
  echo "[gen] arm=$name depth=$depth (bm25s, Qwen3.5-4B) ..."
  t0=$SECONDS
  python "$GEN" $COMMON --max-recursion-depth "$depth" \
    --output "$OUT/researchqa_$name.jsonl" \
    --save-trajectories "$OUT/traj_$name" < /dev/null
  echo "[gen] arm=$name done in $((SECONDS-t0))s -> $OUT/researchqa_$name.jsonl"
done

# ----------------------------------------------------------------------------
# 3. Grade both arms with Qwen3.5-4B as judge (routed via OPENAI_BASE_URL).
# ----------------------------------------------------------------------------
for name in flat recursive; do
  f="$OUT/researchqa_$name.jsonl"
  [[ -s "$f" ]] || { echo "[grade $name] SKIP (no output)"; continue; }
  echo "[grade $name] ResearchQA coverage, judge=Qwen3.5-4B ..."
  OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
    python scripts/evaluate.py researchqa "$f" 2>&1 | tee "$OUT/score_$name.txt"
done

echo "[done] eval smoke complete -> $OUT"
echo "[summary] outputs:"; ls -la "$OUT"
