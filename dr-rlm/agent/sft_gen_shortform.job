#!/bin/bash
# ============================================================================
# SFT STEP 1b — SHORT-FORM teacher data, BOTH arms (SFT_PLAN_2026-07-03.md D3b).
# Guardrail mix (RQ5): 305 corpus-reserved short-form prompts with reference answers
# (sft_prompts_shortform_manifest.json), Qwen3.6-27B teacher, rejection filter =
# answer equivalence vs reference (local judge) — mirrors DR-Tulu's gold-match
# rejection sampling. Task statements: dr-tulu's VERBATIM exact-answer instruction for
# the flat arm; harness-native equivalent for the recursive REPL contract.
# Submit with --dependency=afterany:<flat long-form job>.
# ============================================================================
#SBATCH --job-name=sft_gen_sf
#SBATCH --partition=gpu_h100
#SBATCH --gpus=3
#SBATCH --cpus-per-task=48
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_gensf_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_gensf_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
SKYPY=$DRRLM/rl/skyrl/.venv/bin/python
TEACHER_DIR=/scratch-shared/lgehringer/models/Qwen3.6-27B
TEACHER=Qwen/Qwen3.6-27B; TPORT=8006
JUDGE=gpt-4.1-mini-2025-04-14; JPORT=8100
FROZEN=$DRRLM/data/frozen_corpus; OUT=$DRRLM/runs/sft_gen_shortform; SFTD=$DRRLM/data/sft
MANIFEST=$DRRLM/data/subsets/sft_prompts_shortform_manifest.json
# dr-tulu's verbatim exact-answer instruction (flat arm)
SF_FLAT="For the given question, please think and search iteratively to find the answer, and provide the final answer in following format: <answer>\\\\boxed{exact answer}</answer>."
# harness-native equivalent for the recursive REPL contract
SF_REC='Find the exact answer to this question. Set answer["content"] to ONLY the exact final answer (a short phrase or value, not a report), cite the supporting snippet, and submit.'
SHARDS=6; JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$SFTD" "$DRRLM/runs/logs"
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY JUDGE_API_KEY=EMPTY
export VLLM_USE_DEEP_GEMM=0 HF_HUB_OFFLINE=1 DR_RLM_CAPTURE_LEDGER=1
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt

PIDS=(); cleanup(){ for p in "${PIDS[@]}"; do kill "$p" 2>/dev/null || true; done; }; trap cleanup EXIT
wait_ready(){ for s in $(seq 1 240); do
    curl -sf "http://localhost:$1/v1/models" >/dev/null 2>&1 && { echo "[serve:$2] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$3" 2>/dev/null || { echo "[FATAL] vllm($2) died"; exit 1; }
  done; echo "[FATAL] vllm($2) never ready"; exit 1; }

CUDA_VISIBLE_DEVICES=0,1 vllm serve "$TEACHER_DIR" --host 0.0.0.0 --port $TPORT \
  --tensor-parallel-size 2 --gpu-memory-utilization 0.90 --max-model-len 131072 \
  --max-num-seqs 32 --default-chat-template-kwargs '{"enable_thinking": true}' \
  --served-model-name "$TEACHER" > "$DRRLM/runs/logs/sft_gensf_vllm_teacher_${JOBID}.log" 2>&1 &
PIDS+=($!); TPID=$!
CUDA_VISIBLE_DEVICES=2 vllm serve Qwen/Qwen3.5-4B --host 0.0.0.0 --port $JPORT \
  --tensor-parallel-size 1 --gpu-memory-utilization 0.90 --max-model-len 32768 \
  --max-num-seqs 32 --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$JUDGE" > "$DRRLM/runs/logs/sft_gensf_vllm_judge_${JOBID}.log" 2>&1 &
PIDS+=($!); JPID=$!
wait_ready $TPORT teacher $TPID; wait_ready $JPORT judge $JPID

# ---- build inputs: SkyRL rows for recursive (instruction appended), researchqa-format for flat ----
python - "$MANIFEST" "$OUT" "$SF_REC" <<'PY'
import json, sys
m = json.load(open(sys.argv[1])); outdir = sys.argv[2]; instr = sys.argv[3]
with open(f"{outdir}/sf_rec_rows.jsonl", "w") as fr, open(f"{outdir}/sf_flat_rows.jsonl", "w") as ff:
    for e in m["entries"]:
        q = e["question"] + "\n\n" + instr
        fr.write(json.dumps({"prompt": [{"role": "user", "content": q}], "question": q,
                             "env_class": "dr_rlm", "reward_spec": {"ground_truth": "", "rubrics": []},
                             "uid": e["qid"]}, ensure_ascii=False) + "\n")
        ff.write(json.dumps({"id": e["qid"], "query": e["question"]}, ensure_ascii=False) + "\n")
print(f"wrote {len(m['entries'])} rows per arm")
PY

# ---- ARM 1: recursive harness (threshold 0 — filtering is answer-equivalence post-hoc) ----
cd "$DRRLM/rl/skyrl"
if [ -s "$OUT/sf_rec_merged.jsonl" ]; then
  echo "[rec] merged output exists ($(wc -l < "$OUT/sf_rec_merged.jsonl") rows) — skipping generation"
else
python - "$OUT/sf_rec_rows.jsonl" "$OUT" $SHARDS <<'PY'
import json, sys
rows = [l for l in open(sys.argv[1]) if l.strip()]
n = int(sys.argv[3])
for i in range(n):
    open(f"{sys.argv[2]}/sf_rec_shard_{i}.jsonl", "w").writelines(rows[i::n])
PY
pids=()
for i in $(seq 0 $((SHARDS-1))); do
  env -u VIRTUAL_ENV $SKYPY examples/train/dr_rlm/sft/gen_recursive_sft.py \
    --prompts "$OUT/sf_rec_shard_${i}.jsonl" --out_jsonl "$OUT/sf_rec_out_${i}.jsonl" \
    --n_samples 1 --threshold 0.0 --max_depth 2 --max_iterations 10 \
    --max_concurrent_subcalls 4 --temperature 0.7 \
    --model "$TEACHER" --base_url "http://localhost:$TPORT/v1" \
    --search_backend bm25s --search_corpus_path "$FROZEN/corpus.jsonl" \
    --search_index_path "$FROZEN/bm25s_index" > "$OUT/sf_rec_${i}.log" 2>&1 < /dev/null &
  pids+=($!)
done
echo "[rec] launched $SHARDS shards ..."
fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
cat "$OUT"/sf_rec_out_*.jsonl > "$OUT/sf_rec_merged.jsonl"
[ -s "$OUT/sf_rec_merged.jsonl" ] || { echo "[FATAL] rec merge produced nothing"; exit 1; }
echo "[rec] done ($fail nonzero). rows: $(wc -l < "$OUT/sf_rec_merged.jsonl")"
fi
python "$DRRLM/scripts/filter_sft_shortform.py" --arm recursive \
  --in "$OUT/sf_rec_merged.jsonl" --out "$SFTD/dr_rlm_shortform_sft.jsonl" \
  --manifest "$MANIFEST" --judge_base_url "http://localhost:$JPORT/v1" --judge_model "$JUDGE"

# ---- ARM 2: flat harness (dr-tulu verbatim instruction via framing hook) ----
export RESEARCHQA_LOCAL_PATH=$OUT/sf_flat_rows.jsonl
export DR_TULU_FRAMING_JSON=$(SFF="$SF_FLAT" python -c "import json,os; print(json.dumps({'researchqa': os.environ['SFF']}))")
OV="search_tool_name=bm25s,browse_tool_name=bm25s"
OV="$OV,bm25s_index_path=$FROZEN/bm25s_index,bm25s_corpus_path=$FROZEN/corpus.jsonl"
OV="$OV,search_agent_base_url=http://localhost:$TPORT/v1"
OV="$OV,search_agent_model_name=$TEACHER,search_agent_tokenizer_name=$TEACHER_DIR"
OV="$OV,search_agent_temperature=0.7,search_agent_max_tokens=8192"
OV="$OV,search_agent_max_tool_calls=12,number_documents_to_search=10"
OV="$OV,tool_calling_mode=parser,use_browse_agent=false"
cd "$AGENT"; rm -f "$OUT/sf_flat.jsonl"
python "workflows/auto_search_sft.py" generate-dataset researchqa \
  --num-examples 305 --max-concurrent 8 --batch-size 8 --use-cache \
  --config "workflows/auto_search_sft.yaml" --config-overrides "$OV" \
  --output "$OUT/sf_flat.jsonl" < /dev/null
echo "[flat] done. rows: $(wc -l < "$OUT/sf_flat.jsonl")"
python "$DRRLM/scripts/filter_sft_shortform.py" --arm flat \
  --in "$OUT/sf_flat.jsonl" --out "$SFTD/dr_tulu_shortform_sft.jsonl" \
  --manifest "$MANIFEST" --judge_base_url "http://localhost:$JPORT/v1" --judge_model "$JUDGE"
echo "[step1b] complete."
