#!/bin/bash
# SLURM job — STRUCTURED-only run, V3: budget lifted + FACT fix live.
# Three questions, one run (same 8 V1/V2 tasks = DRB ids 51-58):
#   1. FACT > 0?  (_ledger_to_tool_calls now populates full_traces.tool_calls — the
#      root cause of every prior "No valid citations found")
#   2. Does structured's high citation survival convert into a real FACT score?
#   3. Throttle de-confound: vs V2-structured (RACE 0.163, MAX_TOOL_CALLS=80) this run
#      differs ONLY in the tool budget (80 -> 200). RACE recovery => throttle caused the
#      V1->V2 regression; flat => prompt/contract implicated (then run prose to split).
# n=8 caveat: RACE level is directional only; FACT + survival are the robust endpoints.
#SBATCH --job-name=structured_uncapped
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/structured_uncapped_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/structured_uncapped_%j.err
set -euo pipefail

mkdir -p /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs
cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent

export ARMS=structured
export DR_RLM_CAPTURE_LEDGER=1   # REQUIRED: pops the per-tree ledger -> _ledger_to_tool_calls
                                 # populates full_traces.tool_calls. Without it FACT stays 0.
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export TOKENIZER=Qwen/Qwen3-8B
export BENCH=deep_research_bench
export NUMEX=8                  # ids 51-58, same as V1/V2
export MAX_DEPTH=1
export SEARCH_BACKEND=web
export MAX_TOOL_CALLS=200       # lifted from 80 (the only delta vs V2-structured)
export MAX_CHILDREN=6
export GRADE=1
export SAVE_TRAJ=1
export OUT=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/structured_uncapped_v3

echo "[job ${SLURM_JOB_ID:-local}] $(hostname) structured-only n=8, budget=200, FACT fix live (resumes from $OUT)"
exec ./ab_child_return.sh
