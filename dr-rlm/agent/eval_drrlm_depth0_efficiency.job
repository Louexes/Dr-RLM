#!/bin/bash
# ============================================================================
# SINGLE-AGENT REPL (depth-0) eval on the final recursive RL ckpt (rl_be68 step 75).
# RQ3 substrate isolation: same policy + harness + corpus as the recursive eval, but
# --max-recursion-depth 0 so the root cannot delegate -> a single REPL agent. Fills the
# "Single-agent REPL" row of tab:efficiency (quality + cost between flat ReAct and recursive REPL).
# Config = eval COMMON, byte-identical to the recursive panel EXCEPT depth=0. Gen only; grade off-GPU.
# ============================================================================
#SBATCH --job-name=drrlm_depth0
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=160G
#SBATCH --time=04:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_depth0_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_depth0_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=/scratch-shared/lgehringer/rl_be68_exports/global_step_75/served; PORT=8016
FROZEN=$DRRLM/data/frozen_corpus; OUT=$DRRLM/runs/rl_be68_depth0_thinkon
JOBID=${SLURM_JOB_ID:-local}; SHARDS=8
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY HF_HOME=/scratch-shared/lgehringer/hf_cache HF_HUB_OFFLINE=1
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt
export DR_RLM_CAPTURE_LEDGER=1
export DRB_LOCAL_PATH=$DRRLM/data/subsets/drb_en50.jsonl
export SQAV2_LOCAL_PATH=$DRRLM/data/subsets/sqav2_cs100.jsonl
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
echo "[serve] vllm $MODEL enable_thinking=true (depth-0 single-agent)"
vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
  --default-chat-template-kwargs '{"enable_thinking": true}' \
  --served-model-name "$MODEL" > "$DRRLM/runs/logs/drrlm_depth0_vllm_${JOBID}.log" 2>&1 &
CUR_PID=$!
for s in $(seq 1 240); do
  curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; break; }
  sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$DRRLM/runs/logs/drrlm_depth0_vllm_${JOBID}.log"; exit 1; }
done

GEN=$DRRLM/agent/generate.py; cd "$AGENT"
run_bench(){  # $1=benchmark  $2=N
  local TASK="$1" N="$2"
  rm -f "$OUT"/shard_${TASK}_*.jsonl "$OUT/${TASK}.jsonl"
  echo "[gen] DEPTH-0 $TASK N=$N across $SHARDS shards ..."
  local COMMON="--driver new --benchmark $TASK --model $MODEL --tokenizer-path $MODEL \
    --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
    --max-recursion-depth 0 --max-iterations 10 --max-completion-tokens 8192 \
    --max-tool-calls 80 --max-children 10 --child-return-mode structured \
    --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
    --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
    --abort-after-dead-items 1000 --num-examples $N"
  local pids=()
  for i in $(seq 0 $((SHARDS-1))); do
    python "$GEN" $COMMON --num-shards "$SHARDS" --shard "$i" \
      --output "$OUT/shard_${TASK}_${i}.jsonl" --save-trajectories "$OUT/traj_${TASK}_${i}" \
      > "$OUT/shard_${TASK}_${i}.log" 2>&1 < /dev/null &
    pids+=($!)
  done
  local fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
  cat "$OUT"/shard_${TASK}_*.jsonl > "$OUT/${TASK}.jsonl" 2>/dev/null || true
  echo "[gen] $TASK done ($fail nonzero). rows: $(wc -l < "$OUT/${TASK}.jsonl" 2>/dev/null)"
}

run_bench deep_research_bench 50
run_bench sqav2 100
run_bench researchqa 120

echo "[done] depth-0 reports banked -> $OUT ; grade off-GPU (same panel jobs), cost via behavioral_metrics.py"
