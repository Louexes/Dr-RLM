#!/bin/bash
# ============================================================================
# LOCK the untrained-DR-RLM eval sampling + turn budget. Reverted harness (no auto-echo, 1:1 w/ RL).
# Same 12 ResearchQA items, temp 1.0 / top_p 1.0 (= eval_pilot = RL ROLLOUT sampling; extras as no-ops:
# top_k -1, min_p 0, presence_penalty 0). Two arms vary ONLY the turn cap:
#   A) 6 turns   (RL max_turns — does temp 1.0 alone recover the empties vs recommended-bundle 25%?)
#   B) 12 turns  (more room — does it recover more of the untrained ~50% single-sample floor?)
# Reference points (depth 0, same items): greedy 0/8 (0%), recommended-bundle@6 3/12 (25%).
# ============================================================================
#SBATCH --job-name=samp_lock
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=00:40:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/samp_lock_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/samp_lock_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
DRRLM=$REPO/dr-rlm
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B
PORT=8000
FROZEN=$DRRLM/data/frozen_corpus
OUT=$DRRLM/runs/sampling_lock
N=12
mkdir -p "$OUT" "$DRRLM/runs/logs"
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false
export OPENAI_API_KEY=EMPTY
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt.txt

VLLM_LOG="$DRRLM/runs/logs/samp_lock_vllm_${SLURM_JOB_ID:-local}.log"
echo "[serve] vllm serve $MODEL (thinking off, eager) -> $VLLM_LOG"
vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.85 --max-model-len 32768 --enforce-eager \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$MODEL" > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'kill $VLLM_PID 2>/dev/null || true' EXIT
for s in $(seq 1 180); do
  curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready ~$((s*5))s"; break; }
  sleep 5; kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died"; tail -40 "$VLLM_LOG"; exit 1; }
done

AGENT=$REPO/dr-tulu/agent; GEN=$DRRLM/agent/generate.py
cd "$AGENT"
run_arm () {  # $1=turns  $2=tag
  echo "[gen] researchqa N=$N @ temp1.0 top_p1.0 (RL rollout) turns=$1 ..."
  python "$GEN" \
    --driver new --benchmark researchqa --model "$MODEL" --tokenizer-path "$MODEL" \
    --base-url "http://localhost:$PORT/v1" --api-key-env OPENAI_API_KEY \
    --max-iterations "$1" --max-completion-tokens 1024 \
    --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
    --max-tool-calls 80 --max-children 4 --child-return-mode structured \
    --search-backend bm25s \
    --search-corpus-path "$FROZEN/corpus.jsonl" --search-index-path "$FROZEN/bm25s_index" \
    --max-recursion-depth 0 --abort-after-dead-items 1000 --num-examples "$N" \
    --output "$OUT/rqa_t1_turns${1}.jsonl" --save-trajectories "$OUT/traj_turns${1}" < /dev/null || echo "[warn] arm $2 failed"
}
run_arm 6  t6
run_arm 12 t12

echo; echo "=== SAMPLING-LOCK RESULTS (refs: greedy 0/8=0%, recommended-bundle@6 3/12=25%) ==="
python - <<'PY'
import json, os
def rate(f):
    if not os.path.exists(f): return None
    rows=[json.loads(l) for l in open(f,encoding='utf-8').read().split("\n") if l.strip()]
    ne=[r for r in rows if (r.get('final_response') or '').strip()]
    lens=sorted((len(r.get('final_response') or '') for r in rows), reverse=True)
    return len(ne), len(rows), lens
for tag,label in [("t6","temp1.0 @ 6 turns "),("t12","temp1.0 @ 12 turns")]:
    r=rate(f"/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/sampling_lock/rqa_t1_turns{tag[1:]}.jsonl")
    if r: print(f"{label}: non-empty {r[0]}/{r[1]} ({100*r[0]//max(1,r[1])}%)  lens={r[2]}")
PY
echo "[done]"
