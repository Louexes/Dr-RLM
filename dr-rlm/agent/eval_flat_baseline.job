#!/bin/bash
# ============================================================================
# UNTRAINED FLAT BASELINE — Qwen3.5-4B, DR-Tulu shape (depth=0), all 4 benchmarks.
#
# SLURM ARRAY: one task per benchmark (0=researchqa 1=DRB 2=healthbench 3=sqav2),
# so all four run in parallel on separate GPUs and a failure in one is isolated.
#
# Purpose: (1) "before-training" anchor for the DR-Tulu-shape arm; (2) exercise the
# frozen bm25s corpus end-to-end on every benchmark type.
#
# Generation config ALIGNED with RL's EVALUATION profile (NOT its rollout profile):
# SkyRL ppo_base_config.yaml splits generator.sampling_params (rollouts: temperature=1.0 for
# GRPO exploration) from generator.eval_sampling_params (evaluation: temperature=0.0 GREEDY,
# top_p=1.0). RL selects/reports checkpoints at GREEDY, so eval must too — temperature=1.0 was
# the training-EXPLORATION temp, wrong for measuring quality. So: enable_thinking=false,
# temperature=0.0 (greedy), top_p=1.0 (hardcoded in infer_driver), max_generate_length=1024,
# max_turns=6 (canonical L3/L4), child_return_mode=structured, max_children=4.
# Same prompt file as RL (DrRlmEnv._build_system_prompt -> prompts/system_prompt.txt).
# FLAT => max_recursion_depth=0 (worker-only, DR-Tulu's shape). --abort-after-dead-items RAISED to 1000
# so the untrained model's ~50% search-flakiness does NOT false-trip the dead-corpus guard
# (that bug aborted job 24257412 even though bm25s was fine).
#
# Grading: researchqa + healthbench route to the local Qwen3.5-4B judge (validated
# r=0.856 vs gpt-4.1-mini) for FREE. DRB + sqav2 use Gemini graders (gemini-2.5-pro RACE /
# -flash FACT / SQA scorer) which are NOT OpenAI-routable -> their reports are BANKED here
# and graded in a separate Gemini pass (keeps this batch $0).
# ============================================================================
#SBATCH --job-name=eval_flat_base
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=06:00:00
#SBATCH --array=0-3
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/eval_flat_base_%A_%a.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/eval_flat_base_%A_%a.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM
DRRLM=$REPO/dr-rlm
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B
GRADER_ALIAS=gpt-4.1-mini-2025-04-14        # researchqa/healthbench grader name -> aliased to MODEL
PORT=8000
FROZEN=$DRRLM/data/frozen_corpus
OUT=$DRRLM/runs/eval_flat_baseline
JOBID=${SLURM_ARRAY_JOB_ID:-local}_${SLURM_ARRAY_TASK_ID:-0}
mkdir -p "$OUT" "$DRRLM/runs/logs"

# ----- per-benchmark table, indexed by SLURM_ARRAY_TASK_ID -------------------
i=${SLURM_ARRAY_TASK_ID:-0}
# N: researchqa/healthbench = LOCKED stratified-120 sets (analysis/build_eval_locked.py,
# manifest data/subsets/eval_locked_manifest.json); DRB = full English-50; SQA = full 100.
BENCHES=(researchqa        deep_research_bench healthbench              sqav2)
NUMS=(120                  50                  120                      100)
PATHVARS=(RESEARCHQA_LOCAL_PATH DRB_LOCAL_PATH  HEALTHBENCH_LOCAL_PATH   SQAV2_LOCAL_PATH)
PATHVALS=("$DRRLM/data/subsets/researchqa_strat120.jsonl" \
          "$DRRLM/data/subsets/drb_en50.jsonl" \
          "$DRRLM/data/subsets/healthbench_strat120.jsonl" \
          "$DRRLM/data/subsets/sqav2_cs100.jsonl")
GRADE=(qwen               defer               qwen                     defer)

B=${BENCHES[$i]}; N=${NUMS[$i]}; PVAR=${PATHVARS[$i]}; PVAL=${PATHVALS[$i]}; G=${GRADE[$i]}
# SMOKE=1: tiny N + eager serve to validate every benchmark's load->generate(->grade) path cheaply
# in the EXACT job before the multi-hour full run. Same code, just N=2.
EAGER=""
if [[ "${SMOKE:-0}" == "1" ]]; then N=2; EAGER="--enforce-eager"; OUT="$OUT/smoke"; mkdir -p "$OUT"; echo "[SMOKE] N=2 + eager serve -> $OUT"; fi
echo "[task $i] benchmark=$B  N=$N  grade=$G  data=$PVAL"

source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false
export OPENAI_API_KEY=EMPTY                  # policy gen runs against local vLLM (auth ignored)
export "$PVAR=$PVAL"                          # the loader's *_LOCAL_PATH for this benchmark
export DR_RLM_PROMPT_FILE="$DRRLM/prompts/system_prompt.txt"  # the SAME prompt file RL uses (explicit, no ambiguity)

# ----------------------------------------------------------------------------
# 1. Serve Qwen3.5-4B, thinking OFF (matches RL), aliased for the judge name.
# ----------------------------------------------------------------------------
VLLM_LOG="$DRRLM/runs/logs/eval_flat_base_vllm_${JOBID}.log"
echo "[serve] vllm serve $MODEL on :$PORT (thinking off) -> $VLLM_LOG"
vllm serve "$MODEL" \
  --host 0.0.0.0 --port "$PORT" \
  --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.85 \
  --max-model-len 32768 $EAGER \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$MODEL" "$GRADER_ALIAS" \
  > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'echo "[cleanup] killing vllm $VLLM_PID"; kill $VLLM_PID 2>/dev/null || true' EXIT

echo "[serve] waiting for readiness ..."
READY=0
for s in $(seq 1 180); do
  if curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1; then
    echo "[serve] ready after ~$((s*5))s"; READY=1; break
  fi
  sleep 5
  kill -0 $VLLM_PID 2>/dev/null || { echo "[FATAL] vllm died; last 60 log lines:"; tail -60 "$VLLM_LOG"; exit 1; }
done
[[ "$READY" == "1" ]] || { echo "[FATAL] vllm not ready after 15min"; tail -60 "$VLLM_LOG"; exit 1; }

# ----------------------------------------------------------------------------
# 2. Generate FLAT (depth=0) — RL-aligned generation config.
# ----------------------------------------------------------------------------
AGENT=$REPO/dr-tulu/agent
GEN=$DRRLM/agent/generate.py
OUTFILE="$OUT/${B}_flat.jsonl"
cd "$AGENT"

echo "[gen] $B flat depth=0 (RL-aligned, thinking off, abort-guard=1000) ..."
t0=$SECONDS
python "$GEN" \
  --driver new --benchmark "$B" --model "$MODEL" --tokenizer-path "$MODEL" \
  --base-url "http://localhost:$PORT/v1" --api-key-env OPENAI_API_KEY \
  --max-iterations 6 --max-completion-tokens 1024 --temperature 0.0 \
  --max-tool-calls 80 --max-children 4 --child-return-mode structured \
  --search-backend bm25s \
  --search-corpus-path "$FROZEN/corpus.jsonl" --search-index-path "$FROZEN/bm25s_index" \
  --max-recursion-depth 0 \
  --abort-after-dead-items 1000 \
  --num-examples "$N" \
  --output "$OUTFILE" \
  --save-trajectories "$OUT/traj_${B}" < /dev/null
echo "[gen] $B done in $((SECONDS-t0))s -> $OUTFILE"
NREP=$(grep -c . "$OUTFILE" 2>/dev/null || echo 0)
echo "[gen] $B reports written: $NREP"

# ----------------------------------------------------------------------------
# 3. Grade — Qwen judge (free) for researchqa/healthbench; BANK DRB/sqav2 for Gemini.
# ----------------------------------------------------------------------------
[[ -s "$OUTFILE" ]] || { echo "[grade] SKIP $B (no reports)"; exit 0; }

if [[ "$G" == "qwen" ]]; then
  echo "[grade] $B via local Qwen3.5-4B judge ..."
  set +e
  OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
    python scripts/evaluate.py "$B" "$OUTFILE" --save_path "$OUT/${B}_flat_eval.json" \
      $( [[ "$B" == "healthbench" ]] && echo "--grader-model $GRADER_ALIAS" ) \
      2>&1 | tee "$OUT/score_${B}.txt"
  rc=$?
  set -e
  [[ $rc -eq 0 ]] && echo "[grade] $B DONE -> $OUT/${B}_flat_eval.json" \
                  || echo "[grade] $B FAILED (rc=$rc) — reports still at $OUTFILE"
else
  # Decision (decisions.md 2026-06-28): KEEP canonical Gemini grader for DRB/SQA (RACE quality risk
  # makes a blind 4B swap unwise; frozen corpus already breaks leaderboard-comparability). Grade in a
  # SEPARATE pass: PROBE with run_eval.py --limit 5 first (catches any free-tier daily gemini-2.5-pro
  # quota wall in ~2min; backoff handles RPM), then the full set. Needs GEMINI_API_KEY (keys.sh).
  echo "[grade] $B BANKED for canonical Gemini pass (not in this batch): $OUTFILE"
  echo "        -> probe:  evaluation/${B/sqav2/sqa}_eval/run_eval.py ... --limit 5   then full"
fi

echo "[done] task $i ($B) complete."
