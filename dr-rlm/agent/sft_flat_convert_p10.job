#!/bin/bash
# Convert+filter the FAITHFUL long-form flat pass (researchqa_p10.jsonl, 64 rows) into
# SFT conversations. Same gates as recursive arm: <answer> + <cite> present, judge rubric
# coverage >= 0.6 (local Qwen3.5-4B thinking-off judge), tokens <= 32768 (drop, never truncate).
# Differs from sft_flat_convert.job only in: --in = p10 pass, --framing = the STOCK long_form
# string p10 was actually generated with (must match gen-time DR_TULU_FRAMING_JSON).
#SBATCH --job-name=sft_flatconv_p10
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=01:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_flatconv_p10_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/sft_flatconv_p10_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
JUDGE=gpt-4.1-mini-2025-04-14; JPORT=8100
OUT=$DRRLM/runs/sft_gen_flat; SFTD=$DRRLM/data/sft
JOBID=${SLURM_JOB_ID:-local}
source "$VENV/bin/activate"
export TOKENIZERS_PARALLELISM=false JUDGE_API_KEY=EMPTY VLLM_USE_DEEP_GEMM=0 HF_HUB_OFFLINE=1

[ -s "$OUT/researchqa_p10.jsonl" ] || { echo "[FATAL] p10 rows missing"; exit 1; }

# framing = stock long_form string (the one p10 was generated with)
FRAMING=$(python - <<'PY'
import yaml, glob
f=glob.glob('/gpfs/home5/lgehringer/Dr-RLM/dr-tulu/agent/**/unified_tool_calling_v20250907.yaml', recursive=True)[0]
print(yaml.safe_load(open(f))['additional_instructions']['long_form'], end='')
PY
)
[ -n "$FRAMING" ] || { echo "[FATAL] framing empty"; exit 1; }

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
vllm serve Qwen/Qwen3.5-4B --host 0.0.0.0 --port $JPORT --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
  --default-chat-template-kwargs '{"enable_thinking": false}' \
  --served-model-name "$JUDGE" > "$DRRLM/runs/logs/sft_flatconv_p10_vllm_${JOBID}.log" 2>&1 &
CUR_PID=$!
for s in $(seq 1 120); do
  curl -sf "http://localhost:$JPORT/v1/models" >/dev/null 2>&1 && { echo "[serve] ready"; break; }
  sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm died"; exit 1; }
done

python "$DRRLM/scripts/flat_traces_to_sft.py" --in "$OUT/researchqa_p10.jsonl" \
  --out "$SFTD/dr_tulu_flat_sft.jsonl" --rubrics "$SFTD/sft_prompts_rubrics.jsonl" \
  --framing "$FRAMING" --judge_base_url "http://localhost:$JPORT/v1" --judge_model "$JUDGE" \
  --threshold 0.6 --tokenizer Qwen/Qwen3.5-4B --max_tokens 32768
echo "[step1-flat p10 convert] complete -> $SFTD/dr_tulu_flat_sft.jsonl"
