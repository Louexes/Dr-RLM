#!/bin/bash
# ============================================================================
# Untrained DR-RLM — THINKING-ON EMPTY-RESCUE test (ResearchQA, the 53 empties only).
# The thinking-ON run scored 0 on 53/116 items PURELY on finalization failure
# (100% hit max_turns, 0% set answer["ready"]=True; 24/53 wrote answer["content"]
# but it was discarded). Re-run ONLY those 53 ids with three flag-gated fixes
# (all default OFF -> default behavior byte-identical; safe for in-flight/training/CI):
#   1) DR_RLM_SALVAGE_ON_MAX_TURNS=1  -> base env _try_salvage() captures a
#      written-but-unsubmitted answer["content"] on max_turns (no more silent discard).
#   2) DR_RLM_FINALIZE_NUDGE_TURNS=3  -> dr_rlm_env fires an earlier+forceful
#      "STOP and submit NOW in one repl block" nudge at remaining<=3 (was <=2, soft).
#   3) DR_RLM_PROMPT_FILE=system_prompt_thinkon.txt -> FINISHING now warns "never let
#      turns run out unsubmitted; reasoning in <think> submits nothing."
# Baseline on these 53 = 0/53 non-empty, coverage 0. Same locked config + sampling
# as the full thinking-ON arm. EXECUTION: SHARDS parallel processes vs ONE vLLM
# (batched), NO --enforce-eager. Two serves: thinking-ON gen, then thinking-OFF judge.
# ============================================================================
#SBATCH --job-name=drrlm_t53
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=256G
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_t53_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/drrlm_t53_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
MODEL=Qwen/Qwen3.5-4B; PORT=8007; GRADER_ALIAS=gpt-4.1-mini-2025-04-14
FROZEN=$DRRLM/data/frozen_corpus; OUT=$DRRLM/runs/drrlm_thinkon_empty53_fix; TASK=researchqa; N=53; SHARDS=6
JOBID=${SLURM_JOB_ID:-local}
mkdir -p "$OUT" "$DRRLM/runs/logs"; rm -f "$OUT"/shard_*.jsonl "$OUT/${TASK}.jsonl"
source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_thinkon_empty53.jsonl
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt
# --- the three rescue fixes (gated; default OFF => byte-identical) ---
export DR_RLM_SALVAGE_ON_MAX_TURNS=1
export DR_RLM_FINALIZE_NUDGE_TURNS=3

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){  # $1=enable_thinking $2=tag [$3=alias]
  local think="$1" tag="$2" alias="${3:-}"
  local log="$DRRLM/runs/logs/drrlm_t53_vllm_${tag}_${JOBID}.log"
  echo "[serve:$tag] vllm $MODEL enable_thinking=$think -> $log"
  vllm serve "$MODEL" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
    --default-chat-template-kwargs "{\"enable_thinking\": $think}" \
    --served-model-name "$MODEL" $alias > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 240); do
    curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve:$tag] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm($tag) died"; tail -40 "$log"; exit 1; }
  done; echo "[FATAL] vllm($tag) never ready"; exit 1
}

# --- PHASE 1: generation, THINKING ON, sharded, with rescue fixes ---
serve true gen
GEN=$DRRLM/agent/generate.py; cd "$AGENT"
echo "[gen] DR-RLM THINKING-ON RESCUE depth=1 N=$N across $SHARDS shards (salvage=on nudge=3 prompt=$DR_RLM_PROMPT_FILE) ..."
COMMON="--driver new --benchmark $TASK --model $MODEL --tokenizer-path $MODEL \
  --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
  --max-recursion-depth 1 --max-iterations 10 --max-completion-tokens 8192 \
  --max-tool-calls 80 --max-children 10 --child-return-mode structured \
  --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
  --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
  --abort-after-dead-items 1000 --num-examples $N"
pids=()
for i in $(seq 0 $((SHARDS-1))); do
  python "$GEN" $COMMON --num-shards "$SHARDS" --shard "$i" \
    --output "$OUT/shard_${i}.jsonl" --save-trajectories "$OUT/traj_${i}" \
    > "$OUT/shard_${i}.log" 2>&1 < /dev/null &
  pids+=($!)
done
echo "[gen] launched ${#pids[@]} shard processes; waiting ..."
fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
cat "$OUT"/shard_*.jsonl > "$OUT/${TASK}.jsonl" 2>/dev/null || true
echo "[gen] done ($fail shard(s) nonzero). merged rows: $(wc -l < "$OUT/${TASK}.jsonl" 2>/dev/null)"

echo; echo "=== RESCUE HEALTH (baseline on these 53 = 0 non-empty) ==="
python - "$OUT/${TASK}.jsonl" <<'PY'
import json,sys
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
ne=sum(1 for r in rows if (r.get("final_response") or "").strip())
lens=sorted(len((r.get("final_response") or "")) for r in rows)
med=lens[len(lens)//2] if lens else 0
print(f"rows={len(rows)}/53  NON-EMPTY (rescued)={ne}  (was 0/53)  median_report_chars={med}")
PY

# --- PHASE 2: grading, thinking-OFF judge (swap) ---
echo; echo "[swap] killing thinking-ON serve, starting thinking-OFF judge ..."
kill "$CUR_PID" 2>/dev/null || true; CUR_PID=""
for s in $(seq 1 24); do curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && sleep 5 || break; done
serve false judge "$GRADER_ALIAS"
echo "=== GRADE (thinking-OFF judge) ==="
OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
  python scripts/evaluate.py "$TASK" "$OUT/${TASK}.jsonl" 2>&1 | grep -viE "Coverage for|Expected 8|Questions:|Authlib|joserfc|Computing rubric" | tail -8
python - "$OUT/${TASK}_eval_results.json" <<'PY'
import json,sys,os
f=sys.argv[1]
if os.path.exists(f):
    d=json.load(open(f)); print("DR-RLM thinking-ON RESCUE coverage on the 53 empties:", d.get("score") or d.get("metrics",{}).get("coverage"), "| n=", d.get("num_examples"), "(was 0.000 / all-zero)")
PY
echo "[done] $OUT/${TASK}.jsonl"
