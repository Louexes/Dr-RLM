#!/bin/bash
# ============================================================================
# PAIRED SFT PROBE — untrained base vs DR-RLM SFT checkpoint, THINKING-ON, N=16.
# Same prompts, same recursive harness, same locked config; both served thinking-ON
# (the SFT data is thinking-on: every assistant turn carries a <think> body). Then a
# SEPARATE thinking-OFF Qwen judge grades BOTH for report quality (coverage), and
# behavioral_metrics.py diffs protocol adoption (finalization / citation / print-contract).
# The delta = "did SFT install the protocol", before spending on full evals.
#   Untrained arm : Qwen/Qwen3.5-4B (base, multimodal -> vLLM-native)
#   SFT arm       : grafted served ckpt (SFT text weights on base multimodal shell)
# ============================================================================
#SBATCH --job-name=probe_sft
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=03:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/probe_sft_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/probe_sft_%j.err
set -euo pipefail

REPO=/gpfs/home5/lgehringer/Dr-RLM; DRRLM=$REPO/dr-rlm; AGENT=$REPO/dr-tulu/agent
VENV=/gpfs/home5/lgehringer/venvs/rlm_vllm311_headers
BASE_MODEL=Qwen/Qwen3.5-4B
SFT_CKPT=/scratch-shared/lgehringer/ckpts/dr_rlm_sft/served
PORT=8007; GRADER_ALIAS=gpt-4.1-mini-2025-04-14
FROZEN=$DRRLM/data/frozen_corpus; TASK=researchqa; N=16; SHARDS=4
JOBID=${SLURM_JOB_ID:-local}
OUT_UNTR=$DRRLM/runs/probe_untrained_ton; OUT_SFT=$DRRLM/runs/probe_sft_ton
mkdir -p "$OUT_UNTR" "$OUT_SFT" "$DRRLM/runs/logs"
rm -f "$OUT_UNTR"/shard_*.jsonl "$OUT_UNTR/${TASK}.jsonl" "$OUT_SFT"/shard_*.jsonl "$OUT_SFT/${TASK}.jsonl"

source "$VENV/bin/activate"; export TOKENIZERS_PARALLELISM=false OPENAI_API_KEY=EMPTY
export RESEARCHQA_LOCAL_PATH=$DRRLM/data/subsets/researchqa_strat120.jsonl
export DR_RLM_PROMPT_FILE=$DRRLM/prompts/system_prompt_thinkon.txt

CUR_PID=""; cleanup(){ [ -n "$CUR_PID" ] && kill "$CUR_PID" 2>/dev/null || true; }; trap cleanup EXIT
serve(){  # $1=model_path $2=enable_thinking $3=served_name $4=tag [$5=alias]
  local model="$1" think="$2" name="$3" tag="$4" alias="${5:-}"
  local log="$DRRLM/runs/logs/probe_vllm_${tag}_${JOBID}.log"
  echo "[serve:$tag] $model enable_thinking=$think name=$name -> $log"
  vllm serve "$model" --host 0.0.0.0 --port "$PORT" --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.90 --max-model-len 32768 --max-num-seqs 32 \
    --default-chat-template-kwargs "{\"enable_thinking\": $think}" \
    --served-model-name "$name" $alias > "$log" 2>&1 &
  CUR_PID=$!
  for s in $(seq 1 300); do
    curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && { echo "[serve:$tag] ready ~$((s*5))s"; return 0; }
    sleep 5; kill -0 "$CUR_PID" 2>/dev/null || { echo "[FATAL] vllm($tag) died"; tail -50 "$log"; exit 1; }
  done; echo "[FATAL] vllm($tag) never ready"; exit 1
}
swap_kill(){ kill "$CUR_PID" 2>/dev/null || true; CUR_PID=""
  for s in $(seq 1 24); do curl -sf "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && sleep 5 || break; done; }

gen_arm(){  # $1=served_name $2=out_dir
  local name="$1" out="$2"; local GEN=$DRRLM/agent/generate.py; cd "$AGENT"
  local COMMON="--driver new --benchmark $TASK --model $name --tokenizer-path $BASE_MODEL \
    --base-url http://localhost:$PORT/v1 --api-key-env OPENAI_API_KEY \
    --max-recursion-depth 1 --max-iterations 10 --max-completion-tokens 8192 \
    --max-tool-calls 80 --max-children 10 --child-return-mode structured \
    --temperature 1.0 --top-p 1.0 --sampling-top-k -1 --min-p 0.0 --presence-penalty 0.0 \
    --search-backend bm25s --search-corpus-path $FROZEN/corpus.jsonl --search-index-path $FROZEN/bm25s_index \
    --abort-after-dead-items 1000 --num-examples $N"
  local pids=()
  for i in $(seq 0 $((SHARDS-1))); do
    python "$GEN" $COMMON --num-shards "$SHARDS" --shard "$i" \
      --output "$out/shard_${i}.jsonl" --save-trajectories "$out/traj_${i}" \
      > "$out/shard_${i}.log" 2>&1 < /dev/null &
    pids+=($!)
  done
  local fail=0; for p in "${pids[@]}"; do wait "$p" || fail=$((fail+1)); done
  cat "$out"/shard_*.jsonl > "$out/${TASK}.jsonl" 2>/dev/null || true
  echo "[gen] $name -> merged rows: $(wc -l < "$out/${TASK}.jsonl" 2>/dev/null) ($fail shard fails)"
}

# --- ARM A: untrained base, thinking-on ---
echo "===== ARM A: UNTRAINED base, thinking-ON ====="
serve "$BASE_MODEL" true "$BASE_MODEL" untr
gen_arm "$BASE_MODEL" "$OUT_UNTR"
swap_kill

# --- ARM B: SFT checkpoint, thinking-on ---
echo "===== ARM B: SFT checkpoint, thinking-ON ====="
serve "$SFT_CKPT" true sft_drrlm sft
gen_arm sft_drrlm "$OUT_SFT"
swap_kill

# --- JUDGE: thinking-OFF base Qwen, grade BOTH ---
echo "===== JUDGE: thinking-OFF Qwen, grading both arms ====="
serve "$BASE_MODEL" false "$BASE_MODEL" judge "$GRADER_ALIAS"
cd "$AGENT"
for pair in "UNTRAINED:$OUT_UNTR" "SFT:$OUT_SFT"; do
  tag="${pair%%:*}"; out="${pair##*:}"
  echo "--- grading $tag ($out) ---"
  OPENAI_BASE_URL="http://localhost:$PORT/v1" OPENAI_API_KEY=EMPTY \
    python scripts/evaluate.py "$TASK" "$out/${TASK}.jsonl" 2>&1 \
    | grep -viE "Coverage for|Expected 8|Questions:|Authlib|joserfc|Computing rubric" | tail -4
  python - "$out/${TASK}_eval_results.json" "$tag" <<'PY'
import json,sys,os
f,tag=sys.argv[1],sys.argv[2]
if os.path.exists(f):
    d=json.load(open(f)); print(f"[{tag}] coverage:", d.get("score") or d.get("metrics",{}).get("coverage"), "| n=", d.get("num_examples"))
PY
done
swap_kill

# --- BEHAVIORAL DIFF (protocol adoption) ---
echo; echo "===== BEHAVIORAL METRICS: Untrained vs SFT ====="
cd "$DRRLM"
python analysis/behavioral_metrics.py \
  --run "Untrained:$OUT_UNTR/${TASK}.jsonl" \
  --run "SFT:$OUT_SFT/${TASK}.jsonl" 2>&1 | tail -40
echo "[done] untrained=$OUT_UNTR sft=$OUT_SFT"
