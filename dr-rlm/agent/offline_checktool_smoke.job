#!/bin/bash
# SLURM job — check_citations() tool SMOKE: 2 DRB items, offline corpus, no grading.
# New code paths (check_citations_verdicts, env tool wiring, CHECK_TOOL knob, check_tool
# prompt variant) get a trajectory inspection before the full n=16 A/B arm.
#SBATCH --job-name=offline_checktool_smoke
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=01:30:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_checktool_smoke_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/offline_checktool_smoke_%j.err
set -euo pipefail

cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent
export ARMS=structured
export DR_RLM_CAPTURE_LEDGER=1
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export TOKENIZER=Qwen/Qwen3-8B
export BENCH=deep_research_bench
export NUMEX=2
export MAX_DEPTH=1
export SEARCH_BACKEND=local_jsonl
export SEARCH_CORPUS_PATH=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/data/offline_corpus/drb.jsonl
export MAX_TOOL_CALLS=200
export MAX_CHILDREN=6
export GRADE=0
export SAVE_TRAJ=1

# The treatment under smoke: verdict-oracle tool on + its prompt variant.
export CHECK_TOOL=1
export DR_RLM_PROMPT_FILE=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/prompts/variants/check_tool.txt
export OUT=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/offline_checktool_smoke

echo "[job ${SLURM_JOB_ID:-local}] check_citations tool smoke: 2 DRB items"
exec ./ab_child_return.sh
