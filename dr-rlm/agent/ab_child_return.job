#!/bin/bash
# SLURM batch job for the prose-vs-structured child-return A/B (compute node, not the
# login node — interactive nodes reap long processes, which kept killing the run ~30-60min in).
# Resumes from any rows already in $OUT. Everything else is driven by ab_child_return.sh.
#SBATCH --job-name=ab_child_return
#SBATCH --partition=genoa
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=05:00:00
#SBATCH --output=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/ab_child_return_%j.out
#SBATCH --error=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs/ab_child_return_%j.err
set -euo pipefail

mkdir -p /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/logs
cd /gpfs/home5/lgehringer/Dr-RLM/dr-rlm/agent

# A/B config (ab_child_return.sh reads these; it activates the venv + sources keys.sh + launches MCP)
export MODEL=gemini-2.5-flash
export MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
export MODEL_API_KEY_ENV=GEMINI_API_KEY
export TOKENIZER=Qwen/Qwen3-8B
export BENCH=deep_research_bench
export NUMEX=20
export MAX_DEPTH=1
export SEARCH_BACKEND=web
export MAX_TOOL_CALLS=80
export MAX_CHILDREN=6
export GRADE=1
export OUT=/gpfs/home5/lgehringer/Dr-RLM/dr-rlm/runs/ab_child_return

echo "[job ${SLURM_JOB_ID:-local}] $(hostname) starting A/B (resumes from existing rows in $OUT)"
exec ./ab_child_return.sh
